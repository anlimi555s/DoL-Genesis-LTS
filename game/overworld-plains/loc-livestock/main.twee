		<br>
	<</if>>
	<<bedicon "zzz">><<link [[Sleep until dawn|Livestock Sleep]]>><<set $phase to 0>><</link>><<ltiredness>>
	<br><br>
	<<ind>><<link [[Gameplay Settings|Livestock Settings]]>><</link>>
	<br>
