<!--
	If the PC is getting raped and the encounter is nonconsensual, pigs will have a chance of being attracted to the noise. Each turn, each pig will have a chance of stealing a Mushroom or Truffle from the PC's basket.

	The PC gains an average of 10 mushrooms or truffles every 20 minutes, and at the end, may potentially be raped. Math should work out so that the PC loses around 1/5 of their basket if they take longer than 10 turns. However, the increasing number of pigs should cause them to lose everything by turn 25.

	Napkin Math:
		A pig has a 20% chance of appearing each turn.
		Each pig has a 20% chance of stealing a mushroom each turn.

	Turn 0: 0 pigs, 0 mushrooms lost
	Turn 5: 1 pig, 0 mushrooms lost
	Turn 10: 2 pigs, 1 mushrooms lost
	Turn 15: 3 pigs, 3 mushrooms lost
	Turn 20: 4 pigs, 6 mushrooms lost
	Turn 25: 5 pigs, 10 mushrooms lost
	etc.
-->
:: Farm Woodland Pigs Rape
<<if $molestationstart is 1>>
	<<set $molestationstart to 0>>
	<span class="red">You are deep in the woodland. Alex will not be able to hear your cries.</span>
	<br><br>

	<<controlloss>>
	<<violence 1>>
	<<neutral 1>>
	<<molested>>

	<<if $farm_work.pig.monster>>
		<<beastNEWinit 1 pig $farm_work.pig.gender $farm_work.pig.genitals monster>>
	<<else>>
		<<beastNEWinit 1 pig $farm_work.pig.gender $farm_work.pig.genitals beast>>
	<</if>>
	<<beastCombatInit>>
	<<set $rescue to 0>>
	<<if $tempPosition is "prone">>
		<<set $position to "missionary">>
	<</if>>
<</if>>

<<effects>>
<<effectsman>>
<<alarmstate>>
<<beast $enemyno>>
<br>
<!-- Truffle eaters go here. -->
<<if $tempPigTracker.length is 0>>
	Your basket lays at your side. No other <<farm_text_many pig>> are nearby.
<<elseif $tempPigTracker.length is 1>>
	<<if $tempBasket[0] + $tempBasket[1] gt 0>>
		A <<farm_text pig $tempPigTracker[0]>> glances between you and your basket.
	<<else>>
		A <<farm_text pig $tempPigTracker[0]>> watches you, sad that your basket is empty.
	<</if>>
<<elseif $tempPigTracker.length is 2>>
	<<if $tempBasket[0] + $tempBasket[1] gt 0>>
		A pair of <<farm_text_many pig>> look between you and your basket.
	<<else>>
		A pair of <<farm_text_many pig>> watch you, sad that your basket is empty.
	<</if>>
<<else>>
	<<if $tempBasket[0] + $tempBasket[1] gt 0>>
		A small group of <<farm_text_many pig>> snack from your basket while they watch.
	<<else>>
		A small group of <<farm_text_many pig>> watch you, sad that your basket is empty.
	<</if>>
<</if>>
<br><br>

<!-- Pig stealing checks -->
<<for $_i = 0; $_i < $tempPigTracker.length; $_i++>>
	<<if ($tempBasket[0] + $tempBasket[1] gt 0) and random(1, 5) is 1>>
		<<if ($tempBasket[1] is 0) or ($tempBasket[0] gt 0 and $tempBasket[1] gt 0 and random(1, 2) is 1)>>
			<<set _foodTarget to "mushroom">>
			<<set $tempBasket[0] -= 1>>
			<<set $foodstuff["mushroom"].amount -= 1>>
		<<else>>
			<<set _foodTarget to "truffle">>
			<<set $tempBasket[1] -= 1>>
			<<set $foodstuff["truffle"].amount -= 1>>
		<</if>>

		A <<farm_text pig $tempPigTracker[$_i]>> munches on a _foodTarget from your basket.
		<br><br>
	<</if>>
<</for>>

<!-- Pig generation checks -->
<<if random(1, 5) is 1>>
	<<farm_gen pig>>
	<<set _pigGender to $farm_work.pig.gender>>

	A <<farm_text pig _pigGender>> pokes <<farm_his pig _pigGender>> head out of the treeline. <<farm_He pig _pigGender>> glances between you and your basket.

	<<set $tempPigTracker.push(_pigGender)>>
	<br><br>
<</if>>

<br><br><br>
<<stateman>>
<br><br>
<<actionsman>>

<<if _combatend>>
	<span id="next"><<link [[Next|Farm Woodland Pigs Rape Finish]]>><</link>></span><<nexttext>>
<<else>>
	<span id="next"><<link [[Next|Farm Woodland Pigs Rape]]>><</link>></span><<nexttext>>
<</if>>


:: Farm Woodland Pigs Rape Finish

<<if $enemyarousal gte $enemyarousalmax>>
	<<beastejaculation>>

	The <<farm_text pig>> climbs off you, satisfied.

	<<if $tempPigTracker.length gt 0 and $farm_work.pig.monster>>
		<<if $tempPigTracker.length is 1>>
			The other <<farm_text pig $tempPigTracker[0]>> cheers.
		<<else>>
			The others cheer.
		<</if>>
		<<lrespect>><<farm_pigs -1>>
		<br>

		<<if random(1, 2) is 2>>
			"Not so great now."
		<<elseif $tempPigTracker.length gt 1>>
			"I hope <<pshe>> know place."
		<</if>>
		<br>

		<<if random(1, 2) is 2>>
			"You should been rougher."
		<<elseif $tempPigTracker.length gt 2>>
			"Can be rougher next time."
		<</if>>
		<br>

		<<if random(1, 2) is 2>>
			"We keep <<phim>> here?"
		<<elseif $tempPigTracker.length gt 3>>
			"I bet <<pshe>> like that."
		<</if>>
	<<else>>
		<<lrespect>><<farm_pigs -1>>
	<</if>>
	<br><br>

	<<tearful>> you pick up your basket and stagger away from them.
	<br><br>

	You check your basket.
	<<if $tempBasket[0] + $tempBasket[1] gt 0>>
		You have
		<span class="orange">
			<<foodstuffReport "mushroom" $tempBasket[0] "mushroom">>, and <<foodstuffReport "truffle" $tempBasket[1] "truffle">>.
		</span>
	<<else>>
		<span class="red">Your basket is empty.</span>
	<</if>>
	<br><br>

	<<clotheson>>
	<<endcombat>>

	<<link [[Continue|Farm Woodland Forage]]>><</link>>
	<br>

<<elseif $enemyhealth lte 0>>
	The <<farm_text pig>> backs away from you, cowed.
	<<if $tempPigTracker.length is 1>>
		The other <<farm_text pig $tempPigTracker[0]>> follows suit.
	<<else>>
		The others follow suit.
	<</if>>
	<<grespect>><<farm_pigs 1>>
	<br><br>

	<<tearful>> you pick up your basket and walk away.
	<br><br>

	You check your basket.
	<<if $tempBasket[0] + $tempBasket[1] gt 0>>
		You have
		<span class="green">
			<<foodstuffReport "mushroom" $tempBasket[0] "mushroom">>, and <<foodstuffReport "truffle" $tempBasket[1] "truffle">>.
		</span>
	<<else>>
		<span class="red">Your basket is empty.</span>
	<</if>>
	<br><br>

	<<clotheson>>
	<<endcombat>>

	<<link [[Continue|Farm Woodland Forage]]>><</link>>
	<br>

<</if>>


