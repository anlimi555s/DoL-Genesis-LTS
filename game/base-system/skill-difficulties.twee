<<widget "willpowerdifficulty">>
	<<skill_difficulty currentSkillValue('willpower') "Willpower" `(_args[0] ?? 1)` `(_args[1] ?? $willpowermax)` _args[2]>>
<</widget>>

<<widget "tendingdifficulty">>
	<<skill_difficulty currentSkillValue('tending') "Tending" _args[0] _args[1] _args[2]>>
<</widget>>

<<widget "housekeepingdifficulty">>
	<<skill_difficulty currentSkillValue('housekeeping') "Housekeeping" _args[0] _args[1] _args[2]>>
<</widget>>

<<widget "difficulty">>
	<<if _args[0] and !$settings.blindStatsEnabled>>
	| Success Chance:
		<<if _args[0] gte 100>>
			<span class="green"><<print _args[0]>>%</span>
		<<elseif _args[0] gte 80>>
			<span class="teal"><<print _args[0]>>%</span>
		<<elseif _args[0] gte 60>>
			<span class="lblue"><<print _args[0]>>%</span>
		<<elseif _args[0] gte 40>>
			<span class="blue"><<print _args[0]>>%</span>
		<<elseif _args[0] gte 20>>
			<span class="purple"><<print _args[0]>>%</span>
		<<elseif _args[0] gte 1>>
			<span class="pink"><<print _args[0]>>%</span>
		<<else>>
			<span class="red"><<print _args[0]>>%</span>
		<</if>>
	<</if>>
<</widget>>

<<widget "englishdifficulty">>
	<<skill_difficulty currentSkillValue('english') "English" _args[0] _args[1] _args[2]>>
<</widget>>

<!--
	args[0]: skill to be checked.
	args[1]: skill name to display.
	args[2]: skill required to have a chance.
	args[3]: skill required for 100% success rate
	args[4]: hide the skill text.
-->
<<widget "skill_difficulty">>
	<<set $_skill to _args[0]>>
	<<if typeof $_skill is "number">>
		<!-- Now we know $_skill is a valid number, we can perform our calculations safely. -->
		<<set _skilldifficultymin to (_args[2] ?? 1)>>
		<<set _skilldifficultymax to (_args[3] ?? 1000)>>
		<<if _skilldifficultymin gte _skilldifficultymax>>
			<<set _skilldifficultymax to _skilldifficultymin + 1>>
		<</if>>
		<<if !$settings.blindStatsEnabled>>
			<<set _difficulty to Math.round(Math.clamp($_skill - _skilldifficultymin, 0, _skilldifficultymax) / (_skilldifficultymax - _skilldifficultymin) * 100)>>
			<<if _difficulty gt 100>>
				<<set _difficulty to 100>>
			<</if>>
			<<if _args[4] is undefined>>
				| <span class="orange"><<print _args[1]>></span><<if $settings.skillCheckStyle isnot "skillname">>: 
					<!-- only display colon if it's followed by the difficulty level -->
					<<skillDifficultyText _difficulty>>
				<</if>>
			<<elseif _args[4] is "combat" and $settings.skillCheckStyle isnot "skillname">>
				<<if _difficulty gte 100>>
					<span class="green">(Very Easy)</span>
				<<elseif _difficulty gte 80>>
					<span class="teal">(Easy)</span>
				<<elseif _difficulty gte 60>>
					<span class="lblue">(Medium)</span>
				<<elseif _difficulty gte 40>>
					<span class="blue">(Challenging)</span>
				<<elseif _difficulty gte 20>>
					<span class="purple">(Hard)</span>
				<<elseif _difficulty gte 1>>
					<span class="pink">(Very Hard)</span>
				<<else>>
					<span class="red">(Impossible)</span>
				<</if>>
			<</if>>
		<</if>>
		<<if $temple_burden gte random(1, 100)>>
			<<set $_skill to 0>>
		<</if>>
		<!--
			skills that have their own dedicated widget have some persistent external variable that tracks success
			here, we check if the skill that this widget is called for is one of those skills, and if so, set that variable accordingly

			n.b. $skulduggerysuccess is handled separately, and so is not included here, and <<skulduggerydifficulty>> has
			different standards for how to display skill difficulty text (and so it does not call <<skillDifficultyText>>)
		 -->
		<<set _successVars to {
			"Physique": "physiqueSuccess",
			"Willpower": "willpowerSuccess",
			"Dance": "danceSuccess",
			"Swimming": "swimmingSuccess",
			"Athletics": "athleticsSuccess",
			"Tending": "tendingSuccess",
			"Housekeeping": "housekeepingSuccess",
			"English": "englishSuccess"
		}>>
		<<if _successVars[_args[1]] isnot undefined>>
			<<set V[_successVars[_args[1]]] to (($_skill gte random(_skilldifficultymin, _skilldifficultymax)) ? 1 : 0)>>
		<</if>>

	<<else>>
		<<error {
			message: '<<skill_difficulty>> widget was given an invalid skill name: Not a number.',
			source: `Skill value: ${_args[0]}, skill display: ${_args[1]}, minimum: ${_args[2]}, max: ${_args[3]}, hide: ${_args[4]}`
		}>>
	<</if>>
<</widget>>

<<widget "historyrequired">>
	/* args[0] = historyTrait required
	*/
	<<if !$settings.blindStatsEnabled>>
		History Grade required:
		<<if _args[0] gte 1 and _args[0] lt 2>>
			<span class="blue">C</span>
		<<elseif _args[0] gte 2 and _args[0] lt 3>>
			<span class="lblue">B</span>
		<<elseif _args[0] gte 3 and _args[0] lt 4>>
			<span class="teal">A</span>
		<<elseif _args[0] gte 4>>
			<span class="green">A*</span>
		<</if>>
	<</if>>
<</widget>>

<<widget "skillDifficultyText">>
	<<set $_difficulty to _args[0]>>
	<<if !$settings.blindStatsEnabled>>
		<<if $_difficulty gte 100>>
			<span class="green">Simple <<if $settings.skillCheckStyle is "percentage">>$_difficulty%<</if>></span>
		<<elseif $_difficulty gte 80>>
			<span class="teal">Easy <<if $settings.skillCheckStyle is "percentage">>$_difficulty%<</if>></span>
		<<elseif $_difficulty gte 60>>
			<span class="lblue">Reasonable <<if $settings.skillCheckStyle is "percentage">>$_difficulty%<</if>></span>
		<<elseif $_difficulty gte 40>>
			<span class="blue">Challenging <<if $settings.skillCheckStyle is "percentage">>$_difficulty%<</if>></span>
		<<elseif $_difficulty gte 20>>
			<span class="purple">Hard <<if $settings.skillCheckStyle is "percentage">>$_difficulty%<</if>></span>
		<<elseif $_difficulty gte 1>>
			<span class="pink">Very Hard <<if $settings.skillCheckStyle is "percentage">>$_difficulty%<</if>></span>
		<<else>>
			<span class="red">Impossible <<if $settings.skillCheckStyle is "percentage">>$_difficulty%<</if>></span>
		<</if>>
	<</if>>
<</widget>>
