<<widget "schoolrep">>
	<<set $_rep to _args[0]>>
	<<set $_val to _args[1]>>
	<<if !["crossdress", "herm"].includes($_rep) or isNaN($_val)>>
		<<run Errors.report("schoolrep called with bad parameters", _args)>>
	<<elseif $_val lt 0 and !$daily.crossdressingFameReduction>>
		<<set $schoolrep[$_rep] to Math.max(0, $schoolrep[$_rep] + $_val)>>
	<<elseif $_val gt 0 and !$daily.school[$_rep] and !$worn.face.type.includes("mask")>>
		<!-- can only get rep once a day, and can't reduce it later that day -->
		<<set $daily.school[$_rep] to 1>>
		<<set $daily.crossdressingFameReduction to true>>

		<!-- cap max rep at 5 -->
		<<set $schoolrep[$_rep] to Math.min($schoolrep[$_rep] + $_val, 5)>>

		<!-- for herm pcs, some students can still assume you're crossdressing if they don't know any better. ensure they know better -->
		<<set $schoolrep.crossdress to Math.min(5 - $schoolrep.herm, $schoolrep.crossdress)>>

		<<if $schoolrep[$_rep] is 5>>
			<!-- now all of china knows you're $_rep -->
			<<run ["Kylar", "Whitney", "Sydney", "Sirris", "River", "Doren", "Winter", "Mason", "Leighton"].forEach(n => $genderknown.pushUnique(n))>>
		<</if>>

		<!-- finally, send the message. expands to $school_crossdress_message or $school_herm_message -->
		<<set V["school_" + $_rep + "_message"] to $schoolrep[$_rep]>>
	<</if>>
<</widget>>

<<widget "schoolrep_naked">>
	/* _args[0] is used as an overwrite to perform retroactive school reputation changes. For example, if a video of the player
	nude circulates. If we just call "schoolrep_naked" when the news breaks and the player is wearing a chastity belt right now,
	but NOT in the video, reputation will update incorrectly. Same is true vice versa.

	The intended use-case of _args[0] is by saving a boolean of the status of playerChasity(Hidden) *at the time the video was
	recorded*, and then input that boolean into _args[0] when the video circulates. Look at my implementation of $flyover_chaste
	to see the intended use in action. */

	<<if !playerChastity("hidden") or _args[0] is false>>
		<<if $player.penisExist and $player.vaginaExist>>
			<<schoolrep herm 1>>
		<<elseif isCrossdressing()>>
			<<schoolrep crossdress 1>>
		<<elseif $player.sex is $player.gender_appearance and $schoolrep.crossdress gt 0 and !$daily.crossdressingFameReduction and random(0,100) lt $schoolrep.crossdress * 3>>
			<<schoolrep crossdress -1>>
			<<set $daily.crossdressingFameReduction to true>>
		<</if>>
	<</if>>
<</widget>>

