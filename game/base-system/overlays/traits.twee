				{
					name: "Fangs",
					colour: "def",
					has: !["disabled", "hidden"].includes($transformationParts.traits.fangs),
					text: "Biting is twice as effective.",
				},
				{
					name: "Sharp Eyes",
					colour: "def",
					has: !["disabled", "hidden"].includes($transformationParts.traits.sharpEyes),
					text: "Little escapes your notice. +5% skulduggery.",
