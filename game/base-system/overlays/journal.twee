:: Widgets Journal [widget]
<<widget "journal">>
	<br>
	<<print "It is " + getFormattedDate(Time.date) + ", " + Time.year + ".">>
	<ul class="journal">
	<<if Time.days lt 0>>
		<<if Time.days lt -365>>
			<<set _yearsBefore = Math.floor(Time.startDate.year - Time.year)>>
			<li>It is around <span class="gold"><<print _yearsBefore>></span> <<pluralise _yearsBefore "year">> before you started the game.</li>
		<<else>>
			<<set _daysBefore = Time.days * -1>>
			<li>It is <span class="gold"><<print _daysBefore>></span> <<pluralise _daysBefore "day">> before you started the game.</li>
		<</if>>
	<<else>>
		<li>It has been <span class="gold"><<print Time.days>></span> <<pluralise Time.days "day">> since the game started.</li>
		<<if $hardmodedays isnot undefined>>
			<li>You survived <span class="gold">$hardmodedays</span> <<pluralise $hardmodedays "day">> on hard mode.</li>
			<br>
		<</if>>
		<li>The game started in <<print Time.getSeason(new DateTime($startDate))>>.</li>
		<li>It is <<print Time.season>>.</li>
		<li><<schoolterm>></li>
	<</if>>
	</ul>

	<<if $options.images is 1>>
		<div class="map">
			<<if Weather.isSnow>>
				<img id="world_map" src="img/misc/world-map-winter.png">
			<<else>>
				<img id="world_map" src="img/misc/world-map.png">
			<</if>>
		</div>
	<</if>>

	<<if $hc>>
		<hr>
		<h1 class="header gold bold">Hopeless Cycle</h1>
		<<if $tags.includes("ending")>>
			All stories must end.
		<<elseif Time.isBloodMoon()>>
			The blood moon looms. This is it.
		<<else>>
			<<set $_daysUntilBloodMoon to Time.lastDayOfMonth - Time.monthDay>>
			<<if $_daysUntilBloodMoon is 0>>
				Night of the blood moon.
			<<elseif $_daysUntilBloodMoon is 1>>
				One day until the blood moon.
			<<else>>
				<<Number $_daysUntilBloodMoon>> days until the blood moon.
			<</if>>
			<br>
			<<if $prisonerEvents.includes("health")>>
				<ul class="journal">
					<<if $hc.nightBreakIn is "heard">>
						<li>Someone plans to sneak into <<= $prisoner.name>>'s cell late at night.</li>
					<</if>>
					<<if $prisonerEvents.includes("raped") and !$prisonerEvents.includes("rapedReported")>>
						<li>You can inform the Hand of <<= $prisoner.name>>'s defilement in the prayer room.</li>
					<</if>>
					<<if $prisonerEvents.includes("brand")>>
						<li><<= $prisoner.name.toUpperFirst()>>'s burns can be treated with herbs from the garden and <i>clean</i> water.</li>
					<</if>>
					<<if $hc.dogs>>
						<li>House Romilly's dogs are present in the garden.</li>
					<</if>>
					<<if $hc.wellTainted>>
						<li>The well's water is foul. Water can be sourced from the lake in the forest instead.</li>
					<</if>>
				</ul>
			<</if>>
			<<if Object.values($hcChallenge).count(true)>>
				<<if $hcChallengeRandom.blind>>
					<<if $hcChallengeRandom.min is $hcChallengeRandom.max>>
						You selected <<number Object.values($hcChallenge).count(true)>> <span class="blue">unknown</span> challenges.
					<<else>>
						You selected between <<number $hcChallengeRandom.min>> and <<number $hcChallengeRandom.max>> <span class="blue">unknown</span> challenges.
					<</if>>
				<<else>>
					<<hcChallengeSummary "journal">>
				<</if>>
			<</if>>
		<</if>>
	<</if>>
	<<if $statFreeze>>
		<<exit>>
	<</if>>

	<<if $rentday isnot undefined || $rentmoney isnot undefined>>
		<hr>
		<h1 class="header gold bold">Time-Sensitive</h1>
		<ul class="journal">
			<<if $avery_mansion>>/* Is Avery paying for the PC? */
				<<if $avery_mansion.rage.assess gte 9 or C.npc.Avery.state is "dismissed">>
					<<set _avery_pay to false>>
				<<else>>
					<<set _avery_pay to true>>
				<</if>>
			<<else>>
				<<set _avery_pay to false>>
			<</if>>
			<<if !_avery_pay>>
				<<if $rentday isnot undefined>>
					<<if $renttime lte 0>>
						<li>Bailey is looking for you and wants <<printmoney $rentmoney>><<babyRentDisplay " plus " " for not looking after your children" "gold">>.</li>
					<<else>>
						<li>Bailey wants <<printmoney $rentmoney>> on <<rentday>><<babyRentDisplay " plus " " for not looking after your children" "gold">>.</li>
					<</if>>
				<<elseif $rentmoney isnot undefined>>
					<li>Bailey wants <<printmoney $rentmoney>><<babyRentDisplay " plus " " for not looking after your children" "gold">>.</li>
				<</if>>
			<</if>>

			<<if $syndromeeden is 1 and $edenfreedom gte 1 and $location isnot "cabin">> /* Another parameter is planned, something like $edenpunishment. It is meant to only trigger the journal note after the player has been given a reason to be wary of breaking Eden's rules. */
				<<if edenFreedomStatus() is 0>>
					<li>You are expected back at Eden's cabin
					<<if $edenfreedom is 1>>
						<<if $edendays is 2>>
							<span class="pink">tonight, before midnight</span>.
						<<else>> /* $edendays is 1 */
							by <span class="gold">tomorrow night</span>, at the latest.
						<</if>>
					<<else>> /* $edenfreedom is 2 or more */
						<<if $edendays is 7>>
							<span class="pink">tonight, before midnight</span>.
						<<elseif $edendays is 6>>
							by <span class="gold">tomorrow night</span>, at the latest.
						<<else>> /* $edendays is between 1 and 5 */
							in <span class="gold"><<print ["seven", "six", "five", "four", "three", "two"][$edendays]>></span> days, at the latest.
						<</if>>
					<</if>></li>
				<<elseif edenFreedomStatus() is 1 and (($edenfreedom is 1 and $edendays lt 4) or ($edenfreedom is 2 and $edendays lt 10))>> /* Warning lasts for one day on freedom 1 and two days on freedom 2 */
					<li>You have <span class="red">failed</span> to return to Eden on time. <<nnpc_He "Eden">> will have noticed by now.</li>
				<</if>>
			<</if>>

			<<if $avery_mansion?.schedule isnot "away" and $averydate is 1 and Time.hour lte 21 and $averydatedone isnot 1>>
				<li>You have a date scheduled with Avery <span class="pink"><<this_saturday>></span>. <<nnpc_He "Avery">>'ll wait for you <<= $avery_mansion ? "in the garage" : "on Domus Street">> between <span class="gold"><<ampm 20 00>></span> and <span class="gold"><<ampm 21 00>></span>.</li>
			<</if>>

			<<if $avery_valentines?.invite and !$avery_valentines?.done and !$avery_valentines?.missed_approach and !$avery_valentines_missed>>
				<<if $avery_mansion>>
					<li>Avery has invited you on a date for <span class="pink">Valentine's Day, on <<= getFormattedDate(new DateTime(Time.year, 2, 14))>>.</span> <<nnpc_He "Avery">>'ll wait for you in the mansion garage from <span class="gold"><<ampm 21 00>></span>.</li>
				<<else>>
					<li>Avery has invited you on a date for <span class="pink">Valentine's Day, on <<= getFormattedDate(new DateTime(Time.year, 2, 14))>>.</span> <<nnpc_He "Avery">>'ll wait for you on Domus Street from <span class="gold"><<ampm 20 00>></span>.</li>
				<</if>>
			<</if>>

			<<if $harper_appointments.enabled or $schoolPsych is 1>>
				<li>You <<if $harper_appointments.enabled>>have an<<else>>may get an<</if>> appointment with Doctor Harper
				<<if Time.weekDay is 6>>
					<<if $daily.harperVisit is 1>>
						next <span class="gold">Friday</span>.
					<<else>>
						<span class="pink">today</span>.
					<</if>>
				<<else>>
					on <span class="gold">Friday</span>.
				<</if>></li>
			<</if>>

			<<if $brothelshowdata.type isnot "none" and $brothelshowdata.intro>>
				<li>You're expected to perform a $brothelshowdata.type show at the brothel
				<<if Time.weekDay is 6>>
					<<if $brothelshowdata.done>>
						next <span class="gold">Friday</span>.
					<<else>>
						<span class="pink">today</span>.
					<</if>>
				<<else>>
					on <span class="gold">Friday</span>.
				<</if>></li>
			<</if>>

			<<if $brothel_escortjob isnot undefined>>
				<<if ($brothel_escortjob.done is undefined or $brothel_escortjob.escape is undefined) and $brothel_escortjob.accept is true and $brothel_escortjob.missed isnot true>>
					<<set _date to new DateTime($brothel_escortjob.date)>>
					<li>You have an escort job scheduled. You're expected to be in front of the brothel
					<<if Time.monthDay is _date.day>>
						<span class="pink">today</span>
					<<elseif Time.date.dayDifference(_date) is 1>>
						<span class="gold">tomorrow</span>
					<<elseif Time.date.dayDifference(_date) gte 7>>
						next <span class="gold">_date.weekDayName</span>
					<<else>>
						on <span class="gold">_date.weekDayName</span>
					<</if>>
					at <span class="gold"><<ampm _date.hour>></span>.</li>
				<</if>>
			<</if>>

			<<if $community_service gte 1>>
				<<if $community_service_done is 1>>
					<li><span class="lblue">You've performed your community service today.</span></li>
				<<elseif ["asylum","prison"].includes($location)>>
					<li>Your sentence of community service has been put on hold due to your <<if $location is "prison">>incarceration<<else>>treatment<</if>>.</li>
				<<elseif Time.hour gte 21>>
					<li>It's too late in the day to perform your community service.</li>
				<<elseif Time.hour lt 6>>
					<li>The police station is expecting you later for your daily community service.</li>
				<<else>>
					<li>The police station is expecting you for your daily community service.</li>
				<</if>>
				<<if $community_service is 1>>
					<li>You have <span class="purple">one day</span> of community service remaining.</li>
				<<else>>
					<li>You have <span class="pink">$community_service</span> days of community service remaining.</li>
				<</if>>
			<</if>>

			<<if $wrenHeist is true and Time.hour lte 20 and $wrenHeistDance.attended isnot true>>
				<li>You are supposed to meet Wren <span class="pink">tonight</span> between <span class="gold"><<ampm 19 00>></span> and <span class="gold"><<ampm 21 00>></span>. <<nnpc_He "Wren">> gave you directions to the mansion on Danube Street.</li>
			<</if>>

			<<if $smuggler_known is 1 and $smuggler_timer gte 0>>
				<li>Smugglers are bringing something valuable into town
					<<if $smuggler_timer is 0>>
						<span class="pink">tonight</span>, before midnight.
					<<elseif $smuggler_timer is 1>>
						<span class="gold">tomorrow</span>, before midnight.
					<<else>>
						<<nDays $smuggler_timer>>.
					<</if>>
					<<if $smuggler_location is "forest">>
						They're bringing it through the forest.
					<<elseif $smuggler_location is "sewer">>
						They're bringing it through the old sewers.
					<<elseif $smuggler_location is "beach">>
						They plan to land at that rock near the beach.
					<<elseif $smuggler_location is "bus">>
						They're sneaking it in on a bus.
					<</if>>
				</li>
			<</if>>

			<<if $farm_stage gte 7>>
				<li>Remy will attack the farm
					<<if $farm_attack_timer is 0>>
						<span class="pink">tonight</span>.
					<<else>>
						<<nDays $farm_attack_timer>>.
					<</if>>
					<<nnpc_He Remy>>'ll arrive between <span class="gold"><<ampm 21 00>></span> and <span class="gold">midnight</span>.
				</li>
			<</if>>

			<<if $temple_rank is "initiate" or $temple_rank is "monk" or $temple_rank is "priest">>
				<li>You are <<print $temple_rank is "initiate" ? "an initiate at" : "a <<temple_title>> of">> the temple.
					<<if $temple_chastity_timer lte 0>>
						<span class="pink">You have a chastity exam due.</span>
					<<elseif $temple_chastity_timer is 1>>
						You have a chastity exam due <span class="purple">tomorrow</span>.
					<<else>>
						You have a chastity exam due <<nDays $temple_chastity_timer>>.
					<</if>>
					You will receive an <span class="gold">allowance</span> when passing the exam.
				</li>
			<</if>>

			<<if $studyBooks isnot undefined and ($studyBooks?.rented isnot "none" or $studyBooks?.stolen isnot "none")>>
				<li>
					<<if $studyBooks.rented isnot "none">>
						<<switch $studyBooks.rented>>
							<<case "Pinch">>
								<<if $per_npc.pinch isnot undefined>>
									<<set _book to `copy of \"How ${$per_npc.pinch.pronoun is "m" ? "Mr" : "Ms"} Pinch Groped Christmas\"`>>
								<<else>>
									<<set _book to "olive-coloured book">>
								<</if>>
							<<case "Raul and Janet">>
								<<set _book to `copy of \"${$studyBooks.rented}\"`>>
							<<case "English" "science" "maths" "history">>
								<<set _book to $studyBooks.rented + " textbook">>
						<</switch>>
						<<if Time.schoolTerm>>
							<<if $book_rent_timer is 0>>
								<span class="blue">You have <<a _book>> due.</span>
							<<elseif $book_rent_timer lt 0>>
								<span class="red">You have <<a _book>> overdue.</span>
							<<else>>
								You have <<a _book>> due in <span class="gold">$book_rent_timer</span> <<pluralise $book_rent_timer "day">>.
							<</if>>
						<</if>>
					<</if>>
					<<if $studyBooks.stolen isnot "none">>
						<<set _colour to $bookStolenKnown gte 3 ? "red" : $bookStolenKnown is 2 ? "pink" : "white">>
						<<switch $studyBooks.stolen>>
							<<case "Pinch">>
								<<if $per_npc.pinch isnot undefined>>
									<span @class=_colour>You've stolen a copy of "How <<= $per_npc.pinch.pronoun is "m" ? "Mr" : "Ms">> Pinch Groped Christmas".</span>
								<<else>>
									<span @class=_colour>You've stolen an olive-coloured book.</span>
								<</if>>
							<<case "Raul and Janet">>
								<span @class=_colour>You've stolen a copy of "$studyBooks.stolen".</span>
							<<case "English" "science" "maths" "history">>
								<span @class=_colour>You've stolen <<a $studyBooks.stolen>> textbook.</span>
							<<default>>
						<</switch>>
					<</if>>
					<<if !Time.schoolTerm and $studyBooks.rented isnot "none">>
						<<if $studyBooks.rented>>You have <<a _book>> checked out.<</if>>
						<span class="blue">Books are not due over school break!</span>
					<</if>>
				</li>
			<</if>>

			<<if $gwylanSeen?.includes("ritual_beast")>>
				<li>
					<<run statusCheck("Gwylan")>>
					<<if $gwylan.timer.ritual and Time.date.dayDifference(new DateTime(V.gwylan.timer.ritual)) > 0>>
						<<set _ritualDays to Time.date.dayDifference(new DateTime(V.gwylan.timer.ritual))>>
						<<if isGwylanAbsent() is "nobody">>Nobody<<else>>Gwylan<</if>> will be ready for another ritual in <span class="gold"><<number _ritualDays>></span> <<pluralise _ritualDays "day">>.
					<<elseif _gwylanStatus.includes("badEndReady") or $gwylan.hunting is 3>>
						<span class="red"><<if isGwylanAbsent() is "nobody">>Nobody<<else>>Gwylan<</if>> is waiting to perform another ritual with you.</span>
					<<else>>
						<span class="pink"><<if isGwylanAbsent() is "nobody">>Nobody<<else>>Gwylan<</if>> is ready to perform another ritual.</span>
					<</if>>
				</li>
			<</if>>
		</ul>
	<</if>>

	<<if !$statFreeze and (($location is "asylum" and ($eden_asylum_window is 1 or ($daily.eden.distract gte 1 and Time.hour lt 21))) || $temple_spear_mission gte 1 || $docks.hired || ($brothelshowdata.intro and $brothelshowdata.type is "none") || $exhibitionismrun || $robindebtevent gte 1 and $robinmissing isnot 0 || $pubtask2 is 1 || $pubtask || $police_hack is 1 || $pub_hack_job gte 1 || $pubfame ||( $earSlime.event and !_tempEventHide) || $earSlime.forcedCommando isnot undefined || $earSlime.forcedDressing isnot undefined || $temple_rank is "prospective" || $chef_state gte 4 || $mason_pond gte 1 || ($brothel_machine_repair gte 1 and $brothel_machine_repair lte 3) || ($harpy gte 6 and $birdFly isnot 1) || Object.values(V.children).filter(child => (child.type === "hawk" && child.location === "inventory")).length gt 0 || $adultshopgrandopening || ($adultshopintro is 1 and $adultshopunlocked is undefined) || $gwylan?.request.event)>>
		/*TODO: streamline during eventual Journal UI Overhaul bc lol. lmao, even. */
		<hr>
		<h1 class="header gold bold">Reminders</h1>
		<ul class="journal carry">
			<<if $temple_spear_mission is 1>>
				<li><<islandicon>> Jordan has tasked you with retrieving an artefact spear. It is said to reside on a mysterious island.
					<<if $temple_spear_mission_winter is undefined>>
						Jordan mentioned that the historian at the local museum might have more information.
					<<else>>
						According to Winter, you can find someone who knows of the island at a secret pub in the sewers.
					<</if>>
				</li>
			<</if>>
			<<if $eden_asylum_window is 1 and $location is "asylum">>
				<<if Time.hour lt 22>>
					<li><<asylumicon "cell">> Eden will be watching the asylum at <<ampm 20 00>> <span class="pink">tonight</span>.</li>
				<<else>>
					<li><<asylumicon "cell">> Eden is watching the asylum, waiting for you to mark your room.</li>
				<</if>>
			<</if>>

			<<if $daily.eden.distract gte 1 and $location is "asylum">>
				<<if Time.hour lt 21>>
					<li><<asylumicon "cell">> Eden will create a distraction at <<ampm 21 00>> <span class="pink">tonight</span>.</li>
				<</if>>
			<</if>>

			<<if $docks.hired>>
				<<if $docks.fakeID is "shown">>
					<li><<docksicon>> Your shift at the docks starts at <<ampm 7 00>>. You can enter as early as <<ampm 6 00>> and show up late before <<ampm 8 00>>.</li>
				<<else>>
					<li><<docksicon>> Your shift at the docks starts at <<ampm 7 00>> on any day except school days. You can enter as early as <<ampm 6 00>> and show up late before <<ampm 7 15>>.</li>
				<</if>>
			<</if>>

			<<if $brothelshowdata.intro and $brothelshowdata.type is "none">>
				<li><<brothelicon "stage">> You can star in shows at the brothel.</li>
			<</if>>

			<<if $exhibitionismrun>>
				<<if $exhibitionismrun is "danube" and $exhibitionismrunon is 0>>
					<li><<danubeicon>>A mysterious note offers you <<printmoney 10000>> to strip by the oak behind the spa on Danube Street.</li>
				<<elseif $exhibitionismrun is "danube" and $exhibitionismrunon is 1>>
					<li><<danubeicon>>A mysterious note offers you <<printmoney 30000>> to strip and make yourself cum by the oak behind the spa on Danube Street.</li>
				<<elseif $exhibitionismrun is "starfish">>
					<li><<starfishicon>>A mysterious note offers you <<printmoney 50000>> to flash your butt at the traffic on Starfish Street for fifteen minutes.</li>
				<<elseif $exhibitionismrun is "cliff">>
					<li><<clifficon>>A mysterious note offers you <<printmoney 100000>> to run nude from Cliff Street to High Street, and back again.</li>
				<</if>>
			<</if>>

			<<if $pubtask2 is 1>>
				<li><<crimeicon "black box">> Return the black box to Landry at the pub.</li>
			<<elseif $pubtask>>
				<li><<crimeicon "black box">> Landry wants you to retrieve a black box from the $pubtask.</li>
			<</if>>

			<<if $farm_manors_usb gte 1>>
				<li><<techicon "usb">> You have a USB containing sensitive information, found in a manor in the farmlands.</li>
			<</if>>

			<<if $police_hack is 1>>
				<li><<techicon "computer">> Landry might be able to help you with the locked police computer.</li>
			<<elseif $pub_hack_job is 1>>
				<li><<investigateicon>> Landry wants you to find a hacker supposedly named 'Mickey' living at the Domus Street orphanage.</li>
			<<elseif $pub_hack_job is 2>>
				<li><<socialiseicon>> Convince 'Mickey' to work with you.</li>
			<<elseif $pub_hack_job is 3>>
				<<if !$hacker_tasks.includes("bailey")>>
					<li><<techicon "email">> 'Mickey' wants you to implant a device on Bailey's computer while Bailey is logged in.</li>
				<</if>>
				<<if !$hacker_tasks.includes("leighton")>>
					<li><<crimeicon "safe">> 'Mickey' wants you to steal memory cards from a strongbox under Leighton's desk.</li>
				<</if>>
				<<if $hacker_tasks.length gte 2>>
					<li><<socialiseicon>> You need to talk to Landry about 'Mickey'.</li>
				<</if>>
			<</if>>

			<<if $pubfame>>
				<<if $pubfame.status is "accepted">>
					<li>
						<<switch $pubfame.task>>
							<<case "river">>
								<<investigateicon>> 'Mickey' wants you to check on River, the maths teacher at your school.
							<<case "gwylan">>
								<<icon "snowgsnowglobelobe.gif">> 'Mickey' wants you to find a specific snow globe at <<if $forest_shop_intro is 1>>Gwylan's shop<<else>>the shop on the outskirts of the forest<</if>>.
							<<case "temple">>
								<<templeicon>> 'Mickey' wants you to find a book on architecture at the temple with a password on the inside cover.
							<<case "kylar">>
								<<icon "manila-envelope.png">> 'Mickey' wants you to deliver a letter to
								<<if C.npc.Kylar.state is "prison">>
									the police station, so they can give it to Kylar.
								<<else>>
									Kylar<<if C.npc.Kylar.init isnot 1>>, a student at your school<</if>>.
								<</if>>
							<<case "wren">>
								<<icon "manila-envelope.png">> 'Mickey' wants you to deliver a letter to <<if $wren_intro is undefined>>a <<nnpc_gender "Wren">> named Wren. <<nnpc_He "Wren">> can be found at Remy's estate in the moor, or at the docks at night<<else>>Wren<</if>>.
							<<case "hospital">>
								<<icon "access-card.png">>
								'Mickey' wants you to steal a keycard from the hospital.
								<<if $location is "asylum">>
									However, you think they might be happy with a keycard from this place too.
								<</if>>
							<<case "morgan">>
								<<techicon "usb">> 'Mickey' wants you to retrieve a USB drive from the old sewers. They think <<if $sewersintro is 1>>Morgan<<else>>someone down there<</if>> has it.
							<<case "niki">>
								<<photographystudioicon>> 'Mickey' wants you to retrieve a photo from Niki's photography studio, of a $per_npc.pubfame_model.fullDescription with $pubfame.niki.hair hair.
							<<case "bailey">>
								<<techicon "usb">> 'Mickey' wants you to implant a device on Bailey's computer while Bailey is logged in.
							<<case "briar">>
								<<techicon "usb">> 'Mickey' wants you to implant a device on Briar's computer at the brothel.
							<<case "office">>
								<<if $avery_fate is "ascended">>
									<<skyscrapericon>> 'Mickey' wants you to deliver a letter to Avery's skyscraper
								<<else>>
									<<officebuildingicon>> 'Mickey' wants you to deliver a letter to the office building
								<</if>>.
							<<case "remy">>
								<!-- intentionally does not include the password -->
								<<steedicon>> 'Mickey' wants you to retrieve a package from a contact at Remy's riding school<<if $ridingschoolintro is undefined>>, in the countryside beyond Harvest Street<</if>>.
							<<case "compound">>
								<<techicon "vcam">> 'Mickey' wants you to set cameras around the compound on Elk Street.
								<<if $pubfame.compound.cameras.length gte 1>>
									You've already hidden cameras in <<print formatList($pubfame.compound.cameras, "and", true)>>.
								<</if>>
						<</switch>>
						They'll <<if $pubfame.goal.includes("perm")>>permanently<<else>>temporarily<</if>> <<if $pubfame.goal.includes("Raise")>>raise<<else>>lower<</if>> your <<fameProse $pubfame.target>> fame upon completion.
					</li>
				<<elseif $pubfame.status is "done">>
					<li><<socialiseicon>> You can report to 'Mickey' that your favour is complete.</li>
				<</if>>
			<</if>>

			<<if $robindebtevent gte 1 and $robinmissing is "docks" and $docksrobinintro isnot 1>>
				<li><<docksicon>> Robin is missing. <<nnpc_He "Robin">> was taken to the docks on Mer Street.</li>
			<</if>>

			<<if $robindebtevent gte 1 and $robinmissing is "landfill" and $mistrobinintro isnot 1 and $robinmistknown>>
				<li><<landfillicon>> Robin is missing. <<nnpc_He "Robin">> was taken to the landfill on Elk Street.</li>
			<</if>>

			<<if $robindebtevent gte 1 and $robinmissing is "pillory" and $robinPillory.known is 1>>
				<li><<pilloryicon>> Robin is missing.
					<<if Time.hour lte 14>>
						<<nnpc_Hes "Robin">> scheduled to be put in the pillory on Cliff Street at <<ampm 15 00>>.
					<<else>>
						<<nnpc_Hes "Robin">> currently in the pillory. You don't know what will happen to <<nnpc_him "Robin">>.
					<</if>>
				</li>
			<</if>>

			<<if $earSlime.event and !_tempEventHide and !$hypnosis_traits.silence gte 1>>
				<<switch $earSlime.event>>
					<<case "get sperm into your anus" "get sperm into your vagina" "get sperm into your anus completed" "get sperm into your vagina completed">>
						<li class="lewd"><<socialiseicon "ask">> The slime in your head commanded you to get sperm into your <<print $player.vaginaExist ? "vagina" : "anus">>.</li>
					<<case "get your own sperm into your anus" "get your own sperm into your vagina" "get your own sperm into your anus completed" "get your own sperm into your vagina completed">>
						<li class="lewd"><<socialiseicon "ask">> The slime in your head commanded you to get your own sperm into your <<print $player.vaginaExist ? "vagina" : "anus">>.</li>
					<<case "only sleep naked from now on" "only wear feminine clothes for a while" "only wear masculine clothes for a while">> /* Show nothing */
					<<default>>
						<li class="lewd"><<bedicon>> The slime in your head commanded you to <<print $earSlime.event>><<if $earSlime.noSleep>> before it allows you to sleep<</if>>.</li>
				<</switch>>
			<</if>>
			<<if $earSlime.forcedCommando isnot undefined and !$hypnosis_traits.silence gte 1>>
				<li class="lewd"><<icon "cross.png" "infront">><span class="clothes-white"><<icon "clothes/plain-panties.png">></span> The slime in your head commanded you to go commando.</li>
			<</if>>
			<<if $earSlime.forcedDressing isnot undefined and !$hypnosis_traits.silence gte 1>>
				<li class="lewd"><<if $earSlime.forcedDressing.type is "f">><<femaleicon>><<else>><<maleicon>><</if>> The slime in your head commanded you to only wear more <<print $earSlime.forcedDressing.type is "f" ? "feminine" : "masculine">> clothing.</li>
			<</if>>

			<<if $temple_rank is "prospective">>
				<li><<templeicon>> Jordan has offered you a place at the temple, but you must first pass the trial of purity.</li>
			<</if>>

			<<if $chef_state is 4>>
				<li><<nightingaleicon>> Sam wants you to visit an address on Nightingale Street.</li>
			<<elseif $chef_state is 7 and $chef_rework lte 0>>
				<li><<cafeicon>> The renovations at the Ocean Breeze have finished.</li>
			<<elseif $chef_state is 7 and $chef_rework lte 30>>
				<li><<cafeicon>> The Ocean Breeze is closed for renovations. They will be done <<nDays $chef_rework>>.</li>
			<<elseif $chef_state is 7>>
				<<set _timer to $chef_rework - 30>>
				<li><<cafeicon>> The Ocean Breeze will close for renovations <<nDays _timer>>.</li>
			<<elseif $chef_state is 8>>
				<li><<cafeicon>> Sam wants you to attend the Ocean Breeze's grand reopening on any evening between <<ampm 18 00>> and <<ampm 21 00>>.</li>
			<</if>>

			<<if $mason_pond is 1>>
				<li><<socialiseicon "ask">> Mason mentioned a stream under Domus Street, which could be used to make a spring. You'd need Bailey's permission first.</li>
			<<elseif $mason_pond is 2>>
				<li><<birdicon "wallet">> Bailey wants <<printmoney 500000>> to build a spring in the orphanage garden.</li>
			<<elseif $mason_pond is 3>>
				<li><<watericon "waterside_wolfcave">> A spring is being built in the orphanage garden.</li>
			<<elseif $mason_pond is 4>>
				<li><<watericon "waterside_wolfcave">> The spring in the orphanage garden should be finished.</li>
			<</if>>

			<<if $brothel_machine_repair is 1>>
				<li><<socialiseicon "ask">> Ask Briar about the backstage sex machine.</li>
			<<elseif $brothel_machine_repair is 2>>
				<li><<symbol "lust">> The brothel sex machine needs refuelling. It uses an expensive pink gel. Briar suggested looking in the landfill. It would be deep inside, near the compactor.</li>
			<<elseif $brothel_machine_repair is 3>>
				<li><<symbol "lust">> You have the pink gel Briar wants for the sex machine.</li>
			<</if>>

			<<if $harpy gte 6 and $birdFly isnot 1>>
				<li><<birdicon "prepare_hunt_day">> Your wings are strong, but you don't know how to use them. The Great Hawk could teach you.</li>
			<</if>>
			<<set _eggIcon to Object.values(V.children).filter(child => (child.type === "hawk" && child.location === "inventory")).length>>
			<<if _eggIcon gt 0>>
				<li><<birdicon "eggs">> You're carrying <<number _eggIcon>> fertilised bird <<pluralise _eggIcon "egg. It needs" "eggs. They need">> to be brought to <<if $syndromebird>>your nest<<else>>the tower<</if>> in the moor to hatch.</li>
			<</if>>

			<<if $farm_stage gte 5 and $estate_fence is undefined>>
				<li><<mooricon "remy">> Remy is encroaching on Alex's farm, operating from the estate on the moor.</li>
			<<elseif $farm_stage gte 5 or isPubfameTaskAccepted("wren")>>
				<<if $estate_fence is "quest" and currentSkillValue('skulduggery') lt 800>>
					<li><<mooricon "remy">> Find someone who can help you break into the Remy Estate. Someone with underworld connections, or who knows the moor.</li>
				<<elseif $estate_fence is "bird">>
					<li><<mooricon "remy">> Search the Remy Estate fence for an entrance made by the Great Hawk.</li>
				<<elseif $estate_fence is "landry">>
					<li><<mooricon "remy">> Search the Remy Estate fence for an entrance made by Landry's specialist.</li>
				<</if>>
			<</if>>

			<<if $farm>>
				<<if $farm.tower gte 1 and !$farm.tower_guard>>
					<li><<investigateicon>> The watchtower at the farm isn't staffed. You can find suitable candidates in the pub on Harvest Street.</li>
				<</if>>
			<</if>>

			<<if $photo>>
				<<if $photo.job is "kaiju" and $photo_high_money>>
					<li><<photographystudioicon>> You can collect your pay for the High Street job from Niki.</li>
				<<elseif $photo.job is "kaiju">>
					<li><<photographystudioicon>> You've done a client job for Niki this week.</li>
				<</if>>
			<</if>>

			<<if $jordan_ritual_dance is 1>>
				<li><<danubeicon>> Jordan has asked you to investigate one of the manors on Danube Street. One of the temple's flock went missing after finding work there. You can get access through Charlie, and your status as a dancer.</li>
			<<elseif $jordan_ritual_dance is 2>>
				<li><<templeicon>> You encountered a strange ritual in a manor on Danube Street. Inform Jordan, head <<nnpc_title "Jordan">> at the temple.</li>
			<</if>>

			<<if $farm>>
				<<if $farm.build>>
				<li>
					<<switch $farm.build>>
						<<case "parasites 1">>
							<<farmicon 'parasitebarn'>> The parasite barn is being built.
						<<case "parasites 2">>
							<<farmicon 'parasitebarn'>> The parasite barn is being expanded.
						<<case "wall 1">>
							<<choreicon "fix">> The wall is undergoing a thorough repair.
						<<case "wall 2">>
							<<choreicon "fix">> The wall is being reinforced.
						<<case "wall 3">>
							<<choreicon "fix">> A metal fence is being built atop the stone wall.
						<<case "wall 4">>
							<<choreicon "fix">> Barbed wire is being affixed atop the fence.
						<<case "tower 1">>
							<<skyscrapericon "construction">> A watchtower is being constructed at the edge of the fields.
						<<case "tower 2">>
							<<techicon "torch">> Searchlights are being affixed atop the watchtower.
						<<case "kennel 1">>
							<<farmicon "kennel">> A guard dog training facility is being constructed.
						<<case "barn 1" "barn 2">>
							<<farmicon "barn">> The barn is being expanded.
						<<case "woodland 1" "woodland 2" "woodland 3">>
							<<choreicon "fix">> A fence is being built around the nearby woodland.
						<<case "stable 1">>
							<<farmicon "barn">> The stable is being expanded.
						<<case "coop 1" "coop 2">>
							<<farmicon "barn">> The coop is being expanded.
						<<case "irrigation">>
							<<gardenicon "plot">> Irrigation is being installed in a field.
						<<case "nursery">>
							<<childicon "crib">> A nursery is being built in the cottage.
					<</switch>>
					It'll be finished <<nDays $farm.build_timer>>.
				</li>
				<</if>>
			<</if>>

			<<if $adultshopgrandopening is true>>
				<li><<shopicon "adult">> The grand opening of Sirris' adult shop is taking place on Elk Street <span class="pink">today</span>.</li>
			<<elseif $adultshopintro is 1 and $adultshopunlocked is undefined>>
				<<set $_theshop to "The adult shop">>
				<li>
					<<if $adultshopprogress gte 22>>
						<<shopicon "adult">> $_theshop's official opening is tomorrow.
					<<elseif $adultshopprogress gte 18>>
						<<shopicon "dilapidated">> $_theshop is nearing completion.
					<<elseif $adultshopprogress gte 14>>
						<<shopicon "dilapidated">> $_theshop is halfway to completion.
					<<elseif $adultshopprogress gte 7>>
						<<shopicon "dilapidated">> $_theshop is starting to take shape.
					<<elseif $adultshopprogress gte 2>>
						<<shopicon "dilapidated">> $_theshop is in disrepair.
					<<else>>
						<<shopicon "dilapidated">> $_theshop is in great disrepair.
					<</if>>
					<<if $adultshopprogress lt 22>>
						You can help Sydney there on Elk Street, on Fridays after <<ampm 16>>.
					<</if>>
				</li>
			<</if>>

			<<if $avery_mansion?.landry is 1 and !$avery_fate>>
				<li><<harvesticon>> Someone dropped a note for you outside Avery's mansion, asking you to visit them in the pub on Harvest Street.</li>
			<</if>>

			<<if $gwylan?.request?.event and !($gwylan?.timer?.nobody gte Time.date.timeStamp)>>
				<<switch $gwylan.request.event>>
					<<case "meetAtShop">>
						<li><<shopicon "forest">>Gwylan has asked you to meet <<nnpc_him "Gwylan">> at the forest shop.</li>
					<<case "meetAtCafe">>
						<li><<cafeicon>>Gwylan has asked you to meet <<nnpc_him "Gwylan">> at the cafe between <<ampm 7 20>> and <<ampm 9 20>>.</li>
					<<case "yearning">>
						<li><<shopicon "forest">>Gwylan has asked you to meet <<nnpc_him "Gwylan">> at the forest shop so <<nnpc_he "Gwylan">> can apologise properly.</li>
					<<case "clothing">>
						<li><<shopicon "forest">>Gwylan has asked you to wear <<if $gwylan.request.items.length gt 1>>some clothes<<else>>a clothing item<</if>> to the forest shop.</li>
						<<gwylanJournalItems>>
					<<case "ingredients">>
						<li><<icon "tending/basket.png">>Gwylan has asked you to gather some ingredients.</li>
						<<gwylanJournalItems>>
					<<case "sample">>
						<li><<iconUi "sym-lust-empty.png">> Gwylan has asked you to gather some samples.</li>
						<<gwylanJournalItems>>
					<<case "recipe">>
						<li><<icon "tending/basket.png">>Gwylan has asked you to gather some items to make <span class="blue">$gwylan.request.special</span>.</li>
						<<gwylanJournalItems>>
					<<case "samplePlayer">>
						/* ToDo: Gwylan */
					<<case "preen">>
						<<if $gwylan.request.special is "harpy">>
							<li><<tficon "bird">> Gwylan has asked to preen your wings.
							<<if $harpy lt 6>>
								<span class="blue">You don't have wings anymore. Perhaps enough hawk feathers will suffice.</span>
							<</if>>
							</li>
						<<else>>
							<<set $_featherCount to $gwylan.request.items.find(feather => feather.name === "feathers").need>>
							<li><<birdicon "feathers">> Gwylan has asked you for <span class="gold"><<number $_featherCount>></span> of the hawk's feathers.</li>
							<<if $bird?.materials?.feathers>>You have <span class="blue"><<number $bird.materials.feathers>>.</span><</if>>
							<<if $harpy gte 6>>
								<span class="gold">Perhaps <<nnpc_he "Gwylan">> could preen your wings directly...</span>
							<</if>>
						<</if>>
					<<case "cream">>
						<li><<foodstufficon "cream">><span class="lewd">Gwylan has made you a lewd offer involving some cream...</span></li>
					<<case "robin">>
						/* ToDo: Gwylan */
					<<case "chastity">>
						<li>
						<<if playerChastity()>><<lockicon>><<else>><<lockicon "unlock">><</if>>
						<<if $gwylan.request.command is true>>
							Gwylan <<if $hypnosis_traits.devotion gte 3>>has commanded<<else>>wants<</if>> you to remove your chastity device.
						<<else>>
							Gwylan has offered to help you remove your chastity device.
						<</if>>
						<<if playerChastity() and $gwylan.request.items>>
							<<nnpc_He "Gwylan">> needs some items to help.
						<</if>>
						</li>
						<<if !playerChastity()>>
							<span class='fa-icon fa-selected'></span>
						<<else>>
							<span class='fa-icon fa-unselected'></span>
						<</if>>
						<<if $worn.genitals.name is "gold chastity belt" or $gwylan.request.details?.gold>>
							<<antiqueicon "chastity">>
						<<else>>
							<<icon "clothes/chastity-belt.png">>
						<</if>>
						<span class="red">Remove</span> chastity device
						<<if playerChastity() and $gwylan.request.items>>
							<br><span class="blue">Or</span><br>
							<<gwylanJournalItems>>
						<</if>>

					<<default>>
						<li><span class="red">Gwylan has asked you to do something, but the task has no journal description! Please report this bug.</span></li>
				<</switch>>
			<</if>>
		</ul>
	<</if>>

	<<if ($valentines is 1) or $halloween is 1 or $christmas is 1>>
		<hr>
		<h1 class="header gold bold">Holidays</h1>
	<</if>>
	<<if $valentines is 1>>
		<ul class="journal">
			<li>Valentine's day is held <<if Time.monthDay is 14>><span class="gold">today</span><<else>>on <<= getFormattedDate(new DateTime(Time.year, 2, 14))>><</if>>. You feel spending time with someone special will be extra rewarding.</li>
			<<if $valentines_eden is 1 and !$valentines_eden_bought>>
				<li>You can buy something for Eden to celebrate.</li>
			<<elseif $valentines_eden_bought is 1>>
				<li>You can prepare a bath for Eden on Valentine's day at <<ampm 17 00>>.</li>
			<</if>>
		</ul>
	<</if>>

	<<if $halloween is 1>>
		<ul class="journal">
			<li>Halloween is held on <<= getFormattedDate(new DateTime(Time.year, 10, 31))>>.</li>
			<<if $halloween_whitney is 1 and C.npc.Whitney.state isnot "dungeon">>
				<li>Whitney will be trick-or-treating on Domus Street from <<ampm 19 00>>.</li>
			<</if>>
			<<if $halloween_robin is 1 and $robinmissing is 0>>
				<li>Robin wants to go trick-or-treating between <<ampm 16 00>> and <<ampm 19 00>>.</li>
			<</if>>
			<<if $halloween_kylar is 1 and C.npc.Kylar.state isnot "prison">>
				<li>Kylar has asked you to meet in the park after <<ampm 21 00>>.</li>
			<</if>>
			<<if $halloween_eden is 1>>
				<li>You can buy sweets for Eden to celebrate Halloween.</li>
			<</if>>
			<<if $halloween_lake is 1>>
				<li>Students are throwing a party at the lake from <<ampm 18 00>> until midnight.</li>
				<<if $halloweenWolves>>
					<li>One of the members of the wolf pack was injured at it.</li>
				<</if>>
			<</if>>
		</ul>
	<</if>>

	<<if $christmas is 1>>
		<ul class="journal">
			<li>
				<<if Time.monthDay is 25 and Time.hour lte 20>>
					The orphans are celebrating Christmas.
				<<else>>
					The orphans will celebrate Christmas on the <span class="gold">25th</span> as best they can.
				<</if>>
				<<if $christmas_gift is undefined>>
					You can buy them gifts at the shopping centre.
				<<elseif $christmas_gift is "clothes_unwrapped">>
					You can wrap their gifts in your room at the orphanage.
				<</if>>
			</li>

			<<if $christmas_gift_robin is undefined and C.npc.Robin.init is 1>>
				<li>You can buy Robin a gift at the shopping centre<<if $forest_shop_intro is 1>> or forest shop<</if>>.</li>
			<<elseif $christmas_gift_robin and $christmas_gift_robin_wrapped isnot 1 and C.npc.Robin.init is 1>>
				<li>You can wrap Robin's gift in your room.</li>
			<</if>>
			<<if !$christmas_wrap>>
				<li>The shopping centre should sell wrapping paper.</li>
			<</if>>

			<<if $syndromeeden gte 1>>
				<<if Time.monthDay is 25>>
					<<if Time.hour lte 20>>
						<li>You can celebrate Christmas with Eden <span class="pink">today</span>.</li>
					<</if>>
				<<else>>
					<li>Christmas is coming. You can celebrate it with Eden.</li>
				<</if>>
				<<if $christmas_gift_eden is undefined>>
					<li>You can buy Eden a gift at the shopping centre.</li>
				<</if>>
				<<if $edenmeal is 1>>
					<li>Eden's invited you for a Christmas dinner at <<ampm 18 00>>.</li>
				<</if>>
			<</if>>
			<<if $fake_artefact is "pc" and $avery_fate isnot "ascended">>
				<li>Landry wants you to find the wishing stones in the vault in Avery's mansion and replace them with the fakes <<nnpc_he Landry>> provided. <<nnpc_He Landry>> said that would save Avery from <<nnpc_himself "Avery">>.</li>
			<</if>>
		</ul>
	<</if>>

	<<if $avery_mansion and C.npc.Avery.state isnot "dismissed">>
		<hr>
		<h1 class="header gold bold">Avery's Demands</h1>
		<ul class="journal carry">
			<li><<foodicon "eat">>Avery wants you to have dinner ready at <span @class="between(Time.weekDay,2,6) ? 'gold' : ''"><<ampm 21 00>> weekdays</span>.</li>
			<<if $avery_mansion.food isnot "none">>
				<li>
					<<foodstufficon $avery_mansion.food>>
					<<set $_averyMissedColor to ["","purple","pink","red"][Math.clamp($avery_mansion.rage.dinner_missed,0,3)]>>
					<<set $_averyDishAmount to $foodstuff[$avery_mansion.food].amount>>
					<<set $_averyDishAmountColour to $foodstuff[$avery_mansion.food].amount ? "green" : "red">>
					<span @class="$_averyMissedColor">Avery wants <<recipe_name $avery_mansion.food "article">>.</span> You currently have <span @class="$_averyDishAmountColour"><<print $_averyDishAmount>></span>.
				</li>
			<</if>>
			<<if !["missed", "started"].includes($avery_mansion.party_state)>>
				<li><<icon "front-gate.png">>You're expected at Avery's mansion <span @class="Time.weekDay is 1 ? 'gold' : ''">after <<ampm 18>> <<if ["first sunday skip", "finished", "skipped"].includes($avery_mansion.party_state)>>next<<else>>on<</if>> Sunday</span>, for a party. The guest of honour is $avery_mansion.guest.</li>
			<</if>>
			<<if $avery_mansion.fox.task and !$avery_fate>>
				<li><<icon "clothes/fox-mask.png">>
				<<if $avery_mansion.fox.task_complete is "success">>
					<span class="green">You have completed the brown fox's task.</span>
				<<elseif $avery_mansion.fox.task_complete is "fail">>
					<span class="red">You have failed the brown fox's task.</span>
				<<elseif $avery_mansion.fox.task isnot $avery_mansion.guest and $avery_mansion.fox.task isnot "heist">>
					<span class="purple">You did not complete the brown fox's task.</span>
				<<else>>
					<<switch $avery_mansion.fox.task>>
						<<case "heist">>The brown fox trusts you enough to conduct a direct heist of the wishing stones and has given you a signal to make in the garden whenever Avery isn't around.
						<<case "Jordan">>
							The brown fox has asked you to give a message to two disguised initiates<<if $avery_mansion.fox.task_detail is "ascend">> and ensure they don't obstruct the construction<</if>> when Jordan comes by the mansion.
						<<case "Quinn">>The brown fox has asked you to perform a hand signal after getting the attention of a compromised agent who's grown attached to Quinn at the next party.
						<<case "Remy">>
							<<if $brownFoxWounded or $fake_artefact is "Avery">>
								<<if $avery_mansion.fox.task_detail is "descend">>
									The brown fox has tasked you with ensuring that both of Remy's retainers leave the party early.
								<<else>>
									The brown fox has tasked you with ensuring that both of Remy's retainers remain at the party.
								<</if>>
							<<else>>
								The brown fox will be at Avery's next party.
							<</if>>
						<<case "Briar">>
							<<if $avery_mansion.fox.task_detail is "descend">>
								The brown fox has tasked you with getting Briar to actively sabotage construction on the tower during the next party.
							<<else>>
								The brown fox has tasked you with convincing Briar to support tower construction during the next party.
							<</if>>
						<<case "Harper">>The brown fox has tasked you with swapping out Harper's phials during the next party.
					<</switch>>
				<</if>>
				</li>
			<</if>>
			/* Reworked, left in while in construction
			<<if $avery_mansion.landry gte 2 and $auriga_artefact is "Avery">>
				<li>Landry will give you <span class="gold">£10000</span> if you can bring <<nnpc_him "Landry">> the <span class="pink">wishing stones</span> from Avery's mansion.</li>
				<<if $avery_mansion.mickey>>
					<li>Mickey suggests making Avery feel more dominant would cause them to reveal the stones' location. Alternatively, helping Avery reach their goals could bring them into the open.</li>
				<</if>>
				<<if $avery_mansion.jobs.includes("dungeon")>>
					<li>Avery revealed a dungeon containing a vault. It seems a likely place for the stones.</li>
				<</if>>
				<<if $avery_mansion.fake_stones is 2>>
					<li>Optionally, replace Avery's wishing stones with the fakes Mickey gave you.</li>
				<</if>>
			<<elseif $avery_mansion.landry gte 2 and $auriga_artefact is "pc">>
				<li>Landry will give you <span class="gold">£10000</span> if you can bring <<nnpc_him "Landry">> the <span class="pink">wishing stones</span> that are in your possession.</li>
			<</if>>
			<<if $avery_mansion.fake_stones is 1>>
				<li><<investigateicon>> Find a convincing fake to swap for the wishing stones.</li>
			<<elseif $avery_mansion.fake_stones is 2>>
				<li><<icon "avery-vault.png">> Leave the fake wishing stones in Avery's vault.</li>
			<</if>>*/
			<<if $avery_mansion.jobs.filter(job => !job.includes("dungeon")).length>>
				<li>
					<<icon "avery-garage.png">> Additionally, Avery expects to see proper presentation from you when <<nnpc_he "Avery">> returns from work.
					<<if $avery_mansion.jobs.includes("maid")>>
						<br>
						<<if $worn.upper.type.includes("maid") and $worn.lower.type.includes("maid")>>
							<span class='fa-icon fa-selected'></span>
						<<else>>
							<span class='fa-icon fa-unselected'></span>
						<</if>>
						<<iconUi "clothes/traits/maid.png">>Greeting <<nnpc_him Avery>> wearing an outfit with the maid trait.
					<<elseif $avery_mansion.jobs.includes("formal")>>
						<br>
						<<if $worn.upper.type.includes("formal") and $worn.lower.type.includes("formal")>>
							<span class='fa-icon fa-selected'></span>
						<<else>>
							<span class='fa-icon fa-unselected'></span>
						<</if>>
						<<iconUi "clothes/traits/formal.png">>Greeting <<nnpc_him Avery>> wearing an outfit with the formal trait.
					<</if>>
					<<if $avery_mansion.jobs.includes("knees")>>
						<br>
						<<if $avery_mansion.kneel isnot "refuse">>
							<span class='fa-icon fa-selected'></span>
						<<else>>
							<span class='fa-icon fa-unselected'></span>
						<</if>>
						<<sneakicon>>Greeting <<nnpc_him Avery>> by kneeling before <<nnpc_him Avery>>.
					<<elseif $avery_mansion.jobs.includes("bow")>>
						<br>
						<<if $avery_mansion.bow>>
							<span class='fa-icon fa-selected'></span>
						<<else>>
							<span class='fa-icon fa-unselected'></span>
						<</if>>
						<<sneakicon>>Greeting <<nnpc_him Avery>> by <<= $player.gender_appearance is "f" ? "curtsying" : "bowing">> to <<nnpc_him Avery>>.
					<</if>>
					<<if $avery_mansion.jobs.includes("meek")>>
						<br>
						<<if $speech_attitude is "meek" or $speech_attitude_avery>>
							<span class='fa-icon fa-selected'></span>
						<<else>>
							<span class='fa-icon fa-unselected'></span>
						<</if>>
						<<socialiseicon>>Greeting <<nnpc_him Avery>> with a meek demeanour.
					<</if>>
					<<if $avery_mansion.jobs.includes("hairlength")>>
						<br>
						<<if $hairlength lt 400>>
							<span class='fa-icon fa-selected'></span>
						<<else>>
							<span class='fa-icon fa-unselected'></span>
						<</if>>
						<<icon "scissors.png">>Keeping your hair no longer than your shoulders.
					<</if>>
					<<if $avery_mansion.jobs.includes("hairstyle")>>
						<br>
						<<if $hairtype is "neat">>
							<span class='fa-icon fa-selected'></span>
						<<else>>
							<span class='fa-icon fa-unselected'></span>
						<</if>>
						<<icon "comb.png">>Keeping your hair in the 'neat' style.
					<</if>>
					<<if ["lounge", "dining", "bedroom", "pool", "garden", "display", "kitchen", "bathroom"].includesAny($avery_mansion.jobs)>>
						<br>
						<<avery_mansion_housework_total>>
						<<set $_averyCleanColor to ["","purple","pink","red"][Math.clamp(Math.floor((_avery_mansion_housework_total) / 3),0,3)]>>
						<<if $_averyCleanColor is "">>
							<span class='fa-icon fa-selected'></span>
						<<else>>
							<span class='fa-icon fa-unselected'></span>
						<</if>>
						<<icon "clothes/feather-duster.png">><span @class="$_averyCleanColor">Keeping <<nnpc_his Avery>> mansion clean.</span>
					<</if>>
				</li>
			<</if>>
			<<if $avery_tower>>
				<<if $avery_tower.stage is 3 and !$avery_fate>>
					<li><<skyscrapericon "bloodmoon">> Avery expects you to meet <<nnpc_him Avery>> at <<nnpc_his Avery>> mansion <span class="gold">during the next blood moon</span> to attend the opening ceremony for <<nnpc_his Avery>> skyscraper.
					</li>
				<</if>>
			<</if>>
		</ul>
	<</if>>

	<<if $scienceproject is "ongoing">>
		<hr>
		<h1 class="header gold bold">Science Fair</h1>
		<<if $scienceprojectdays is 0>>
			The science fair is being held at the town hall on Cliff Street <span class="pink">today</span> from <<ampm 9 00>> until <<ampm 18 00>>.
			<br>
		<<else>>
			The science fair will be held at the town hall on Cliff Street <<nDays $scienceprojectdays>>.
			<br>
		<</if>>
		<<if $avery_mansion and $scienceproject is "ongoing" and ($sciencephalluschance gte 1 or $sciencelichenchance gte 1 or $scienceshroomchance gte 1) and !$avery_mansion.attend.science and $avery_fate isnot "fallen" and $avery_fate isnot "kicked">>
			<span class="blue">Consider asking Avery to attend.</span>
			<br>
		<</if>>
		You have the following ongoing science projects. You'll choose one to present at the fair.
		<br><br>
		<<if $sciencelichenknown is 1>>
			<span class="gold bold">Local Lichen</span>
			<br>
			<<if $sciencechance is undefined>>
				<<set $sciencechance to []>>
			<</if>>
			<<if $sciencelichenpark is 1>>
				<<if $sciencelichenparkready is 1>>
					<<run $sciencechance.pushUnique("Lichen")>>
					<span class='fa-icon fa-selected'></span> You've incorporated the lichen living in the park to your project.
					<br>
				<<else>>
					<span class='fa-icon fa-unselected'></span> You've examined lichen in the park. You need to write it up at home or the library.
					<br>
				<</if>>
			<<else>>
				<span class='fa-icon fa-unselected'></span><span class="black"> Examine white lichen in the park.</span>
				<br>
			<</if>>
			<<if $sciencelichentemple is 1>>
				<<if $sciencelichentempleready is 1>>
					<<run $sciencechance.pushUnique("Temple")>>
					<span class='fa-icon fa-selected'></span> You've incorporated the lichen living on the temple to your project.
					<br>
				<<else>>
					<span class='fa-icon fa-unselected'></span> You've examined lichen living on the temple. You need to add it to your project at home or the library.
					<br>
				<</if>>
			<<else>>
				<span class='fa-icon fa-unselected'></span><span class="black"> Examine pink lichen on the temple.</span>
				<br>
			<</if>>
			<<if $sciencelichendrain is 1>>
				<<if $sciencelichendrainready is 1>>
					<<run $sciencechance.pushUnique("Drain")>>
					<span class='fa-icon fa-selected'></span> You've incorporated the lichen living in the storm drain to your project.
					<br>
				<<else>>
					<span class='fa-icon fa-unselected'></span> You've examined lichen living in the storm drain. You need to add it to your project at home or the library.
					<br>
				<</if>>
			<<else>>
				<span class='fa-icon fa-unselected'></span><span class="black"> Examine violet lichen in the storm drain, where it exits into the sea.</span>
				<br>
			<</if>>
			<<if $sciencelichenlake is 1>>
				<<if $sciencelichenlakeready is 1>>
					<<run $sciencechance.pushUnique("Ruin")>>
					<span class='fa-icon fa-selected'></span> You've incorporated the lichen living on the lake ruin to your project.
					<br>
				<<else>>
					<span class='fa-icon fa-unselected'></span> You've examined lichen living on the lake ruin. You need to add it to your project at home or the library.
					<br>
				<</if>>
			<<else>>
				<span class='fa-icon fa-unselected'></span><span class="black"> Examine purple lichen on the lake ruin.</span>
				<br>
			<</if>>
			As it is, this project has a <span @class="($sciencechance.length is 0 ? 'red' : $sciencechance.length is 1 ? 'pink' : $sciencechance.length is 2 ? 'purple' : $sciencechance.length is 3 ? 'teal' : $sciencechance.length is 4 ? 'green' : '')"><<print ($sciencelichenparkready * 25 + $sciencelichenlakeready * 25 + $sciencelichendrainready * 25 + $sciencelichentempleready * 25)>>%</span> chance of winning the fair. Winning with this project will greatly reduce trauma and endear you to your teachers.
			<br><br>
		<<else>>
			<span class="black">????????????</span>
			<br>
			Explore to discover.
			<br><br>
		<</if>>
		<<if $scienceshroomknown is 1>>
			<span class="gold bold">Local Mushrooms</span>
			<br>
			<span @class="($scienceshroomheart is 5 ? 'fa-icon fa-selected' : 'fa-icon fa-unselected')"></span><span @class="$scienceshroomheart is 0 and $scienceshroomheartready is 0 ? 'black' : ''"> $scienceshroomheart/5 heartshrooms found.</span>
			<br>
			<span @class="($scienceshroomheartready is 5 ? 'fa-icon fa-selected' : 'fa-icon fa-unselected')"></span><span @class="$scienceshroomheart is 0 and $scienceshroomheartready is 0 ? 'black' : ''"> $scienceshroomheartready/5 heartshrooms added to project.</span>
			<<if $scienceshroomheart gt $scienceshroomheartready>>
				Add mushrooms to your project at home or the library.
			<</if>>
			<br>
			<span @class="($scienceshroomwolf is 5 ? 'fa-icon fa-selected' : 'fa-icon fa-unselected')"></span><span @class="$scienceshroomwolf is 0 and $scienceshroomwolfready is 0 ? 'black' : ''"> $scienceshroomwolf/5 wolfshrooms found.</span>
			<br>
			<span @class="($scienceshroomwolfready is 5 ? 'fa-icon fa-selected' : 'fa-icon fa-unselected')"></span><span @class="$scienceshroomwolf is 0 and $scienceshroomwolfready is 0 ? 'black' : ''"> $scienceshroomwolfready/5 wolfshrooms added to project.</span>
			<<if $scienceshroomwolf gt $scienceshroomwolfready>>
				Add mushrooms to your project at home or the library.
			<</if>>
			<br>
			<<set $scienceshroomchance to ($scienceshroomwolfready * 10 + $scienceshroomheartready * 10)>>
			As it is, this project has a <span @class="$scienceshroomchance gte 100 ? 'green' : $scienceshroomchance gte 80 ? 'teal' : $scienceshroomchance gte 60 ? 'lblue' : $scienceshroomchance gte 40 ? 'purple' : $scienceshroomchance gte 20 ? 'pink' : $scienceshroomchance gte 0 ? 'red' : ''"><<print $scienceshroomchance>>%</span> chance of winning the fair. Winning with this project will greatly reduce trauma and make you more popular among your peers.
			<br><br>
		<<else>>
			<span class="black">????????????</span>
			<br>
			Explore the forest to discover.
			<br><br>
		<</if>>
		<<if $sciencephallusknown is 1>>
			<span class="gold bold">Local Phalli <mouse class="tooltip gold">(?)<span>Look for participants on the beach during good weather.</span></mouse></span>
			<br>
			<span @class="($sciencephallus is 10 ? 'fa-icon fa-selected' : 'fa-icon fa-unselected')"></span> $sciencephallus/10 phalli measured.
			<br>
			<span @class="($sciencephallusready is 10 ? 'fa-icon fa-selected' : 'fa-icon fa-unselected')"></span> $sciencephallusready/10 phalli added to project.
			<<if $sciencephallus gt $sciencephallusready>>
				Add phalli to your project at home or the library.
			<</if>>
			<br>
			As it is, this project has a <span @class="$sciencephallusready gte 10 ? 'green' : $sciencephallusready gte 8 ? 'teal' : $sciencephallusready gte 6 ? 'lblue' : $sciencephallusready gte 4 ? 'purple' : $sciencephallusready gte 2 ? 'pink' : $sciencephallusready gte 0 ? 'red' : ''"><<print ($sciencephallusready * 10)>>%</span> chance of winning the fair. Winning with this project will greatly reduce trauma and make you more famous.
			<br>
		<<else>>
			<span class="black">????????????</span>
			<br>
			Become more promiscuous to discover.
			<br>
		<</if>>
	<</if>>


	<<if $mathsproject is "ongoing">>
		<<set $mathschance = Math.clamp($mathschance, 0, 100)>>
		<hr>
		<h1 class="header gold bold">Maths Competition</h1>
		<<if $mathsprojectdays is 0>>
			The maths competition is being held at the town hall on Cliff Street <span class="pink">today</span> from <<ampm 9 00>> until <<ampm 18 00>>.
			<br>
		<<else>>
			The maths competition will be held at the town hall on Cliff Street in <span class="gold">$mathsprojectdays</span> <<pluralise $mathsprojectdays "day">>.
			<br>
			Your solution must be ready before then. You can work on your project at the orphanage or the school library.
			<br>
		<</if>>
		<<if $avery_mansion and $mathsproject is "ongoing" and $mathschance gte 1 and !$avery_mansion.attend.maths and $avery_fate isnot "fallen" and $avery_fate isnot "kicked">>
			<span class="blue">Consider asking Avery to attend.</span>
			<br>
		<</if>>
		<<if $mathschance is 0>>
			<span class="black">You haven't begun work on a solution. You have a $mathschance% chance of winning the competition.</span>
		<<elseif $mathschance lte 10>>
			<span class="pink">You've barely begun work on a solution. You have a $mathschance% chance of winning the competition.</span>
		<<elseif $mathschance lte 30>>
			<span class="purple">Your solution isn't much, but it's something. You have a $mathschance% chance of winning the competition.</span>
		<<elseif $mathschance lte 50>>
			<span class="blue">Your solution has some substance, but there's a long way to go. You have a $mathschance% chance of winning the competition.</span>
		<<elseif $mathschance lte 80>>
			<span class="lblue">Your solution is shaping up, but there's room for improvement. You have a $mathschance% chance of winning the competition.</span>
		<<elseif $mathschance lte 99>>
			<span class="teal">Your solution isn't right, but it's good. You can't imagine anyone else has gone as far as this. You have a $mathschance% chance of winning the competition.</span>
		<<else>>
			<span class="green">Your solution is perfect. You have a $mathschance% chance of winning the competition.</span>
		<</if>>
		<br><br>
		You have <span class="gold">$mathsinfo</span> <<pluralise $mathsinfo "insight">>.
		<<if $stimdealerknown is 1>>
			You have <span class="gold">$mathsstim</span> <<pluralise $mathsstim "stimulant">>.
			<br>
			You can buy stimulants from dealers on Oxford Street.
			<br>
		<</if>>
	<</if>>

	<<if $englishPlay is "ongoing">>
		<hr>
		<h1 class="header gold bold">English Play</h1>
		<<if $englishPlayDays is 0>>
			The school plays are being held at the town hall on Cliff Street <span class="pink">tonight</span> from <span class="gold"><<ampm 17 00>></span> until <span class="gold"><<ampm 21 00>></span>.
		<<else>>
			The school plays will be performed at the town hall on Cliff Street in <span class="gold">$englishPlayDays</span> <<pluralise $englishPlayDays "day">>.
		<</if>>
		/*
		<<if $avery_mansion and $englishPlay is "ongoing" and $englishPlayReadiness gte 1 and !$avery_mansion.attend.english_play and $avery_fate isnot "fallen" and $avery_fate isnot "kicked">>
			<span class="blue">Consider asking Avery to attend.</span>
			<br>
		<</if>>
		 */
		<<if $englishPlayRoles.Player isnot "none">>
			<ul class="journal">
			<li>You have taken the role of $englishPlayRoles.Player. You can rehearse alone at the orphanage.</li>
			<<if $englishPlayRoles.Kylar isnot "none" and $englishPlayRoles.KylarKnown>>
				<li>Kylar has taken the role of $englishPlayRoles.Kylar. You can rehearse with <<nnpc_him "Kylar">> in <<if Weather.precipitation !== "none">>the school library<<else>>the school's rear courtyard<</if>> after school.</li>
			<<elseif $englishPlayKylarReplace>>
				<li>Kylar's part in the play will have to be taken over by another student.</li>
			<</if>>
			<<if $englishPlayRoles.SydneyKnown>>
				<li>Sydney has taken the role of $englishPlayRoles.Sydney. You can rehearse with <<nnpc_him "Sydney">> in the English classroom after school.</li>
			<</if>>
			<<if !$englishPlayRoles.SydneyKnown and !$englishPlayRoles.KylarKnown>>
				<li>You can meet your partners in the English classroom after school.</li>
			<<elseif !$englishPlayRoles.SydneyKnown or (!$englishPlayRoles.KylarKnown and !$englishPlayKylarReplace and $englishPlayRoles.Kylar isnot "none")>>
				<li>You can meet your other partner in the English classroom after school.</li>
			<</if>>
			</ul>
			<br>
			<<playReadiness>>
			Performing well will spread social fame and give a large boost to school status.
		<<else>>
			<<if $englishPlayLate>>
				You have <<number $englishPlayLate>> <<pluralise $englishPlayLate "day">> to choose a role. You can sign up in the English classroom after school, or just help other students rehearse.
			<<else>>
				It's too late for you to take a role, but you can still help other students rehearse and watch the plays with the audience.
			<</if>>
		<</if>>
	<</if>>

	<<set _foodstuffKeys to Object.keys($foodstuff)>>
	<<set _hasProduce to Object.keys($foodstuff).some(key => $foodstuff[key].amount >= 1)>>
	<<set _carrying to [$antiquemoney, $blackmoney, $phials_held, $lurkers_held, $popcorn, $milkshake, $panties_held, $prison?.teeth].some(i => i >= 1)>>
	<<if _carrying or _hasProduce>>
		<hr>
		<h1 class="header gold bold">Inventory</h1>
	<</if>>
	<<if $livestock.lock.keys is true and $location is "farm" and !$bus.includes("farm")>>
		You have stored:
		<ul class="journal carry">
			<li><<lockicon "bronze key">> <span class="green">A ring of keys</span> in your stall. You can use them to escape, but be careful not to get caught with them.</li>
		</ul>
		<br>
	<</if>>
	<<if _carrying or _hasProduce>>
		You are carrying:
		<ul class="journal carry">
			<<if ["prison", "prison_beach"].includes($location) and $prison.teeth gte 1>>
				<li><<icon "tending/sharks-teeth.png">> <span class="green"><<number $prison.teeth>></span> shark's teeth.
				<<if $prison_wren_intro isnot 1>>
					You can find Wren in the yard on Fridays after lunch.
				<</if>>
				</li>
			<</if>>
			<<if $antiquemoney gt 0>>
				<li><<museumicon>><span class="green">£<<print $antiquemoney>></span> in antiques. You can sell them to the museum.</li>
			<</if>>
			<<if $blackmoney gt 0>>
				<li><<highicon>><span class="green">£<<print $blackmoney>></span> in stolen goods. You can sell them to someone on the black market.</li>
			<</if>>
			<<if $phials_held gt 0>>
				<li><<icon "aphrodisiac.png">> <span class="green">$phials_held</span> <<pluralise $phials_held "phial">> of aphrodisiac. You can sell <<pluralise $phials_held "it">> on Elk Street.</li>
			<</if>>
			<<if $lurkers_held gt 0>>
				<li><<birdicon "lurkers">><span class="green">$lurkers_held</span> <<pluralise $lurkers_held "lurker">>.</li>
			<</if>>
			<<if $milkshake gt 0>>
				<li><<foodicon "milkshake">> <span class="green">$milkshake</span> <<pluralise $milkshake "milkshake">>.</li>
			<</if>>
			<<if $popcorn gt 0>>
				<li><<foodicon "popcorn">> <span class="green">$popcorn</span> <<pluralise $popcorn "bag">> of popcorn.</li>
			<</if>>
			<<if $panties_held gt 0>>
				<li><span class="clothes-white"><<icon "clothes/plain-panties.png">></span> <<print $panties_held is 1 ? "a pair" : "<span class='green'>$panties_held</span> pairs">> of stolen underwear. You can sell <<pluralise $panties_held "it">> during lunchtime in the school rear courtyard.</li>
			<</if>>
			<<if _hasProduce>>
				<li><<stallicon "open">> <span class="green">Products</span> for sale. You can sell them by renting a stand on Connudatus Street at dawn.</li>
			<</if>>
		</ul>

		<<if _hasProduce>>
			<br>
			<details class="journal">
				<summary class="journal">Products</summary>
				<<set $_types to []>>
				<<for _t to 0; _t lt _foodstuffKeys.length; _t++>>
					<<set _foodstuff to setup.foodstuff[_foodstuffKeys[_t]]>>
					<<set _foodstuffType to ((_foodstuff?.category) === "dish" ? "food" : _foodstuff?.category)>>
					<<if _foodstuffType isnot undefined>>
						<<set $_types.pushUnique(_foodstuffType.toUpperFirst())>>
					<</if>>
				<</for>>
				<<set $_types.sort()>>
				<<if $_types.length>>
					<div style="padding: 0.25rem 0.5rem;">
						Show:
						<<listbox "_invDisplay" autoselect>>
							<<option "All" "all">>
							<<optionsfrom $_types>>
						<</listbox>>
					</div>
				<</if>>
				<div class="itemInventory" id="journalInv">
					<<journalInventory _invDisplay>>
				</div>
				<<run jQuery(document).on("change", "#listbox--invdisplay", function (e) {
					Wikifier.wikifyEval("<<replace #journalInv>><<journalInventory " + T.invDisplay.toLowerCase() + ">><</replace>>");
				});>>
			</details>
		<</if>>
	<</if>>

	<<if $museumintro is 1 or $plants_known.length gte 0>>
		<hr>
		<h1 class="header gold bold">Collectibles</h1>
		<<if $museumintro is 1>>
			<<museumAntiqueText>><<museumPaintingText>>
			<<if $museumAntiqueJournalHints.length gte 1 || Object.values(V.museumAntiques.paintings).includes("found")>>
				<<set _hintslist to clone($museumAntiqueJournalHints).reverse()>>
				<<if $museumAntiqueJournalHints.length gte 1>>
					Winter has mentioned some items that are missing from the museum.
				<</if>>
				<ul class="journal">
					<<for _hint range _hintslist>>
						<<if _museumAntiqueText[_hint]>>
							<<if ["found", "talk"].includes($museumAntiques.antiques[_hint])>>
								<li>You should show the <<= _museumAntiqueText[_hint].name.toLowerCase()>> to Winter.</li>
							<<else>>
								<li><<print _museumAntiqueText[_hint].journal>></li>
							<</if>>
						<<else>>
							<li><span class="red">Warning: Antique "_hint" doesn't have a hint. Did you export this save from a modded version?</span></li>
							<<set $museumAntiqueJournalHints.delete(_hint)>>
						<</if>>
					<</for>>
					<<for $_labelP, $_valueP range $museumAntiques.paintings>>
						<<if $_valueP is "found">>
							<li>You should show the <<= _museumPaintingText[$_labelP].journalName.toLowerCase()>> to Winter.</li>
						<</if>>
					<</for>>
				</ul>
				<br>
			<</if>>
			<<set $_antiquesFound to Object.values($museumAntiques.antiques).filter(status => status !== "notFound").length>>
			<<set $_paintingsFound to Object.values($museumAntiques.paintings).filter(status => status !== "notFound").length>>
			<<set $_totalFound to $_antiquesFound + $_paintingsFound>>
			<<if $_totalFound is 0>>
				You haven't found any items for the museum yet. Explore the world more to discover antiques.
			<<elseif $_antiquesFound is $museumAntiques.maxCount and !$museum_paintings_intro>>
				The museum has <span class="gold"><<= $_antiquesFound>></span> <<pluralise $_antiquesFound "antique">>.
				You've found <span class="green">every</span> antique for the museum.
			<<elseif $_totalFound is $museumAntiques.maxCount + Object.values($museumAntiques.paintings).length>>
				The museum has <span class="gold"><<= $_antiquesFound>></span> <<pluralise $_antiquesFound "antique">> and <span class="gold"><<= $_paintingsFound>></span> <<pluralise $_paintingsFound "painting">>.
				You've found <span class="green">every</span> item for the museum.
			<<else>>
				You've found
				<span class="gold"><<= $_antiquesFound>></span> <<pluralise $_antiquesFound "antique">>
				<<if $museum_paintings_intro>>and <span class="gold"><<= $_paintingsFound>></span> <<pluralise $_paintingsFound "painting">><</if>>
				for the museum.
				<<set _antiquesMissing to $museumAntiques.maxCount - $_antiquesFound>>
				<<set _paintingsMissing to Object.values($museumAntiques.paintings).length - $_paintingsFound>>
				<<if $_antiquesFound is $museumAntiques.maxCount>>
					You've found <span class="green">every</span> antique for the museum, but are missing <span class="gold"><<= _paintingsMissing>></span> <<pluralise _paintingsMissing "painting">>.
				<<elseif _paintingsMissing is 0>>
					You've found <span class="green">every</span> painting for the museum, but are missing
						<span class="gold"><<= _antiquesMissing>></span> <<pluralise _antiquesMissing "antique">>.
				<<else>>
					You're missing
					<span class="gold"><<= _antiquesMissing>></span> <<pluralise _antiquesMissing "antique">><<if $museum_paintings_intro>> and <span class="gold"><<= _paintingsMissing>></span> <<pluralise _paintingsMissing "painting">><</if>>.
				<</if>>
			<</if>>
			<br><br>
			<details class="journal">
				<summary class="journal">Museum Items</summary>
				<<if $museum_paintings_intro>>
					<span class="gold bold m-2">Antiques</span>
					<br>
				<</if>>
				<div class="itemCollectible">
					<<for _labelM, _valueM range $museumAntiques.antiques>>
						<<set _antique to $museumAntiqueJournalHints.includes(_labelM) ? _museumAntiqueText[_labelM]?.journalName || _museumAntiqueText[_labelM].name.toLowerCase().toUpperFirst() : _museumAntiqueText[_labelM].name.toLowerCase().toUpperFirst()>>
						<<if $museumAntiqueJournalHints.includes(_labelM)>>
							<<switch _valueM>>
								<<case "notFound">>
									<div class="item unknown" @tooltip="_antique">
										<<icon "museum-empty.png">>
									</div>
								<<default>>
									<div class="item" @tooltip="_antique">
										<<icon _museumAntiqueText[_labelM].icon>>
									</div>
							<</switch>>
						<<else>>
							<<switch _valueM>>
								<<case "notFound">>
									<div class="item unknown" tooltip="Unknown antique.">
										<<mysteryicon>>
									</div>
								<<default>>
									<div class="item" @tooltip="_antique">
										<<icon _museumAntiqueText[_labelM].icon>>
									</div>
							<</switch>>
						<</if>>
					<</for>>
				</div>
				<<if $museum_paintings_intro>>
					<hr>
					<span class="gold bold m-2">Paintings</span>
					<br>
					<div class="itemPainting">
						<<for _labelP, _valueP range $museumAntiques.paintings>>
							<<set _painting to _valueP isnot "museum" ? _museumPaintingText[_labelP].journalName : _museumPaintingText[_labelP].name>>

							<<switch _valueP>>
								<<case "museum" "recovered">>
									<<if _labelP is "paintingward">>
										<<if $bleedingWardCheckpoint>>
											<<set _painting += ": 50% heard">>
										<</if>>
									<<elseif _labelP is "paintingsnake">>
										<<set _painting to `<div style='text-align:center'>${_museumPaintingText[_labelP].name}`>>
										<<if $hcEndings.length is 0>>
											<<set _painting += "<br><span class='gold'>0/7 Endings:</span><br><span class='black'>S, A, B, C, D, E, F</span>">>
										<<else>>
											<<set _painting += `<br><span class='gold'>${$hcEndings.length}/7 Endings:</span><br>`>>
											<<set _painting += `<span class=${$hcEndings.includes('S') ? 'gold' : 'black'}> ${$hcEndings.includes('S') ? 'S' : '?'}</span>,`>>
											<<set _painting += `<span class=${$hcEndings.includes('A') ? 'green' : 'black'}> ${$hcEndings.includes('A') ? 'A' : '?'}</span>,`>>
											<<set _painting += `<span class=${$hcEndings.includes('B') ? 'teal' : 'black'}> ${$hcEndings.includes('B') ? 'B' : '?'}</span>,`>>
											<<set _painting += `<span class=${$hcEndings.includes('C') ? 'blue' : 'black'}> ${$hcEndings.includes('C') ? 'C' : '?'}</span>,`>>
											<<set _painting += `<span class=${$hcEndings.includes('D') ? 'purple' : 'black'}> ${$hcEndings.includes('D') ? 'D' : '?'}</span>,`>>
											<<set _painting += `<span class=${$hcEndings.includes('E') ? 'pink' : 'black'}> ${$hcEndings.includes('E') ? 'E' : '?'}</span>,`>>
											<<set _painting += `<span class=${$hcEndings.includes('F') ? 'red' : 'black'}> ${$hcEndings.includes('F') ? 'F' : '?'}</span>`>>
										<</if>>
										<<if $hcChallengesCompleted and Object.values($hcChallengesCompleted).count("") isnot Object.values($hcChallengesCompleted).length>>
											<<set _painting += `<br><span class='blue italic'>Challenges completed:</span><br>`>>
											<<set _painting += `<span style="color: ${ColourUtils.interpolateMultiple(["--red", "--pink", "--purple", "--blue", "--teal", "--green", "--gold"], normalise(Object.values($hcChallengesCompleted).count("S"), Object.values($hcChallengesCompleted).length, 0))}">${Object.values($hcChallengesCompleted).count("S")}/${setup.hopelessCycleChallenges.length}</span>`>>
										<</if>>
										<<set _painting += `</div>`>>
									<</if>>
									<div class="item" @tooltip="_painting">
										<img class="icon" @src="'img/misc/prop/' + _museumPaintingText[_labelP].inlineFull" width="120" height="120">
										<<switch _labelP>>
											<<case "paintingsnake">><<set _percent to (Math.round($hcEndings.length) / 7 * 100)>>
											<<case "paintingward">><<set _percent to $bleedingWardCheckpoint ? 50 : 100>>
											<<default>><<set _percent to 100>>
										<</switch>>
										<div class="paintingProgress" @style="'--progress: ' + _percent + '%;'">
											<<if $options.images>>
												<div class="progress">
													<span class="starBar">
														<img class="active-icon-img" src="img/ui/star-gold.png">
														<img class="inactive-icon-img" src="img/ui/star-empty.png">
													</span>
												</div>
											<<else>>
												<div class="meter">
													<div class="goldbar" @style="'width:' + _percent + '%'"></div>
												</div>
											<</if>>
										</div>
									</div>
								<<case "talk">>
									<<set $_tooltipPainting to `You should ask Winter about the ${_museumPaintingText[_labelP].journalName.toLowerCase()}.`>>
									<div class="item" @tooltip="$_tooltipPainting">
										<img class="icon" @src="'img/misc/prop/' + _museumPaintingText[_labelP].inlineFull" width="120" height="120">
									</div>
								<<case "notFound">>
									<div class="item" tooltip="Unknown Painting.">
										<img class="icon" src="img/misc/prop/curtain.png" width="120" height="120">
									</div>
								<<default>>
									<div class="item" @tooltip="_painting">
										<img class="icon" @src="'img/misc/prop/' + _museumPaintingText[_labelP].inlineRaw" width="120" height="120">
									</div>
							<</switch>>
						<</for>>
					</div>
				<</if>>
			</details>
			<br>
		<</if>>

		<<if $plants_known.length gte 0>>
			<<set _foodstuffKeys to Object.keys(setup.foodstuff)>>
			<<set _collection to 0>>
			<<for _i to 0; _i lt $plants_known.length; _i++>>
				<<if Object.keys(setup.foodstuff).includes($plants_known[_i])>>
					<<set _collection += 1>>
				<</if>>
			<</for>>
			<<set _total to 0>>
			<<for _i to 0; _i lt _foodstuffKeys.length; _i++>>
				<<if setup.foodstuff[_foodstuffKeys[_i]]?.tending?.has_seeds>>
					<<set _total += 1>>
				<</if>>
			<</for>>
			<<if _collection is 0>>
				You can't grow any plants. Explore the world more to discover seeds.
			<<else>>
				You can grow <span class="gold"><<= _collection>></span> <<pluralise _collection "kind of plant" "kinds of plants">>.
				<<if _collection is _total>>
					You've found <span class="green">every</span> seed.
				<<else>>
					<<set _seedsMissing to _total - _collection>>
					You're missing <span class="gold"><<= _seedsMissing>></span> <<pluralise _seedsMissing "seed">>.
				<</if>>
			<</if>>
			<br><br>
			<details class="journal">
				<summary class="journal">Seeds</summary>
				<div class="itemCollectible">
					<<for _i to 0; _i lt _foodstuffKeys.length; _i++>>
						<<set _seedItem to setup.foodstuff[_foodstuffKeys[_i]]>>
						<<set _seedName to _seedItem?.tending?.seed_name>>
						<<set _seedPlural to _seedItem?.plural or "">>
						<<set _tooltip to _seedName ? _seedName.toUpperFirst() : (_seedPlural[0].toUpperCase() + _seedPlural.substring(1))>>
						<<set _icon to _seedItem?.icon>>
						<<if _seedItem?.tending?.has_seeds>>
							<<if $plants_known.includes(_foodstuffKeys[_i])>>
								<div class="item" @tooltip="_tooltip">
									<<icon `"tending/" + _icon`>>
								</div>
							<<else>>
								<div class="item unknown" tooltip="Unknown seed.">
									<<mysteryicon>>
								</div>
							<</if>>
						<</if>>
					<</for>>
				</div>
			</details>
		<</if>>
	<</if>>
	<br>
<</widget>>

<<widget "journalInventory">>
	<<set $_filter to _args[0] || "all">>
	<<for _t to 0; _t lt _foodstuffKeys.length; _t++>>
		<<set _foodstuffKey to _foodstuffKeys[_t]>>
		<<set _foodstuff to setup.foodstuff[_foodstuffKey]>>
		<<set _item to $foodstuff[_foodstuffKey]>>
		<<set _foodstuffType to ((_foodstuff?.category) === "dish" ? "food" : _foodstuff?.category)>>
		<<if _item?.amount gte 1>>
			<<if $_filter is "all" or _foodstuffType is $_filter>>
				<<set _formatter = new Intl.NumberFormat('en-gb', { roundingMode: 'trunc', notation: 'compact' })>>
				<<set _amount = _formatter.format(_item.amount)>>
				<<if _item.amount === 1>>
					<<set _itemName to _foodstuff.singular>>
				<<else>>
					<<set _itemName to _foodstuff.plural>>
				<</if>>
				<<set _tooltip to `<span class="green">${_item.amount}</span> ${_itemName}`>>

				<div class="item" @tooltip="_tooltip">
					<<foodstufficon _foodstuffKey>>
					<hr>
					<<= _amount>>
				</div>
			<</if>>
		<</if>>
	<</for>>
<</widget>>

<<widget "journalNotes">>
	<<if $journalNotes is undefined>>
		<<set $journalNotes to {"default":""}>>
		<<set $options.notesAutoSave to true>>
		<<set _currentPage to "default">>
	<</if>>
	<<if !_currentPage>><<set _currentPage to "default">><</if>>
	<<set _listPageName to _currentPage>>
	<<foldout false "_journalFoldout">>
		<span>Extra</span>
		Page:
		<<listbox "_listPageName" autoselect>>
			<<optionsfrom Object.keys($journalNotes)>>
		<</listbox>>
		<<link "Load">>
			<<journalNotesTextareaSave>>
			<<set _currentPage to _listPageName>>
			<<replace "#journalNotesTextarea">><<journalNotesTextarea>><</replace>>
		<</link>> |
		<<link "Delete">>
			<<if _listPageName is "default">>
				<<set $journalNotes.default to "">>
			<<else>>
				<<run delete $journalNotes[_listPageName]>>
			<</if>>
			<<if !$journalNotes[_currentPage]>><<set _currentPage to "default">><</if>>
			<<replace "#customOverlayContent">><<journalNotes>><</replace>>
		<</link>> |
		<<if $debug is 1>>
			<<link "DEBUG: <<=($options.enableJournalDebugTwee ? 'Disable' : 'Enable')>> Code Execution">>
				<<if $options.enableJournalDebugTwee>>
					<<set delete $options.enableJournalDebugTwee>>
				<<else>>
					<<set $options.enableJournalDebugTwee to true>>
				<</if>>
				<<replace "#customOverlayContent">><<journalNotes>><</replace>>
			<</link>>
			<mouse class="tooltip linkBlue">(?)<span>
				Allows journal notes to run as Twee code.
			</span></mouse> |
		<</if>>
		<br><br>

		New page name: <<textbox "_pageName" "">>
		<<link "New Page">>
			<<journalNotesTextareaSave>>
			<<set _newName to journalNotesReplacer(_pageName).slice(0,20)>>
			<<if $journalNotes[_newName] is undefined>>
				<<set $journalNotes[_newName] to "">>
				<<set _currentPage to _newName>>
				<<replace "#customOverlayContent">><<journalNotes>><</replace>>
			<<else>>
				<<replace "#journalNotesMessage">><span class="red">Unique name required.</span><</replace>>
			<</if>>
		<</link>>
		<mouse class="tooltip linkBlue">(?)<span>
			Page names can only contain A-Z, numbers, underscore, dashes and spaces.
		</span></mouse>
		<div id="journalNotesMessage"></div>
	<</foldout>>
	<br>
	<div id="journalNotesTextarea"><<journalNotesTextarea>></div>
<</widget>>

<<widget "journalNotesTextarea">>
	<<if $options.enableJournalDebugTwee and $debug is 1>>
		<div class="settingsToggleItemWide">
			<<foldout true "_journalDebugTweeFoldout">>
				<span style="font-size:large">output</span>
				<span id='journalDebugTweeOutput'>@@color:red;wiki&lpar;&rpar; executes Twee code from the textarea below.@@<br></span>
			<</foldout>>
			<hr>
			<<button "@@color:red;.wiki&lpar;'_currentPage'&rpar;@@">>
				<<journalNotesTextareaSave>>
				<<replace "#journalDebugTweeOutput">><<script>>$(output).wiki(T.displayedTextArea);<</script>><</replace>>
				<<replace "#journalDebugTweeCopyButton">>
					<<button 'Copy to clipboard'>>
						<<run _txt = $('#journalDebugTweeOutput')[0].innerHTML>>
						<<run navigator.clipboard.writeText(_txt.replaceAll('<br>','\n'))>>
					<</button>>
					<<button [[Reload Passage|$passage]]>><<set $cheatReload to true>><</button>>
				<</replace>>
			<</button>>
			<span id='journalDebugTweeCopyButton'></span>
		</div>
		<br>
	<</if>>
	<<button `'<span class="fa-icon fa-save"></span> Save (' + _currentPage + ')'`>>
		<<journalNotesTextareaSave>>
	<</button>>
	<label><<checkbox "$options.notesAutoSave" false true autocheck>> Auto Save</label>
	<mouse class="tooltip linkBlue">(?)<span>
		<div>Closing the overlay or changing tabs will save your note. Character limit of 3000 per page.</div>
		<div class="red">Reloading your older save files will not have your recent changes. Excessive use will bloat save file size.</div>
	</span></mouse>
	<<textarea "_displayedTextArea" `LZString.decompress($journalNotes[_currentPage])`>>

	<<run $(() => {
		var notesTimer = null;
		$('#textarea--displayedtextarea').on('input change', e => {
			if (notesTimer) clearTimeout(notesTimer);
			if (V.options.notesAutoSave) notesTimer = setTimeout(saveText, 1000);
		});
		$('#textarea--displayedtextarea').attr('maxlength','3000');
		var saveText = () => {
			new Wikifier (null, "<<journalNotesTextareaSave>>");
		}
	})>>
<</widget>>

<<widget "journalNotesTextareaSave">>
	<<set _noteElement to jQuery('#textarea--displayedtextarea')[0]>>
	<<if _noteElement and _noteElement.value>>
		<<set $journalNotes[_currentPage] to LZString.compress(_noteElement.value)>>
		/* put notes into save data immediately without the need to change passage */
		<<run State.history[State.activeIndex].variables.journalNotes = clone(V.journalNotes)>>
	<</if>>
<</widget>>

<<widget "nDays">><<silently>>
	<<switch _args[0]>>
		<<case 0>><<set $_text_output to '<span class="gold">today</span>'>>
		<<case 1>><<set $_text_output to '<span class="gold">tomorrow</span>'>>
		<<default>><<set $_text_output to 'in <span class="gold"><<= _args[0]>></span> days'>>
	<</switch>>
<</silently>><<print $_text_output>><</widget>>
