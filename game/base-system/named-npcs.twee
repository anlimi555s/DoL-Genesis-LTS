<<widget "initnpcskin">>
	<<for _i to 0; _i lt $NPCName.length; _i++>>
		<<initnpcskinsingle _i _args[0]>>
	<</for>>
<</widget>>

<<widget "initnpcskinsingle">>
	<<set _i to _args[0]>>
	<<if !$NPCName[_i].skincolour or $NPCName[_i].skincolour is "none" or _args[1] is "skincolour">>
		<<if random(0, 99) lte $settings.darkSkinChance>>
			<<set $NPCName[_i].skincolour to "black">>
		<<else>>
			<<set $NPCName[_i].skincolour to "white">>
		<</if>>
	<</if>>
<</widget>>

<<widget "initnpcgender">>
	<<for _i to 0; _i lt $NPCName.length; _i++>>
		<<initnpcgendersingle _i _args[0]>>
	<</for>>
<</widget>>

<<widget "initnpcgendersingle">>
	<<set _i to _args[0]>>

	<!-- Set Pronoun -->
	<<if !$NPCName[_i].pronoun or $NPCName[_i].pronoun is "none" or _args[1] is "genders">>
		<<if $passage is "Start">>
			<<if $player.sex is "m">>
				<<set _override to "m">>
			<<elseif $player.sex is "h">>
				<<if $player.gender_body is "m" or ($player.gender_body is "a" and $player.breastsize lte 3)>>
					<<set _override to "m">>
				<<else>> <!-- if $player.gender_body is "f" or ($player.gender_body is "a" and $player.breastsize gt 3)) -->
					<<set _override to "f">>
				<</if>>
			<<else>> <!-- if $player.sex is "f" -->
				<<set _override to "f">>
			<</if>>
			<<if $background is "crossdresser">>
				<<set _override to (_override is "m" ? "f" : "m")>>
			<</if>>
		<</if>>
		<<if ($NPCName[_i].type is "human" and maleChance(_override) lt random(1, 100)) or ($NPCName[_i].type isnot "human" and beastMaleChance(_override) lt random(1, 100))>>
			<<set $NPCName[_i].pronoun to "f">>
		<<else>>
			<<set $NPCName[_i].pronoun to "m">>
		<</if>>
	<</if>>
	<!-- Set Gender -->
	<<if $NPCName[_i].pregnancy?.type>>
		<<set $NPCName[_i].gender to "f">>
	<<elseif !$NPCName[_i].gender or $NPCName[_i].gender is "none" or _args[1] is "genders">>
		<<if $NPCName[_i].pronoun is "m">>
			<<if random(0, 99) gte $settings.maleNPCVaginaChance>>
				<<set $NPCName[_i].gender to "m">>
			<<else>>
				<<set $NPCName[_i].gender to "f">>
			<</if>>
		<<elseif $NPCName[_i].pronoun is "f">>
			<<if random(0, 99) gte $settings.femaleNPCPenisChance>>
				<<set $NPCName[_i].gender to "f">>
			<<else>>
				<<set $NPCName[_i].gender to "m">>
			<</if>>
		<</if>>
	<</if>>
	<<if $NPCName[_i].nam is "Ivory Wraith">>
		<<set $NPCName[_i].pronoun to "i">>
	<</if>>

	<!-- Set Genital Existence -->
	<<if $NPCName[_i].type isnot "human">>
		<<set $NPCName[_i].penis to ($NPCName[_i].gender !== "f" ? 0 : "none")>>
		<<set $NPCName[_i].vagina to ($NPCName[_i].gender !== "m" ? 0 : "none")>>
	<<else>>
		<<set $NPCName[_i].penis to ($NPCName[_i].gender !== "f" ? "clothed" : "none")>>
		<<set $NPCName[_i].vagina to ($NPCName[_i].gender !== "m" ? "clothed" : "none")>>
	<</if>>

	<!-- Set breast defaults-->

	<<set _b_mod_lower to Math.clamp($settings.breastModifier, 0, 12)>>
	<<set _b_mod_upper to Math.clamp($settings.breastModifier + 12, 0, 12)>>

	<!-- can't use breastsize, since that would either break the numberslider
	or make one of the sizes always be randomised,
	but can use breastdesc not being changed from 0 as a substitute -->
	<<if $NPCName[_i].breastdesc is 0 or _args[1] is "breasts">>
		<<if $NPCName[_i].pronoun is "m">>
			<<set $NPCName[_i].breastsize to 0>>
		<<else>>
			<<set $NPCName[_i].breastsize to random(_b_mod_lower, _b_mod_upper)>>
		<</if>>
	<</if>>
	<<if $NPCName[_i].breastsize gt 0>>
		<<set _brdes to ["nipple","budding","tiny","small","pert","modest","full","large","ample","massive","huge","gigantic","enormous"]>>
		<<set $NPCName[_i].breastdesc to _brdes[$NPCName[_i].breastsize]+" breast">>
	<<else>>
		<<set $NPCName[_i].breastdesc to "nipple">>
	<</if>>
	<<set $NPCName[_i].breastsdesc to $NPCName[_i].breastdesc + "s">>

	<!-- Set pp to defaults-->

	/* New way to set upper and lower bounds.
	* This method makes use of all other slider positions, but does nothing when slider is between -1 and 1,
	* for a total of 15 unique positions vs the current method's 9. (max would be 17)
	* Changing the penis_mod slider to range from -7 to 7 would work to make every slider position unique here, but potentially affects unnamed npc generation.
	*/

	/*
	<<set _p_mod_upper to 8>><<set _p_mod_lower to 1>>
	<<if $settings.penisModifier gt 0>>
		<<set _p_mod_lower += $settings.penisModifier - 1>>
	<<elseif $settings.penisModifier lt 0>>
		<<set _p_mod_upper += $settings.penisModifier + 1>>
	<</if>>

	alternative way to write that:
	<<set _p_mod_lower to ($settings.penisModifier > 0 ? $settings.penisModifier : 1)>>
	<<set _p_mod_upper to ($settings.penisModifier < 0 ? 9 + $settings.penisModifier : 8)>>
	*/

	<<if $settings.penisModifier is 8>>/*Clumsy way to get average penis size setting working for NNPCs.*/
		<<set _p_mod_upper to 8>><<set _p_mod_lower to 8>>
	<<elseif $settings.penisModifier gte 6>>
		<<set _p_mod_upper to 8>><<set _p_mod_lower to 7>>
	<<elseif $settings.penisModifier gte 4>>
		<<set _p_mod_upper to 8>><<set _p_mod_lower to 5>>
	<<elseif $settings.penisModifier gte 2>>
		<<set _p_mod_upper to 8>><<set _p_mod_lower to 3>>
	<<elseif $settings.penisModifier gte 0>>
		<<set _p_mod_upper to 8>><<set _p_mod_lower to 1>>
	<<elseif $settings.penisModifier gte -2>>
		<<set _p_mod_upper to 7>><<set _p_mod_lower to 1>>
	<<elseif $settings.penisModifier gte -4>>
		<<set _p_mod_upper to 5>><<set _p_mod_lower to 1>>
	<<elseif $settings.penisModifier gte -6>>
		<<set _p_mod_upper to 3>><<set _p_mod_lower to 1>>
	<<else>>
		<<set _p_mod_upper to 1>><<set _p_mod_lower to 1>>
	<</if>>

	<<if $NPCName[_i].penissize is 0 or _args[1] is "penis">>
		<<if $NPCName[_i].gender is "f">>
			<<set $NPCName[_i].penissize to 0>>
			<<set $NPCName[_i].penisdesc to "none">>
		<<else>>
			<<switch random(_p_mod_lower, _p_mod_upper)>>
			<<case 8>>
				<<set $NPCName[_i].penisdesc to either("massive cock","huge cock","humongous cock","immense cock","gigantic cock","enormous cock")>>
				<<set $NPCName[_i].penissize to 4>>
			<<case 5 6 7>>
				<<set $NPCName[_i].penisdesc to either("thick cock","hefty cock","big cock","large cock","veiny cock","meaty cock")>>
				<<set $NPCName[_i].penissize to 3>>
			<<case 2 3 4>>
				<<set $NPCName[_i].penisdesc to "penis">>
				<<set $NPCName[_i].penissize to 2>>
			<<default>>
				<<set $NPCName[_i].penisdesc to either("tiny penis","pathetic cock","little penis","small penis","mini penis","micro penis")>>
				<<set $NPCName[_i].penissize to 1>>
			<</switch>>
		<</if>>
	<</if>>
	<!-- Set pp to size in case PC selected it-->
	<<if $NPCName[_i].penissize isnot 0>>
		<<switch $NPCName[_i].penissize>>
		<<case 4>>
			<<set $NPCName[_i].penisdesc to either("massive cock","huge cock","humongous cock","immense cock","gigantic cock","enormous cock")>>
		<<case 3>>
			<<set $NPCName[_i].penisdesc to either("thick cock","hefty cock","big cock","large cock","veiny cock","meaty cock")>>
		<<case 1>>
			<<set $NPCName[_i].penisdesc to either("tiny penis","pathetic cock","little penis","small penis","mini penis","micro penis")>>
		<<default>>
			<<set $NPCName[_i].penisdesc to "penis">>
		<</switch>>
	<</if>>

	<<switch $NPCName[_i].nam>>
		<<case "Jordan">> <<set $NPCName[_i].title to ($NPCName[_i].pronoun is "m" ? "priest" : "priestess")>>
		<<case "Leighton">> <<set $NPCName[_i].title to ($NPCName[_i].pronoun is "m" ? "headmaster" : "headmistress")>>
		<<case "Eden">> <<set $NPCName[_i].title to ($NPCName[_i].pronoun is "m" ? "hunter" : "huntress")>>
		<<case "Avery">> <<if $avery_fate isnot "ascended">><<set $NPCName[_i].title to ($NPCName[_i].pronoun is "m" ? "businessman" : "businesswoman")>><</if>>
	<</switch>>

	<<generatePronouns $NPCName[_i]>>
<</widget>>

<<widget "initnpc">>
	<<set _nam to _args[0]>>
	<<set _i to $NPCNameList.indexOf(_nam)>>
	<<if $NPCName[_i].init is 0>> <!-- This prevents double-init from wiping variables -->
		<<set $NPCName[_i].init to 1>>

		<<set $NPCName[_i].trust to 0>>
		<<set $NPCName[_i].love to 0>>
		<<set $NPCName[_i].dom to 0>>
		<<set $NPCName[_i].lust to 0>>
		<<set $NPCName[_i].trauma to 0>>
		<<set $NPCName[_i].rage to 0>>
		<<set $NPCName[_i].state to "active">>
		<<set $NPCName[_i].purity to 0>>
		<<set $NPCName[_i].corruption to 0>>
		<<set $NPCName[_i].chastity to {penis:"", vagina:"", anus:""}>>
		<<set $NPCName[_i].name_known to 1>>
		<<if !$NPCName[_i].skincolour>>
			<<if random(1, 100) lte $settings.darkSkinChance>>
				<<set $NPCName[_i].skincolour to "black">>
			<<else>>
				<<set $NPCName[_i].skincolour to "white">>
			<</if>>
		<</if>>
		<<generatePronouns $NPCName[_i]>>
		<<initNNPCClothes _nam>>
		<<initNNPCstrapon $NPCName[_i]>>

		/* initnpc doesn't modify $NPCList or do anything <<personselect>> does, but we still want to use pronoun-based widgets for intro text */
		<<set _lastPronoun to $pronoun>>
		<<set $pronoun to $NPCName[_i].pronoun>>

		<!-- Special Cases NNPC Variables, Introductions, Adjustments -->
		<<switch _nam>>
			<<case Kylar>>
				<<set C.npc.Kylar.state to 0>>
			<<case Robin>>
				<<set $robinSeen to []>>
				<<set $NPCName[_i].cdquest to 0>>
			<<case River>>
				//River teaches maths and housekeeping at the local school. <<His>> <<if $pronoun is "m">>short<<else>>long<</if>> brown hair is flecked with grey and <<his>> piercing blue eyes scrutinise <<his>> surroundings. Students tend to be well-behaved in <<his>> class.//<br><br>
			<<case Leighton>>
				<<set $NPCName[_i].title to $pronoun is "m" ? "headmaster" : "headmistress">>
				//Leighton is the head<<master>> of the local school. <<He>> has green eyes and <<if $pronoun is "m">>well-kept greying black hair<<else>>greying black hair, held behind her head in a bun<</if>>. Tall and stately, <<he>> has a firm attitude towards the students at <<his>> school.//<br><br>
			<<case Mason>>
				//Mason is the swimming teacher at the local school. <<Hes>> the youngest teacher, only a few years older than some of the students. <<His>> toned body is naturally shown off during class, but if <<he>> notices the way <<hes>> leered at, <<he>> gives no indication.//
				<<set $NPCName[_i].chastityKeyCarried to 0>> /* Mason is carrying the key to unlock Winter's Chastity belt. 1 is carried, 2 player knows it is carried */
				<<set $NPCName[_i].chastityRemoved to 0>> /* Number of chastity devices Mason has removed */
				<<set $NPCName[_i].chastityRemovalDeclined to 0>> /* Whether you've declined Mason's offer to remove it (prompts more passive checking). Resets when a device is removed */
			<<case Winter>>
				//Winter teaches history at the local school. <<Hes>> an older <<gentleman_npc>>, well-groomed and sophisticated.//<br><br>
			<<case Doren>>
				//Doren teaches English at the local school. <<His>> shaggy red hair<<if $pronoun is "m">> and beard<</if>> gives <<him>> a savage look.//<br><br>
				<<set $dorenSeen to []>>
			<<case Sirris>>
				//Sirris teaches science at the local school. <<Hes>> calm and patient, which sometimes leads to a disordered classroom.//<br><br>
			<<case Eden>>
				<<set $NPCName[_i].title to $pronoun is "m" ? "hunter" : "huntress">>
				<<set $NPCName[_i].name_known to 0>>
				<<set $edenSeen to []>>
			<<case Avery>>
				<<set $NPCName[_i].title to $pronoun is "m" ? "businessman" : "businesswoman">>
				<<if $averySeen is undefined>>
					<<set $averySeen to []>>
				<</if>>
				<<if $averyRejected is undefined>>
					<<set $averyRejected to {}>>
					<<set $weekly.averyRejected to {}>>
				<</if>>
			<<case Jordan>>
				<<set $NPCName[_i].title to $pronoun is "m" ? "priest" : "priestess">>
			<<case Whitney>>
				<<set C.npc.Whitney.dom to 10>>
				<<set $whitneySeen to []>>
			<<case "Great Hawk">>
				<<set C.npc["Great Hawk"].dom to 50>>
			<<case Sydney>>
				<<set $NPCName[_i].purity to 100>>
				<<set $NPCName[_i].chastity to {penis:"chastity belt", vagina:"chastity belt", anus:"anal shield"}>>
				<<set $sydneySeen to []>>
				<<set $sydneyFirstSeen to "">>
				<<set $sydney to {
					glasses: "glasses",
					hair: "ponytail",
					swim: "school",
					sexTotal: 0,
					rank: "initiate",
				}>>
			<<case Alex>>
				<<set $alexSeen to []>>
			<<case "Ivory Wraith">>
				<<checkWraith>>
				<<set $genderknown.pushUnique("Ivory Wraith")>>
				<<set C.npc["Ivory Wraith"].lust to 0>>
				<<if $wraith.state is "haunt">>
					<<set C.npc["Ivory Wraith"].lust to 20>>
					<<if $wraithPrison and $wraithPrison.vision>>
						<<set C.npc["Ivory Wraith"].lust -= 5>>
					<</if>>
				<</if>>
				<<set C.npc["Ivory Wraith"].skincolour to "ghost">>
			<<case Remy>>
				<<if $remySeen is undefined>>
					<<set $remySeen to []>>
				<</if>>
			<<case Harper>>
				<<if $harperSeen is undefined>>
					<<set $harperSeen to []>>
				<</if>>
			<<case Wren>>
				<<if $wrenSeen is undefined>>
					<<set $wrenSeen to []>>
				<</if>>
			<<case Niki>>
				<<if $nikiSeen is undefined>>
					<<set $nikiSeen to []>>
				<</if>>
			<<case Gwylan>>
				<<set $gwylanSeen to []>>
				<<set $gwylanTalked to []>>
				<<set $gwylan to {
					progress: 0,
					stage: 0,
					sea: 0,
					wary: 0,
					robin: 0,
					purged: 0,
					timer: {},
					request: {},
					requestCount: 0,
					requestDone: false,
				}>>
				<<set $gwylan.timer.lastSeen to Time.date.timeStamp>>
			<<case Sam>>
				<<if $samSeen is undefined>>
					<<set $samSeen to []>>
				<</if>>
			<<default>>
		<</switch>>

		/* Restore $pronoun to its original state, to avoid side effects */
		<<set $pronoun to _lastPronoun>>
	<</if>>
<</widget>>

<<widget "initNNPCClothes">>
	<<set _nam to _args[0]>>
	<<set _i to $NPCNameList.indexOf(_nam)>>
	<<set $_generation to (_args[1] ? _args[1] : "none")>>
	<<if !$NPCName[_i].outfits or $_generation is "reset" or $_generation is "update">>
		<<if $_generation isnot "update">>
			<<set $NPCName[_i].outfits to ["naked", "maleDefault", "femaleDefault"]>>
		<</if>>
		<<switch _nam>>
			<<case Kylar>>
				<<set $NPCName[_i].outfits.pushUnique(
					"maleSchool", "femaleSchool",
					"maleSchoolSwim", "femaleSchoolSwim",
					"maleTown1", "femaleTown1", "maleWarm1", "femaleWarm1", "coldHoodie"
				)>>
			<<case Robin>>
				<<set $NPCName[_i].outfits.pushUnique(
					"maleSchool", "femaleSchool", "maleSchoolLong", "femaleSchoolLong",
					"maleSchoolSwimShirt", "femaleSchoolSwim",
					"maleTown1", "femaleTown1", "maleWarm1", "femaleWarm1", "coldPuffer", "pyjamas"
				)>>
			<<case Whitney>>
				<<set $NPCName[_i].outfits.pushUnique(
					"Whitney", "maleSchoolBlazer", "femaleSchoolBlazer",
					"maleSchoolSwim", "femaleSchoolSwim", "coldHoodie"
				)>>
			<<case Sydney>>
				<<set $NPCName[_i].outfits.pushUnique(
					"maleSchoolLong", "femaleSchoolLong",
					"maleSchoolSwimShirt", "femaleSchoolSwim",
					"neutralRobe", "coldTrench"
				)>>
			<<case Gwylan>>
				<<set $NPCName[_i].outfits.pushUnique(
					"gwylanTown", "gwylanCold", "maleWarm2", "femaleWarmTank",
					"witch", "gloomyTunic", "ritualRobes", "vintageMale", "vintageFemale"
				)>>
			<<case Alex>><<set $NPCName[_i].outfits.pushUnique("wildsFlannel", "AlexJorts", "AlexSkirt", "coldCoat")>>
			<<case Avery>><<set $NPCName[_i].outfits.pushUnique("business", "maleFormal1", "femaleFormal1", "pyjamas")>>
			<<case Eden>><<set $NPCName[_i].outfits.pushUnique("Eden")>>
			<<case Morgan>><<set $NPCName[_i].outfits.pushUnique("Morgan")>>
			<<case Briar>><<set $NPCName[_i].outfits.pushUnique("maleBriar", "femaleBriar")>>
			<<case Darryl>><<set $NPCName[_i].outfits.pushUnique("maleFormal1", "femaleFormal1")>>
			<<case Remy>><<set $NPCName[_i].outfits.pushUnique("ridingFormal")>>
			<<case Landry>><<set $NPCName[_i].outfits.pushUnique("maleLandry", "femaleLandry")>>
			<<case Charlie>><<set $NPCName[_i].outfits.pushUnique("dance")>>
			<<case Harper>><<set $NPCName[_i].outfits.pushUnique("doctor")>>
			<<case Jordan>><<set $NPCName[_i].outfits.pushUnique("maleRobe", "femaleRobe")>>
			<<case Sirris>><<set $NPCName[_i].outfits.pushUnique("teacher", "townTurtleneck", "townCollar")>>
			<<case Doren>><<set $NPCName[_i].outfits.pushUnique("teacher", "townTrack", "townCollar")>>
			<<case River>><<set $NPCName[_i].outfits.pushUnique("teacher", "neutralRobe", "townCollar")>>
			<<case Winter>><<set $NPCName[_i].outfits.pushUnique("teacher")>>
			<<case Mason>><<set $NPCName[_i].outfits.pushUnique("teacher", "maleSchoolSwim", "neutralSwim", "townTrack")>>
			<<case Leighton>><<set $NPCName[_i].outfits.pushUnique("teacher", "maleFormal1", "femaleFormal1")>>
			<<case "Black Wolf" "Great Hawk" "Night Monster">><<set $NPCName[_i].outfits to ["naked"]>>
			<<case "Ivory Wraith">><<set $NPCName[_i].outfits to ["naked", "moonRobe"]>>
			<<default>>
				<!-- Maybe should be left as a default case for futureproofing?
				Assigns area-appropriate clothes without saving them to the NPC.
				If this does not run, named NPC will only have default and naked clothes.
				<<set $NPCName[_i].outfits to undefined>> -->
		<</switch>>
	<</if>>
	<<getNNPCClothes _nam>>
<</widget>>

<<widget "getNNPCClothes">>
	<<set _nam to _args[0]>>
	<<set _i to $NPCNameList.indexOf(_nam)>>
	<<if !$NPCName[_i].outfits>>
		<<generateNPCClothes $NPCName[_i]>>
		<<run console.log('Named NPC [', $NPCName[_i], '] generated with area-appropriate clothes due to a lack of outfits.')>>
	<<else>>
		<<switch _nam>>
			<<case Alex>>
				<<if $location is "alex_cottage" and Time.betweenHours(21, 5)>>
					<<if $NPCName[_i].pronoun is "m">>
						<<npcClothesName $NPCName[_i] "maleAlexSleep">>
					<<else>>
						<<npcClothesName $NPCName[_i] "femaleAlexSleep">>
					<</if>>
				<<else>>
					<<generateNPCClothes $NPCName[_i]>>
				<</if>>
			<<case Avery>>
				<<if Time.hour gte 18>>
					<<npcClothesType $NPCName[_i] "formal">>
				<<else>>
					<<npcClothesType $NPCName[_i] "business">>
				<</if>>
			<<case Robin>>
				<<run getRobinCrossdressingStatus($NPCName[_i].crossdress)>>
				<<set $NPCName[_i].crossdressing to _robin_cd>>
				<<run statusCheck("Robin")>>
				<<switch _robin_location>>
					<<case "sleep">>
						<<npcClothesType $NPCName[_i] "sleep">>
					<<case "school">>
						<<npcClothesType $NPCName[_i] "school">>
					<<case "park">>
						<<npcClothesType $NPCName[_i] "cold">>
					<<case "halloween">>
						<<if $halloween_robin_costume>>
							<<npcClothesName $NPCName[_i] $halloween_robin_costume>>
						<<else>>
							<<generateNPCClothes $NPCName[_i]>>
						<</if>>
					<<default>>
						<<generateNPCClothes $NPCName[_i]>>
				<</switch>>
			<<case Sydney>>
				<<sydneySchedule>>
				<<switch _sydney_location>>
					<<case "temple">>
						<<npcClothesType $NPCName[_i] "temple">>
					<<case "school" "class" "lunch" "library">>
						<<npcClothesType $NPCName[_i] "school">>
					<<default>>
						<<generateNPCClothes $NPCName[_i]>>
				<</switch>>
			<<case Kylar>>
				<<if $kylar_clothes is "formal">>
					<<npcClothesType $NPCName[_i] "formal">>
				<<elseif $kylar_clothes is "goth">>
					<<npcClothesType $NPCName[_i] "formalRare">>
				<<elseif $kylar_clothes is "swimsuit">>
					<<npcClothesType $NPCName[_i] "beach">>
				<<else>>
					<<generateNPCClothes $NPCName[_i]>>
				<</if>>
			<<case Gwylan>>
				<<if gwylanSchedule() is "shop">>
					<<if $location is "forest_shop_garden" and ($beastRitual or $sexRitual)>>
						<<npcClothesName $NPCName[_i] "ritualRobes">>
					<<else>>
						<<npcClothesName $NPCName[_i] "gloomyTunic">>
					<</if>>
				<<else>>
					<<if Time.season is "winter">>
						<<npcClothesType $NPCName[_i] "cold">>
					<<else>>
						<<generateNPCClothes $NPCName[_i]>>
					<</if>>
				<</if>>
			<<case Eden Morgan Briar Landry Remy>>
				<<npcClothesType $NPCName[_i] _nam>>
			<<case Darryl>>
				<<npcClothesType $NPCName[_i] "formal">>
			<<case Charlie>>
				<<npcClothesType $NPCName[_i] "dance_studio">>
			<<case Harper>>
				<<npcClothesType $NPCName[_i] "hospital">>
			<<case Jordan>>
				<<npcClothesType $NPCName[_i] "temple">>
			<<case Mason>>
				<<npcClothesType $NPCName[_i] "beach">>
			<<case "Black Wolf" "Great Hawk" "Night Monster">>
				<<npcClothesType $NPCName[_i] "naked">>
			<<case "Ivory Wraith">>
				<<npcClothesType $NPCName[_i] "Wraith">>
			<<default>>
				<<generateNPCClothes $NPCName[_i]>>
		<</switch>>
	<</if>>
	<<if $NPCName[_i].penis isnot "none">>
		<<set $NPCName[_i].penis to ($NPCName[_i].clothes.lower.name is "naked" ? 0 : "clothed")>>
	<</if>>
	<<if $NPCName[_i].vagina isnot "none">>
		<<set $NPCName[_i].vagina to ($NPCName[_i].clothes.lower.name is "naked" ? 0 : "clothed")>>
	<</if>>
	<<set $NPCName[_i].chest to ($NPCName[_i].clothes.upper.name is "naked" ? 0 : "clothed")>>
<</widget>>

<!-- addNNPCOutfit and removeNNPCOutfit should only ever be used on named NPCs! -->
<<widget "addNNPCOutfit">>
	<<set _nam to _args[0]>>
	<<set _i to $NPCNameList.indexOf(_nam)>>
	<<set $_newNPCOutfit to _args[1]>>
	<<if _args[0] and _args[1]>>
		<<if !setup.npcClothesSets.some(set => set.name.includes($_newNPCOutfit))>>
			<<error {
				message	: `NPC (${_nam}) was given invalid outfit (Outfit name: ${$_newNPCOutfit}). Please inform PurityGuy.`,
				source	: Utils.GetStack()
			}>>
		<<elseif _i lt 0>>
			<<error {
				message	: `NPC (${_nam}) ${"is"} invalid (Must be a named NPC. check for typos!). Please inform PurityGuy.`,
				source	: Utils.GetStack()
			}>>
		<<else>>
			<<if !$NPCName[_i].outfits>>
				<<set $NPCName[_i].outfits to ["naked", "maleDefault", "femaleDefault"]>>
			<</if>>
			<<set $NPCName[_i].outfits.pushUnique($_newNPCOutfit)>>
		<</if>>
	<</if>>
<</widget>>

<<widget "removeNNPCOutfit">>
	<<set _nam to _args[0]>>
	<<set _i to $NPCNameList.indexOf(_nam)>>
	<<set $_newNPCOutfit to _args[1]>>
	<<if _args[0] and _args[1]>>
		<<if _i lt 0>>
			<<error {
				message	: `NPC (${_nam}) ${"is"} invalid (Must be a named NPC. Check for typos!). Please inform PurityGuy.`,
				source	: Utils.GetStack()
			}>>
		<<elseif !$NPCName[_i].outfits>>
			<<error {
				message	: `NPC (${_nam}) attempted to remove outfit (Outfit name: ${$_newNPCOutfit}) while having no outfits. Please inform PurityGuy.`,
				source	: Utils.GetStack()
			}>>
		<<elseif !$NPCName[_i].outfits.some(x => x.includes($_newNPCOutfit))>>
			<<error {
				message	: `NPC (${_nam}) had non-existent outfit removed (Outfit name: ${$_newNPCOutfit}). Please inform PurityGuy.`,
				source	: Utils.GetStack()
			}>>
		<<else>>
			<<set $NPCName[_i].outfits.delete($_newNPCOutfit)>>
			<<if $NPCName[_i].outfits.length is 0>>
				<<set $NPCName[_i].outfits to undefined>>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

<!-- generates the strapon that the NNPC will use if the scene or rng calls for it. doesn't guarantee they will have it 100% of the time. -->
<<widget "initNNPCstrapon">>
	<<set $_npcName to _args[0]>>
	<<set $_name to $_npcName.nam>>
	<<switch $_name>>
		<<case "Whitney">>
			<<set $_npcName.strapons to [{"state": "worn", "color": "dark red", "size": 3, "description":"large dark red strap-on cock"}]>>
		<<default>>
			<<set $_npcName.strapons to []>>
	<</switch>>
<</widget>>

<!-- give an NNPC a *new* strapon -->
<!-- <<giveNNPCnewstrapon _npcNameSelect _straponSize _straponColour _straponShape _modifierOptions>> -->
<<widget "giveNNPCnewstrapon">>
	<<set $_name to _args[0]>>
	<<set $_npcName to $NPCName.find(npc => npc.nam === $_name)>>
	<<set $_index to $NPCName.findIndex(npc => npc.nam === $_name)>>
	<<if _newStrapon is undefined>>
		<<run throw new Error("giveNNPCnewstrapon was run when _newStrapon was undefined! Call generateNewStrapon first!")>>
	<<else>>
		<<set $_strapon to clone(_newStrapon)>>
		<!-- unset _newStrapon so that we can't accidentally dupe strapons. That's right, we're forcing you to generate multiple if you want identical ones. -->
		<<unset _newStrapon>>
	<</if>>

	<!-- if the nnpc's name is in the following list, they will refuse to accept a new strapon -->
	<<if !["Whitney"].includes($_name)>>
		<<if $_npcName.strapons is undefined or $_npcName.strapons.length is 0>>
			<<set $NPCName[$_index].strapons to [$_strapon]>>
		<<else>>
			<<set $NPCName[$_index].strapons.push($_strapon)>>
		<</if>>
	<</if>>
<</widget>>

<<widget "npc">>
	/* Prepare the call for multiple Named NPCs at the same time.
	* We do this by changing all $NPCList[0] calls to $NPCList[x] in which x can be any temporary variable. In this case, we'll use _npcno.
	* We also give the option to set the Named NPC in any available row if so desired, by calling a second argument _args[1]. In case no _args[1] is passed, it will default to the first row.
	* We also now have the option to have the Named NPC be set into the first available slot instead, by setting the second argument _args[1] to a negative number, such as -1. However this will bypass the check for npcs that have broken free from a previous passage.
	* Remember: available rows go from 0 to 5 ($NPCList[0] to $NPCList[5]). No more than that.
	*/
	<<if _args[1] lt 0>>
		<<for _controller to 0; _controller lte $NPCList.length; _controller++>>
			<<if _controller gte 6>>
				<!-- Since 6 is past our limit, we want to alert the user something went wrong. For simplicity, we'll set _npcno to 0 and overwrite $NPCList[0] -->
				<span class="red"> Error: There are already 6 active NPCs. Clearing NPC 0 to make space for Named NPC.</span>
				<<set _npcno to 0>>
				<<clearsinglenpc 0>>
				<<set _overwrite to true>>
				<<break>> <!-- Always remember to break the for loop when the condition is met -->
			<</if>>
			<<if $NPCList[_controller].gender is undefined and $NPCList[_controller].description is undefined>>
				<!-- These comparisons could be changed to a proper variable, for example $NPCList[x].active which would store if NPC x is active or not. To make things simple, we compare to .gender and .description since those two are always set to something other than 0 if the NPC in question is in fact active -->
				<<set _npcno to clone(_controller)>>
				<<break>> <!-- Always remember to break the for loop when the condition is met -->
			<</if>>
		<</for>>
	<<elseif _args[1]>>
		<<set _npcno to _args[1] - 1>>
	<<else>>
		<<set _npcno to 0>>
	<</if>>
	<<if _npcno is 0 and $enemyno gte 1 and !_overwrite>>
		<<set $endeventerror to $lastgenerated>>
		<<endevent phaseless>>
	<</if>>

	<<set $lastgenerated to $passage>>

	<<set _nam to _args[0]>>
	<<set _i to $NPCNameList.indexOf(_nam)>>

	<!-- Initialise NPC on first time called, introducing them to PC -->
	<<if $NPCName[_i].init isnot 1>>
		<<initnpc _nam>>
	<</if>>

	<!-- Determine what outfit the NPC should be wearing -->
	<<if !$NPCName[_i].outfits>>
		<<initNNPCClothes _nam>>
	<<else>>
		<<getNNPCClothes _nam>>
	<</if>>

	<<if !$NPCName[_i].strapons>>
		<<initNNPCstrapon $NPCName[_i]>>
	<</if>>
	<<set $NPCList[_npcno].virginity to $NPCName[_i].virginity>>

	<!-- Set global variables -->
	/* Both $npc and $npcnum will keep defined NPCs in the order they were defined.
	* DO NOT COMPARE NEITHER $npc NOR $npcnum TO $NPCList.
	* Since when defining an NPC one can choose in which row of $NPCList to put it, comparing them could result in mismatches.
	*/
	<<set $npc.push(_nam)>>
	<<set $npcnum.push(_i)>>
	<<set $NPCList[_npcno].fullDescription to _nam>>
	<!-- Set a variable to be compared to $NPCList, for simplicity. The row indicates which NPC it is, value is where in $NPCList it was defined. -->
	<<set $npcrow.push(_npcno)>>

	<<if $npc.length gt 1>>
		<<set $pronoun to "t">> <!-- In case more than 1 Named NPC is defined, we set pronoun to "they". -->
	<<else>>
		<<set $pronoun to $NPCName[_i].pronoun>>
	<</if>>
	/*Sets up multiple orgasms, code needs work*/
	/*<<set $NPCList[0].maxOrgasms to 1>>
	<<set $NPCList[0].orgasms to 0>>
	<<if $NPCList[0].fullDescription is "Robin">>
		<<set $NPCList[0].maxOrgasms to 2>>
		<<set $setupMidOrgasm to true>>
	<</if>>
	*/

	<!-- Set combat variables -->



	<<set $NPCList[_npcno].pronoun to $NPCName[_i].pronoun>>
	<<set $NPCList[_npcno].pronouns to clone($NPCName[_i].pronouns)>>
	<<set $NPCList[_npcno].gender to $NPCName[_i].gender>>
	<<set $NPCList[_npcno].type to $NPCName[_i].type>>

	<<set $NPCList[_npcno].lefthand to 0>>
	<<set $NPCList[_npcno].righthand to 0>>
	<<set $NPCList[_npcno].mouth to 0>>
	<<set $NPCList[_npcno].anus to 0>>/* is not actually used anywhere */
	<<set $NPCList[_npcno].chest to 0>>

	<<set $NPCList[_npcno].traits to []>>

	<<switch _nam>>
	<<case "Eden" "Black Wolf" "Great Hawk">>
		<<set $NPCList[_npcno].health to 600>>
		<<set $NPCList[_npcno].healthmax to 600>>
	<<case "Bailey">>
		<<set $NPCList[_npcno].health to 400>>
		<<set $NPCList[_npcno].healthmax to 400>>
		<<set $NPCList[_npcno].traits.push("unforgiving")>>
	<<case "Avery">>
		<<if $auriga_artefact is "Avery">>
			<<set $NPCList[_npcno].health to 600>>
			<<set $NPCList[_npcno].healthmax to 600>>
		<<else>>
			<<set $NPCList[_npcno].health to 200>>
			<<set $NPCList[_npcno].healthmax to 200>>
		<</if>>
		<<if $avery_fate isnot "saved">>
			<<set $NPCList[_npcno].traits.push("unforgiving")>>
		<</if>>
	<<case "Harper">>
		<<set $NPCList[_npcno].health to 200>>
		<<set $NPCList[_npcno].healthmax to 200>>
		<<set $NPCList[_npcno].traits.push("hypnotist")>>
	<<case "Ivory Wraith">>
		<<statsWraith>>
		<<set $NPCList[_npcno].health to _wraithHP>>
		<<set $NPCList[_npcno].healthmax to _wraithHP>>
		<<set $NPCList[_npcno].traits to ["brooding", "watchful", "willful", "beautiful"]>>
		<<set _condomIgnore to true>>
	<<case "Alex">>
		<<set $NPCList[_npcno].health to 200>>
		<<set $NPCList[_npcno].healthmax to 200>>
		/* Alex never thinks to bring a condom. */
		<<set _condomIgnore to true>>
	<<case "Morgan">>
		<<set $NPCList[_npcno].health to 200>>
		<<set $NPCList[_npcno].healthmax to 200>>
		/* I'm so sorry.*/
		<<set $NPCName[_npcno].pregnancyAvoidance to random(0,100)>>
	<<case "Gwylan">>
		<<set $NPCList[_npcno].health to 200>>
		<<set $NPCList[_npcno].healthmax to 200>>
		<<set $NPCName[_npcno].pregnancyAvoidance to 0>>
		<<set $NPCList[_npcno].traits.push("hypnotist", "willful", "deviant", "drug resistant")>>
		<<if $gwylan?.wary gte 5>>
			<<set $NPCList[_npcno].traits.push("unforgiving")>>
		<</if>>
		<<set $NPCList[_npcno].skills to {}>>
		<<set $NPCList[_npcno].skills.security to 800>>
		<<set $NPCList[_npcno].skills.athletics to 800>>
		<<set _condomIgnore to true>><<set _strapIgnore to true>>
	<<case "Leighton">>
		<<set $NPCList[_npcno].health to 200>>
		<<set $NPCList[_npcno].healthmax to 200>>
		<<if $headblackmailed is 1>>
			<<set $NPCList[_npcno].traits.push("unforgiving")>>
		<</if>>
	<<case "Night Monster">>
		<<set $NPCList[_npcno].health to 600>>
		<<set $NPCList[_npcno].healthmax to 600>>
		<<set $NPCList[_npcno].traits.push("drug resistant")>>
		<<set _condomIgnore to true>><<set _strapIgnore to true>>
	<<default>>
		<<set $NPCList[_npcno].health to 200>>
		<<set $NPCList[_npcno].healthmax to 200>>
	<</switch>>

	<<set $NPCList[_npcno].breastsize to $NPCName[_i].breastsize>>
	<<set $NPCList[_npcno].breastsdesc to $NPCName[_i].breastsdesc>>
	<<set $NPCList[_npcno].breastdesc to $NPCName[_i].breastdesc>>
	<<set $NPCList[_npcno].vagina to $NPCName[_i].vagina>>

	<<if $settings.breastFeedingEnabled and (_nam is "Morgan" or _nam is "Gwylan" or npcIsPregnant(_nam)) and $NPCName[_i].pronoun is "f" and $NPCName[_i].breastsize gt 0>>
		<<set $NPCList[_npcno].lactation to 1>>
	<</if>>

	<<set $NPCList[_npcno].penis to $NPCName[_i].penis>>
	<<set $NPCList[_npcno].penissize to $NPCName[_i].penissize>>
	<<set $NPCList[_npcno].penisdesc to $NPCName[_i].penisdesc>>

	<<set $NPCList[_npcno].chastity to clone($NPCName[_i].chastity)>>
	<<set $NPCList[_npcno].clothes to clone($NPCName[_i].clothes)>>
	<<set $NPCList[_npcno].chest to clone($NPCName[_i].chest)>>

	<<if $NPCList[_npcno].penis is "none" and $NPCName[_i].strapons and $NPCName[_i].strapons.length gt 0 and random(0,99) lt $settings.straponChance>>
		<<set $NPCList[_npcno].penis to $NPCList[_npcno].vagina>>
		<<set $NPCList[_npcno].vagina to "none">>
		<<set $NPCList[_npcno].gender to "m">>
		<<set $_strapon to clone($NPCName[_i].strapons.random())>>
		<<setNPCStrapon $NPCList[_npcno] $_strapon>>
	<</if>>

	<<set $NPCList[_npcno].skincolour to $NPCName[_i].skincolour>>

	<<set $NPCList[_npcno].insecurity to $NPCName[_i].insecurity>>
	<<set $NPCList[_npcno].description to $NPCName[_i].title>>

	<<set $NPCList[_npcno].insecurity to $NPCName[_i].insecurity>>
	<<set $NPCList[_npcno].description to $NPCName[_i].title>>

	<<set $NPCList[_npcno].adult to $NPCName[_i].adult>>
	<<set $NPCList[_npcno].teen to $NPCName[_i].teen>>

	<<set $NPCList[_npcno].location to {
		head: 0,
		genitals: 0,
	}>>

	<<set $NPCList[_npcno].bold to 0>>
	<<set $NPCList[_npcno].condom to false>>
	<<set $NPCList[_npcno].pregnancyAvoidance to $NPCName[_i].pregnancyAvoidance>>
	<<set $NPCList[_npcno].name_known to $NPCName[_i].name_known>>

	<<if $settings.condomLevel gte 2>>
		<!-- 50 is the threshold for named NPCs bringing their own condoms, do not change -->
		<<if ($NPCList[_npcno].pregnancyAvoidance gte 50 and !_condomIgnore)>>
			<<set $NPCList[_npcno].condom to {
				willUse: true,
				state: (random(0,100) gt 98 ? "defective" : "normal"),
				type: "plain",
				colour: setup.colours.condom[random(0, (setup.colours.condom.length -1))].csstext,
				worn: false
			}>>
		<!-- Kylar brings their own sabotaged condoms -->
		<<elseif _nam is "Kylar">>
			<<set $NPCList[_npcno].condom to {
				willUse: false,
				state: "sabotaged",
				type: "plain",
				colour: setup.colours.condom[random(0, (setup.colours.condom.length -1))].csstext,
				worn: false
			}>>
		<</if>>
	<</if>>

	<!-- Whitney and Avery should wear strap-ons based on strap-on chance -->
	<<if $NPCList[_npcno].penis is "none" and (_nam is "Whitney" or _nam is "Avery") and !_strapIgnore and random(0,99) lt $settings.straponChance>>
		<<npcstrapon _npcno>>
	<</if>>

	<<if _nam is "Sydney" and $sydney_toy isnot undefined>>
		<<giveNPCsextoy _npcno $sydney_toy>>
	<</if>>

	<!-- Following sections adjusted for the changes converting from $claws to .claws -->

	<!-- Adjust for Beast type NNPCs: Black Wolf -->
	<!-- Changed all instances of zeroes (0) to _npcno in the event multi-beast is properly implemented -->
	<<if $NPCList[_npcno].type is "wolf">>
		<<set $beastname to "blackwolf">>
		<<set $NPCList[_npcno].lefthand to "none">>
		<<set $NPCList[_npcno].righthand to "none">>
		<<set $NPCList[_npcno].stance to "approach">>
		<<if $daily.bwMonsterRoll isnot undefined and $blackwolfmonster is 1>>
			<<if $daily.bwMonsterRoll is true>>
				<<set $NPCList[_npcno].monster to "monster">>
				<<set $monster to 1>><<set _monsterOverride to true>>
				<<set $NPCList[_npcno].type to ($NPCList[_npcno].pronoun is "f" ? "wolfgirl" : "wolfboy")>>
				<<set $NPCList[_npcno].lefthand to 0>>
				<<set $NPCList[_npcno].righthand to 0>>
				<<run delete $NPCList[_npcno].claws>>
			<<else>>
				<<set $NPCList[_npcno].monster to 0>>
				<<set $NPCList[_npcno].pronoun to "i">>
				<<set $NPCList[_npcno].claws to "claws">>
			<</if>>
		<<elseif $blackwolfmonster gte 1 or !$settings.bestialityEnabled>>
			<<if ($settings.monsterChance gte $rng and ($hallucinations gte 1 or !$settings.monsterHallucinationsOnly)) or ($blackwolfmonster is 2) or (!$settings.bestialityEnabled)>>
				<<set $daily.bwMonsterRoll to true>>
				<<set $NPCList[_npcno].monster to "monster">>
				<<set $monster to 1>><<set _monsterOverride to true>>
				<<set $NPCList[_npcno].type to ($NPCList[_npcno].pronoun is "f" ? "wolfgirl" : "wolfboy")>>
				<<set $NPCList[_npcno].lefthand to 0>>
				<<set $NPCList[_npcno].righthand to 0>>
				<<run delete $NPCList[_npcno].claws>>
			<<else>>
				<<set $daily.bwMonsterRoll to false>>
				<<set $NPCList[_npcno].monster to 0>>
				<<set $NPCList[_npcno].pronoun to "i">>
				<<set $NPCList[_npcno].claws to "claws">>
			<</if>>
		<<else>>
			<<set $daily.bwMonsterRoll to false>>
			<<set $NPCList[_npcno].monster to 0>>
			<<set $NPCList[_npcno].pronoun to "i">>
			<<set $NPCList[_npcno].claws to "claws">>
		<</if>>
	<</if>>

	<!-- Adjust for Beast type NNPCs: Great Hawk -->
	<<if $NPCList[_npcno].type is "hawk">>
		<<set $beastname to "greathawk">>
		<<set $NPCList[_npcno].lefthand to "none">>
		<<set $NPCList[_npcno].righthand to "none">>
		<<set $NPCList[_npcno].stance to "approach">>
		<<if $daily.ghMonsterRoll isnot undefined and $greathawkmonster is 1>>
			<<if $daily.ghMonsterRoll is true>>
				<<set $NPCList[_npcno].monster to "monster">>
				<<set $monster to 1>><<set _monsterOverride to true>>
				<<set $NPCList[_npcno].type to "harpy">>
				<<set $NPCList[_npcno].lefthand to 0>>
				<<set $NPCList[_npcno].righthand to 0>>
				<<run delete $NPCList[_npcno].claws>>
			<<else>>
				<<set $NPCList[_npcno].monster to 0>>
				<<set $NPCList[_npcno].pronoun to "i">>
				<<set $NPCList[_npcno].claws to "talons">>
			<</if>>
		<<elseif $greathawkmonster gte 1 or !$settings.bestialityEnabled>>
			<<if ($settings.monsterChance gte $rng and ($hallucinations gte 1 or !$settings.monsterHallucinationsOnly)) or ($greathawkmonster is 2) or (!$settings.bestialityEnabled)>>
				<<set $daily.ghMonsterRoll to true>>
				<<set $NPCList[_npcno].monster to "monster">>
				<<set $monster to 1>><<set _monsterOverride to true>>
				<<set $NPCList[_npcno].type to "harpy">>
				<<set $NPCList[_npcno].lefthand to 0>>
				<<set $NPCList[_npcno].righthand to 0>>
				<<run delete $NPCList[_npcno].claws>>
			<<else>>
				<<set $daily.ghMonsterRoll to false>>
				<<set $NPCList[_npcno].monster to 0>>
				<<set $NPCList[_npcno].pronoun to "i">>
				<<set $NPCList[_npcno].claws to "talons">>
			<</if>>
		<<else>>
			<<set $daily.ghMonsterRoll to false>>
			<<set $NPCList[_npcno].monster to 0>>
			<<set $NPCList[_npcno].pronoun to "i">>
			<<set $NPCList[_npcno].claws to "talons">>
		<</if>>
	<</if>>

	<!-- Adjust for Night Monster -->
	<<if $NPCList[_npcno].fullDescription is "Night Monster">>
		<<set $beastname to "nightmonster">>
		<<set $NPCList[_npcno].lefthand to "none">>
		<<set $NPCList[_npcno].righthand to "none">>
		<<set $NPCList[_npcno].stance to "approach">>
		<<if $daily.nmMonsterRoll isnot undefined and $nightmonstermonster is 1>>
			<<if $daily.nmMonsterRoll is true>>
				<<set $NPCList[_npcno].monster to "monster">>
				<<set $monster to 1>><<set _monsterOverride to true>>
				<<set $NPCList[_npcno].type to ($NPCList[_npcno].pronoun is "f" ? "horned woman" : "horned man")>>
				<<set $NPCList[_npcno].lefthand to 0>>
				<<set $NPCList[_npcno].righthand to 0>>
				<<run delete $NPCList[_npcno].claws>>
			<<else>>
				<<set $NPCList[_npcno].monster to 0>>
				<<set $NPCList[_npcno].pronoun to "i">>
				<<set $NPCList[_npcno].claws to "claws">>
			<</if>>
		<<elseif $nightmonstermonster gte 1 or !$settings.bestialityEnabled>>
			<<if ($settings.monsterChance gte $rng and ($hallucinations gte 1 or !$settings.monsterHallucinationsOnly)) or ($nightmonstermonster is 2) or (!$settings.bestialityEnabled)>>
				<<set $daily.nmMonsterRoll to true>>
				<<set $NPCList[_npcno].monster to "monster">>
				<<set $monster to 1>><<set _monsterOverride to true>>
				<<set $NPCList[_npcno].type to ($NPCList[_npcno].pronoun is "f" ? "horned woman" : "horned man")>>
				<<set $NPCList[_npcno].lefthand to 0>>
				<<set $NPCList[_npcno].righthand to 0>>
				<<run delete $NPCList[_npcno].claws>>
			<<else>>
				<<set $daily.nmMonsterRoll to false>>
				<<set $NPCList[_npcno].monster to 0>>
				<<set $NPCList[_npcno].pronoun to "i">>
				<<set $NPCList[_npcno].claws to "claws">>
			<</if>>
		<<else>>
			<<set $daily.nmMonsterRoll to false>>
			<<set $NPCList[_npcno].monster to 0>>
			<<set $NPCList[_npcno].pronoun to "i">>
			<<set $NPCList[_npcno].claws to "claws">>
		<</if>>
	<</if>>

	<<if $enemyno lt 6>><<set $enemyno += 1>><</if>>

	<<if $NPCList[0].monster is "monster" or _monsterOverride>>
		<<set $monster to 1>>
	<<else>>
		<<set $monster to 0>>
	<</if>>

	/*Run pregnancy Checks*/
	<<if playerIsPregnant() and playerBellyVisible(true) and _nam isnot "Robin">>
		<<setKnowsAboutPregnancy "pc" _args[0]>>
	<</if>>
	<<if npcIsPregnant(_args[0]) and npcBellyVisible(_args[0])>>
		<<setKnowsAboutPregnancy _args[0] "pc">>
	<</if>>

	<<set $NPCList[_npcno].index to _npcno>>
	<<run EventSystem.push($passage, _npcno, $timeStamp)>>
	<<set $index to _npcno>>
<</widget>>

<<widget "npcrelationship">>
	<!-- Robin, Avery, Kylar are unique and are treated differently -->
	<<set _i to V.NPCName.findIndex(i => i.nam === _args[0])>>
	<<if _i !== -1>>
		<<set _npc to _args[0]>>
	<<else>>
		<<error { message: "<<npcrelationship>> was provided incorrect arguments" }>>
	<</if>>
	<<if $NPCName[_i].init is 1>>
		<<relationshiptext>>
		<br>
	<</if>>
<</widget>>

<<widget "npcincr">>
	<!-- Arguments passed are NNPC name, variable type, and value (+/-)-->
	<<set _nam to _args[0]>>
	<<set _var to _args[1]>>
	<<set _val to _args[2]>>
	<<if _args[3]>>
		<<set _cheat to _args[3]>>
	<</if>>

	<!-- 
		do NOT change this to reference setup.NPCNameList: this check exists to make sure whenever a new NNPC is added, 
		calling npcincr with them throws an error until the implemented adds clamps to <<relationshipclamp>> 
		and adds their name to relevant whitelists (and blacklists, if they don't use love or dom) below. 

		if you're reading this, there's a decent chance that means you! 
		head over to game/base-system/widgets.twee and give this new NNPC relevant clamps before whitelisting them below.
	-->
	<<set _validNNPCNames to ["Avery","Bailey","Briar","Charlie","Darryl","Doren","Eden","Gwylan","Harper","Jordan","Kylar","Landry","Leighton","Mason","Morgan","River","Robin","Sam","Sirris","Whitney","Winter","Black Wolf","Niki","Quinn","Remy","Alex","Great Hawk","Wren","Sydney","Ivory Wraith","Zephyr"]>>
	<<if !_validNNPCNames.includes(_nam)>>
		<<error { message: "NNPC '" + _nam + "' is not whitelisted for use with <<npcincr>>"}>>
	<</if>>

	<<set _i to $NPCNameList.indexOf(_nam)>>

	<<switch _var>>
	<<case love>>
		<<if $valentines and Time.monthDay is 14 and setup.loveInterestNpc.includes(_nam)>>
			<<set _val += _val>>
		<</if>>
		<<set $NPCName[_i].love += _val>>
	<<case dom>>
		<<if ["Sydney", "Black Wolf", "Ivory Wraith"].includes(_nam)>>
			<<error { message: "<<npcincr>> attempted to modify dom for " + _nam + ", who has no dom clamp" }>>
		<</if>>
		<<if _nam is "Gwylan" and _val gt 0>>
			<<set $_stage to Math.floor($NPCName[_i].dom / 25)>>
			<<if $_stage gte 1 and !$gwylanSeen?.includes("yearning") or $_stage gte 3 and !$gwylanSeen?.includes("partners") or $gwylan?.wary gt 1>>
				<!-- No increase -->
			<<else>>
				<<set $NPCName[_i].dom += _val>>
			<</if>>
		<<else>>
			<<set $NPCName[_i].dom += _val>>
		<</if>>
	<<case trust>>
		<<if _nam isnot "Eden">>
			<<error { message: "<<npcincr>> attempted to modify trust for someone other than Eden (" + _nam + ")" }>>
		<</if>>
		<<set $NPCName[_i].trust += _val>>
	<<case lust>>
		<<set _lustwhitelist to ["Robin", "Whitney", "Eden", "Kylar", "Avery", 
								 "Alex", "Sydney", "Gwylan", "Bailey", 
								 "Leighton", "Quinn", "Ivory Wraith", "Mason"]>>
		<<if !_lustwhitelist.includes(_nam)>>
			<<error { message: "<<npcincr>> attempted to modify lust for non-whitelisted npc " + _nam + ". Make sure to add a lust clamp in <<relationshipclamp>> before whitelisting!" }>>
		<</if>>
		<<if $valentines and Time.monthDay is 14 and setup.loveInterestNpc.includes(_nam)>>
			<<set _val += _val>>
		<</if>>
		<<if _nam is "Sydney" and !_sydneyChastity and _val gt 0 and !_cheat>>
			<<set $NPCName[_i].lust += (_val + 1)>>
		<<else>>
			<<set $NPCName[_i].lust += _val>>
		<</if>>
		<<set _lustincr to 1>>
	<<case rage>>
		<<if !["Avery", "Kylar"].includes(_nam)>>
			<<error { message: "<<npcincr>> attempted to modify rage for someone other than Avery or Kylar (" + _nam + ")" }>>
		<</if>>
		<<set $NPCName[_i].rage += _val>>
	<<case trauma>>
		<<if _nam isnot "Robin">>
			<<error { message: "<<npcincr>> attempted to modify trauma for someone other than Robin (" + _nam + ")" }>>
		<</if>>
		<<if _nam is "Robin" and _val lt 0>>
			<<set $NPCName[_i].trauma += Math.round(_val * ($robinTraumaMultiplier || 1))>>
			<<if $NPCName[_i].trauma lt 0>>
				<<set $NPCName[_i].trauma = 0>>
			<</if>>
		<<else>>
			<<set $NPCName[_i].trauma += _val>>
			<<if $NPCName[_i].trauma gt 100>>
				<<set $NPCName[_i].trauma = 100>>
			<</if>>
		<</if>>
	<<case purity>>
		<<if _nam isnot "Sydney">>
			<<error { message: "<<npcincr>> attempted to modify purity for someone other than Sydney (" + _nam + ")" }>>
		<</if>>
		<<if $NPCName[_i].corruption gt 0>>
			<<set $NPCName[_i].corruption -= _val>>
			<<if $NPCName[_i].corruption lte 0>>
				<<if $purityEvent is 1>>
					<<set _rollover to -$NPCName[_i].corruption>>
					<<set $NPCName[_i].purity += (_rollover + 4)>>
					<<set $NPCName[_i].corruption = 0>>
					<<set $purityRollover to 1>>
				<<else>>
					<<set $NPCName[_i].corruption = 1>>
				<</if>>
			<</if>>
		<<else>>
			<<set $NPCName[_i].purity += _val>>
			<<if $NPCName[_i].purity lte 0>>
				<<if $corruptionEvent is 1>>
					<<set _rollover to -$NPCName[_i].purity>>
					<<set $NPCName[_i].corruption += (_rollover + 10)>>
					<<set $NPCName[_i].purity = 0>>
					<<set $corruptionRollover to 1>>
				<<else>>
					<<set $NPCName[_i].purity = 1>>
				<</if>>
			<</if>>
			<<if $NPCName[_i].purity gte 100 and ($NPCName[_i].virginity.vaginal isnot true or $NPCName[_i].virginity.penile isnot true)>>
				<<set $NPCName[_i].purity = 99>>
			<</if>>
		<</if>>
		<<if $NPCName[_i].purity lte 50 and _val lt 0 and _lustincr isnot 1>>
			<<npcincr Sydney lust 1>>
		<</if>>
		<<unset $purityEvent>>
		<<unset $corruptionEvent>>
	<<default>>
		<span class="red">NPCINCR error - Unknown variable _var</span>
		<br><br>
	<</switch>>
<<relationshipclamp>>
<</widget>>

<<widget "npcset">>
	<!-- Sets selected NNPC variables using NNPC name-->
	<!-- Arguments passed are NNPC name, variable type, value -->

	<<set _nam to _args[0]>>
	<<set _var to _args[1]>>
	<<set _val to _args[2]>>

	<<set _i to $NPCNameList.indexOf(_nam)>>

	<<switch _var>>
		<<case love>>
			<<set $NPCName[_i].love to _val>>
		<<case dom>>
			<<set $NPCName[_i].dom to _val>>
		<<case trust>>
			<<set $NPCName[_i].trust to _val>>
		<<case lust>>
			<<set $NPCName[_i].lust to _val>>
		<<case rage>>
			<<set $NPCName[_i].rage to _val>>
		<<case state>>
			<<set $NPCName[_i].state to _val>>
		<<case init>>
			<<set $NPCName[_i].init to _val>>
		<<case trauma>>
			<<set $NPCName[_i].trauma to _val>>
		<<case purity>>
			<<set $NPCName[_i].purity to _val>>
		<<case corruption>>
			<<set $NPCName[_i].corruption to _val>>
		<<default>>
			<span class="red">NPCSET error - Unknown value _var</span>
			<br><br>
	<</switch>>
<</widget>>

<<widget "relationshiptext">>
	<!-- Special cases for LIs + Wraith -->
	<<switch _npc>>
		<<case Robin>>
			Robin
			<<if $robin.timer.hurt gte 2>>
				feels <span class="red">betrayed</span>.
			<<elseif $robin.timer.hurt gte 1>>
				feels <span class="purple">conflicted</span>.
			<<elseif $robinromance is 1>>
				<<if $NPCName[_i].trauma gte 80>>
					<<if $NPCName[_i].lust gte 50>>
						is <span class="red">lost in need for you</span>.
					<<else>>
						is <span class="red">nothing without you</span>.
					<</if>>
				<<elseif $NPCName[_i].dom gte 40>>
					<span class="lewd">cherishes you</span>.
				<<else>>
					<span class="lewd">loves you</span>.
				<</if>>
			<<elseif $NPCName[_i].trauma gte 80>>
				is <span class="red">traumatised</span>.
			<<elseif $NPCName[_i].trauma gte 40>>
				is <span class="red">in pain</span>.
			<<elseif $NPCName[_i].trauma gte 10>>
				is <span class="purple">troubled</span>.
			<<elseif $NPCName[_i].dom gte 80>>
				feels <span class="teal">protective of you</span>.
			<<elseif $NPCName[_i].dom gte 20>>
				thinks you're <span class="teal"><<nnpc_his "Robin">> best friend</span>.
			<<else>>
				<span class="teal">looks up to you</span>.
			<</if>>
		<<case Avery>>
			Avery
			<<if $NPCName[_i].state is "dismissed">>
				<<if $avery_fate is "fallen" or $avery_fate is "kicked">>
					<span class="black">has fallen.</span>
				<<else>>
					<span class="red">has moved on.</span>
				<</if>>
			<<elseif $NPCName[_i].rage gte 96 and $averyragerevealed is 1 and $dateCount.Avery gte 2 and !$avery_mansion>>
				has <span class="red">given up on you</span>.
			<<elseif $NPCName[_i].love gte 60>>
				<<if $NPCName[_i].rage gte 60>>
					is <span class="pink">infuriated by you</span>.
				<<elseif $NPCName[_i].rage gte 20>>
					wants you <span class="blue">on a tighter leash</span>.
				<<else>>
					<span class="green">prizes you</span>.
				<</if>>
			<<elseif $NPCName[_i].love gte 20>>
				<<if $NPCName[_i].rage gte 60>>
					is <span class="pink">furious with you</span>.
				<<elseif $NPCName[_i].rage gte 20>>
					sees you <span class="purple">as a possession</span>.
				<<else>>
					thinks you're <span class="teal">cute</span>.
				<</if>>
			<<else>>
				<<if $NPCName[_i].rage gte 60>>
					thinks you're <span class="pink">insolent</span>.
				<<elseif $NPCName[_i].rage gte 20>>
					thinks you're <span class="blue">a brat</span>.
				<<else>>
					has no strong opinion of you.
				<</if>>
			<</if>>
		<<case Kylar>>
			Kylar
			<<if $NPCName[_i].state is "prison" and $location isnot "prison">>
				is <span class="red">imprisoned</span>.
			<<elseif $NPCName[_i].love gte 90>>
				<<if $NPCName[_i].rage gte 90>>
					is <span class="red">hysterical</span>.
				<<elseif $NPCName[_i].rage gte 60>>
					is <span class="pink">obsessed with you</span>.
				<<elseif $NPCName[_i].rage gte 30>>
					is <span class="blue">obsessed with you</span>.
				<<else>>
					is <span class="green">obsessed with you</span>.
				<</if>>
			<<elseif $NPCName[_i].love gte 60>>
				<<if $NPCName[_i].rage gte 90>>
					is <span class="red">hysterical</span>.
				<<elseif $NPCName[_i].rage gte 60>>
					is <span class="pink">enamoured with you</span>.
				<<elseif $NPCName[_i].rage gte 30>>
					is <span class="purple">enamoured with you</span>.
				<<else>>
					is <span class="teal">enamoured with you</span>.
				<</if>>
			<<elseif $NPCName[_i].love gte 30>>
				<<if $NPCName[_i].rage gte 90>>
					is <span class="red">hysterical</span>.
				<<elseif $NPCName[_i].rage gte 60>>
					is <span class="pink">infatuated with you</span>.
				<<elseif $NPCName[_i].rage gte 30>>
					is <span class="purple">infatuated with you</span>.
				<<else>>
					is <span class="lblue">infatuated with you</span>.
				<</if>>
			<<else>>
				<<if $NPCName[_i].rage gte 90>>
					is <span class="red">hysterical</span>.
				<<elseif $NPCName[_i].rage gte 60>>
					is <span class="pink">fixated on you</span>.
				<<elseif $NPCName[_i].rage gte 30>>
					is <span class="purple">fixated on you</span>.
				<<else>>
					is <span class="blue">fixated on you</span>.
				<</if>>
			<</if>>
		<<case Whitney>>
			Whitney
			<<if $NPCName[_i].state is "dungeon">>
				is <span class="red">gone</span>.
			<<elseif $whitneyRescueStatus isnot undefined>>
				<<if $whitneyRescueStatus is "humiliated" and !$whitneyRescueTimer>>
					is <span class="red">vulnerable</span>.
				<<elseif $whitneyRescueStatus is "humiliated">>
					is <span class="red">humiliated</span>.
				<<elseif $whitneyRescueStatus is "shaken">>
					is <span class="pink">unnerved and agitated</span>.
				<<elseif $whitneyRescueStatus is "grateful">>
					is <span class="green">grateful</span>.
				<</if>>
			<<elseif $NPCName[_i].love gte 20>>
				<<if $NPCName[_i].lust gte 60>>
					is <span class="lewd">up for some fun</span>.
				<<else>>
					<<if $NPCName[_i].dom gte 20>>
						<span class="lewd">owns you</span>.
					<<elseif $NPCName[_i].dom lte 8>>
						thinks you're <span class="green"><<nnpc_his "Whitney">> <<girlfriend>></span>.
					<<else>>
						thinks you're <span class="lewd"><<nnpc_his "Whitney">> pet</span>.
					<</if>>
				<</if>>
			<<elseif $NPCName[_i].love lte 5>>
				<<if $NPCName[_i].lust gte 60>>
						wants to <span class="pink"><<= $NPCName[_i].dom gte 18 ? "make" : "hear">> you beg</span>.
				<<else>>
					<<if $NPCName[_i].dom gte 20>>
						thinks you're <span class="red">pathetic</span>.
					<<elseif $NPCName[_i].dom lte 7>>
						<<if $NPCName[_i].dom lte 2 and $NPCName[_i].love lte 2>>
							has <span class="red">a vendetta against you</span>.
						<<else>>
							thinks you're <span class="red">a threat to <<nnpc_his "Whitney">> status</span>.
						<</if>>
					<<else>>
						thinks you're <span class="red">a freak</span>.
					<</if>>
				<</if>>
			<<else>>
				<<if $NPCName[_i].dom gte 20>>
					thinks you're <span class="teal">fun to pick on</span>.
				<<elseif $NPCName[_i].dom lte 8>>
					finds you <span class="purple">annoying</span>.
				<<else>>
					thinks you're <span class="pink">an easy target</span>.
				<</if>>
			<</if>>
		<<case Eden>>
			Eden
			<<if $syndromeeden gte 1>>
				<<if $edenfreedom gte 1 and $location isnot "cabin" and ($edenfreedom is 1 and $edendays gt 2 or $edenfreedom is 2 and $edendays gt 7)>>
					<<if $edenfreedom is 1 and $edendays gte 4 or $edenfreedom is 2 and $edendays gte 10>>
						wants you to <span class="red">come home</span>.
					<<else>>
						is <span class="blue">worried about you</span>.
					<</if>>
				<<else>>
					/* edenfreedom checks here should be replaced with trust stat later. edenfreedom = 2 is high trust, 1 is med trust, 0 is low trust. */
					<<if $NPCName[_i].love gte 150>>
						<<if $edenfreedom is 2>>
							knows you're <span class="green"><<nnpc_hers "Eden">></span>.
						<<elseif $edenfreedom is 1>>
							is <span class="teal">confident you'll obey <<nnpc_him "Eden">></span>.
						<<else>>
							wants to <span class="blue">keep you as <<nnpc_hers "Eden">></span>.
						<</if>>
					<<elseif $NPCName[_i].love gte 75>>
						<<if $edenfreedom is 2>>
							knows you <span class="blue">belong with <<nnpc_him "Eden">></span>.
						<<elseif $edenfreedom is 1>>
							wants you to <span class="purple">obey <<nnpc_him "Eden">></span>.
						<<else>>
							wants to <span class="pink">remind you that you're <<nnpc_hers "Eden">></span>.
						<</if>>
					<<else>>
						<<if $edenfreedom is 2>>
							knows you <span class="purple">should be with <<nnpc_him "Eden">></span>.
						<<elseif $edenfreedom is 1>>
							will <span class="pink">make you obey <<nnpc_him "Eden">></span>.
						<<else>>
							wants to <span class="red">make you <<nnpc_hers "Eden">></span>.
						<</if>>
					<</if>>
				<</if>>
			<<else>>
				<<if $location is "cabin">>
					wants to <span class="red">keep you</span>.
				<<else>>
					will <span class="red">hunt you again</span>.
				<</if>>
			<</if>>
		<<case Sydney>>
			Sydney
			<<if $sydneyromance is 1>>
				<<if $NPCName[_i].purity gt 80>>
					<<if $NPCName[_i].lust gte 60>>
						<span class="lewd">can't think of anything but you</span>.
					<<else>>
						<span class="lewd">loves you beyond words</span>.
					<</if>>
				<<elseif $NPCName[_i].purity gte 40>>
					<<if $NPCName[_i].lust gte 30>>
						<span class="lewd">yearns for your touch</span>.
					<<else>>
						feels <span class="lewd">bound to you</span>.
					<</if>>
				<<elseif $NPCName[_i].corruption gte 40>>
					<<if $NPCName[_i].lust gte 20>>
						wants to <span class="lewd">be <<if $NPCName[_i].virginity.vaginal is true and $NPCName[_i].virginity.penile is true>>deflowered<<else>>defiled<</if>> by you</span>.
					<<else>>
						<span class="lewd">loves you beyond words</span>.
					<</if>>
				<<elseif $NPCName[_i].corruption gte 10>>
					<<if $NPCName[_i].lust gte 10>>
						<span class="lewd">craves your touch</span>.
					<<else>>
						<span class="lewd">belongs to you</span>.
					<</if>>
				<<else>>
					<span class="lewd">loves you</span>.
				<</if>>
			<<elseif $sydney.heartbroken>>
				is <span class="red">heartbroken</span>.
			<<elseif $NPCName[_i].love gte 60>>
				<<if $NPCName[_i].purity gte 50>>
					<<if $purity lte 500 or $demon gte 6>>
						wants to <span class="blue">save you</span>.
					<<elseif $temple_rank is "monk" or $temple_rank is "priest" or $angel gte 6>>
						considers you <span class="green">an inspiration</span>.
					<<elseif $temple_rank is "initiate">>
						considers you <span class="green">a prodigy</span>.
					<<else>>
						is <span class="green">very fond of you</span>.
					<</if>>
				<<elseif $NPCName[_i].corruption gte 10>>
					is <span class="lewd">influenced by you</span>.
				<<else>>
					is <span class="purple">torn</span>.
				<</if>>
			<<elseif $NPCName[_i].love gte 30>>
				<<if $NPCName[_i].purity gte 50>>
					<<if $purity lte 500 or $demon gte 6>>
						thinks you're <span class="blue">misguided</span>.
					<<elseif $temple_rank is "monk" or $temple_rank is "priest" or $angel gte 6>>
						<span class="teal">looks up to you</span>.
					<<elseif $temple_rank is "initiate">>
						sees you as <span class="teal">an equal</span>.
					<<else>>
						<span class="teal">enjoys your company</span>.
					<</if>>
				<<elseif $NPCName[_i].corruption gte 10>>
					wants to <span class="pink">know you better</span>.
				<<else>>
					is <span class="purple">conflicted</span>.
				<</if>>
			<<elseif $NPCName[_i].love gte 10>>
				<<if $sydneySeen and $sydneySeen.includes("initiate")>>
					<<if $purity lte 500 or $demon gte 6>>
						thinks <span class="pink">you're lost</span>.
					<<else>>
						is <span class="lblue">proud of you</span>.
					<</if>>
				<<else>>
					is <span class="lblue">intrigued by you</span>.
				<</if>>
			<<else>>
				<<if $sydneySeen and $sydneySeen.includes("initiate")>>
					<<if $purity lte 500 or $demon gte 6>>
						thinks you're <span class="red">heretical</span>.
					<<elseif $sydney.rank is "initiate" and $temple_rank is "initiate">>
						is <span class="blue">happy to know another initiate</span>.
					<<else>>
						is <span class="blue">happy to know another worshipper</span>.
					<</if>>
				<<else>>
					has no strong opinion of you.
				<</if>>
			<</if>>
		<<case Alex>>
			Alex
			<<if $alex_countdown is undefined and $farm_stage gte 7>>
				<<if $NPCName[_i].lust gte 60>>
					wants to <span class="lewd">ride until sun<<if Time.dayState is "night">>rise<<else>>set<</if>></span>.
				<<elseif $NPCName[_i].dom gte 30>>
					is <span class="lewd">in charge</span>.
				<<elseif $NPCName[_i].dom lte -30>>
					<span class="lewd">depends on you</span>.
				<<else>>
					thinks you're <span class="lewd"><<nnpc_his "Alex">> partner</span>.
				<</if>>
			<<elseif $farm_stage gte 6>>
				<<if $NPCName[_i].dom gte 30>>
					is <span class="pink">in control</span>.
				<<elseif $NPCName[_i].dom lte -30>>
					<span class="teal">relies on you</span>.
				<<else>>
					<span class="blue">can't be more grateful</span>.
				<</if>>
			<<elseif $farm_stage gte 5>>
				<<if $NPCName[_i].dom gte 10>>
					<span class="blue">respects you</span>.
				<<elseif $NPCName[_i].dom lte -10>>
					<span class="blue">admires you</span>.
				<<else>>
					<span class="blue">appreciates you</span>.
				<</if>>
			<<elseif $farm_stage gte 4>>
				<<if $NPCName[_i].dom gte 10>>
					thinks you're <span class="green">responsible</span>.
				<<elseif $NPCName[_i].dom lte -10>>
					thinks you're <span class="green">capable</span>.
				<<else>>
					<span class="green">likes having you around</span>.
				<</if>>
			<<elseif $NPCName[_i].love gte 10>>
				is <span class="green">glad to have help</span>.
			<<elseif $NPCName[_i].love lte -10>>
				<<if $NPCName[_i].lust gte 10>>
					thinks you're <span class="purple">a pervert</span>.
				<<elseif $NPCName[_i].dom gte 10>>
					<span class="red">wants a new farmhand</span>.
				<<else>>
					thinks you're <span class="red">a bother</span>.
				<</if>>
			<<else>>
				has no strong opinion of you.
			<</if>>
		<<case "Ivory Wraith">>
			<<if $wraith>>
				<<if $wraith.hunt and !$wraith.type>>
					The Wraith
					<<if $wraith.state is "haunt">>
						is <span class="red">fiercely hunting you</span>.
					<<else>>
						is <span class="blue">stalking you</span>.
					<</if>>
				<<elseif _rngWraithLineChance is 1>>
					<<if !_rngWraithLine>>
						<<set _rngWraithLine to true>>
						<<silently>><<speechWraith "lines">><</silently>>
					<</if>>
					_line1
				<<else>>
					The Wraith
					<<if $wraith.state is "haunt">>
						<<if $NPCName[_i].lust gte 18>>
							is <span class="red">manic</span>.
						<<elseif $NPCName[_i].lust gte 14>>
							is <span class="pink">enraged</span>.
						<<else>>
							<span class="purple">holds a grudge</span>.
						<</if>>
					<<elseif $wraith.state is "despair">>
						<<if $NPCName[_i].lust gte 18>>
							is <span class="red">manic</span>.
						<<elseif $NPCName[_i].lust gte 14>>
							is <span class="pink">in anguish</span>.
						<<else>>
							is <span class="purple">melancholic</span>.
						<</if>>
					<<else>>
						<<if $NPCName[_i].lust gte 15>>
							is <span class="purple">obsessed with you</span>.
						<<elseif $NPCName[_i].lust gte 6>>
							is <span class="purple">intrigued by you</span>.
						<<else>>
							is <span class="blue">entertained by you</span>.
						<</if>>
					<</if>>
				<</if>>
			<</if>>
		<<case "Great Hawk">>
			Great Hawk
			<<if $syndromebird is 1>>
				<<if $NPCName[_i].love gte 60>>
					<<if $NPCName[_i].dom gte 50>>
						has <span class="lewd">claimed you as <<if $greathawkmonster gte 1>><<nnpc_his "Great Hawk">><<else>>its<</if>> <<wife>></span>.
					<<elseif $NPCName[_i].dom gte 20>>
						thinks you're <span class="lewd"><<if $greathawkmonster gte 1>><<nnpc_his "Great Hawk">><<else>>its<</if>> <<wife>></span>.
					<<else>>
						thinks you're <span class="lewd">a good <<wife>></span>.
					<</if>>
				<<elseif $NPCName[_i].love gte 20>>
					<<if $NPCName[_i].dom gte 50>>
						wants you to <span class="red">return <<if $greathawkmonster gte 1>><<nnpc_his "Great Hawk">><<else>>its<</if>> affections</span>.
					<<elseif $NPCName[_i].dom gte 20>>
						is <span class="red">distraught</span>.
					<<else>>
						is <span class="red">desperate for your affection</span>.
					<</if>>
				<<else>>
					<<if $NPCName[_i].dom gte 50>>
						wants you <span class="teal">as a mate</span>.
					<<elseif $NPCName[_i].dom gte 20>>
						is <span class="teal">lonely</span>.
					<<else>>
						is <span class="teal">smitten with you</span>.
					<</if>>
				<</if>>
			<<else>>
				wants you to <span class="red">stay forever</span>.
			<</if>>
		<<case "Black Wolf">>
			Black Wolf
			<<if $syndromewolves is 1>>
				<<if $NPCName[_i].love gte $npclovehigh>>
					<<if $wolfpackferocity gt $wolfpackharmony>>
						<<print $blackwolfmonster gte 1 ? "is" : "seems">> <span class="lewd">proud you're <<if $blackwolfmonster gte 1>><<nnpc_his "Black Wolf">><<else>>its<</if>> mate</span>.
					<<elseif $wolfpackharmony gt $wolfpackferocity>>
						<<print $blackwolfmonster gte 1 ? "is" : "seems">> <span class="lewd">glad you're <<if $blackwolfmonster gte 1>><<nnpc_his "Black Wolf">><<else>>its<</if>> mate</span>.
					<<else>>
						thinks of you <span class="lewd">as <<if $blackwolfmonster gte 1>><<nnpc_his "Black Wolf">><<else>>its<</if>> mate</span>.
					<</if>>
				<<elseif $NPCName[_i].love lte $npclovelow>>
					<<if $wolfpackferocity gt $wolfpackharmony>>
						wants you <span class="red">out of the pack</span>.
					<<elseif $wolfpackharmony gt $wolfpackferocity>>
						is <span class="red">wary of you</span>.
					<<else>>
						thinks you're <span class="red">a terrible packmate</span>.
					<</if>>
				<<else>>
					<<if $wolfpackferocity gt $wolfpackharmony>>
						thinks you're <span class="pink">a strong packmate</span>.
					<<elseif $wolfpackharmony gt $wolfpackferocity>>
						thinks you're <span class="teal">a worthy packmate</span>.
					<<else>>
						<span class="teal">values your place in the pack</span>.
					<</if>>
				<</if>>
			<<else>>
				<<if $NPCName[_i].love gte $npclovehigh>>
					<<if $wolfpackferocity gt $wolfpackharmony>>
						thinks you'd be <span class="green">a powerful packmate</span>.
					<<elseif $wolfpackharmony gt $wolfpackferocity>>
						thinks you'd be <span class="green">a valuable packmate</span>.
					<<else>>
						thinks you'd be <span class="green">a good packmate</span>.
					<</if>>
				<<elseif $NPCName[_i].love lte $npclovelow>>
					<<if $wolfpackferocity gt $wolfpackharmony>>
						thinks you'd be <span class="red">a weak packmate</span>.
					<<elseif $wolfpackharmony gt $wolfpackferocity>>
						thinks you'd be <span class="red">a useless packmate</span>.
					<<else>>
						thinks you'd be <span class="red">a poor packmate</span>.
					<</if>>
				<<else>>
					<<if $wolfpackferocity gt $wolfpackharmony>>
						wants to <span class="pink">tussle with you</span>.
					<<elseif $wolfpackharmony gt $wolfpackferocity>>
						wants to <span class="teal">spend more time with you</span>.
					<<else>>
						has no strong opinion of you.
					<</if>>
				<</if>>
			<</if>>
		<<case Gwylan>>
			<<run statusCheck("Gwylan")>>
			<<if isGwylanAbsent() is "nobody">><span class="red">Nobody</span><<else>>Gwylan<</if>>
			<<if C.npc.Gwylan.state is "scorned">>
				<<if $yearningLetter is 2>>
					is <span class="blue">waiting for you at the forest shop</span>.
				<<elseif $gwylanSeen?.includes("yearning_pub")>>
					is <span class="pink">sulking</span>.
				<<else>>
					has <span class="red">scorned your affections</span>.
				<</if>>
			<<elseif $gwylanSeen?.includes("ritual_sex") and $gwylan?.timer.ritual and Time.date.dayDifference(new DateTime($gwylan.timer.ritual)) lte 0>>
				<<if $gwylan.hunting gte 2>>
					<<if $gwylanSeen?.includes("romance")>>
						<span class="red">can't do this without you anymore</span>.
					<<else>>
						is <span class="red">looking for you</span>.
					<</if>>
				<<elseif _gwylanStatus.includesAny("heat") and _gwylanTF.known>>
					is <span class="lewd">eager to mate with you</span>.
				<<elseif _gwylanStatus.includesAny("aroused", "lust")>>
					<span class="lewd">eagerly awaits you at the forest shop</span>.
				<<else>>
					is <span class="blue">ready to enact the ritual with you</span>.
				<</if>>
			<<elseif $gwylanSeen?.includes("romance")>>
				<<if isGwylanAbsent() is "nobody">>
					is home.
				<<elseif $gwylan.taken>>
					<<if $gwylan.taken is "scarred">>
						will <span class="red">protect you from the world, and protect the world from you</span>.
					<<elseif C.npc.Gwylan.dom gte 140>>
						wants to <span class="lewd">pamper you forever</span>.
					<<else>>
						will <span class="lewd">care for you</span>.
					<</if>>
				<<elseif $gwylan?.wary gte 2 && ($brownFoxRevealed or $gwylanSeen?.includes("auriga_scar"))>>
					<<if $avery_fate is "ascended" and $auriga_scar gte 1>>
						has been <span class="red">broken by your betrayal</span>.
					<<else>>
						is <span class="red">disappointed in you</span>.
					<</if>>
				<<elseif C.npc.Gwylan.dom gte 140>>
					<span class="forest-green">won't stop thinking of you</span>.
				<<elseif C.npc.Gwylan.dom gte 110>>
					<span class="green">can't stop thinking of you</span>.
				<<elseif C.npc.Gwylan.dom gte 80>>
					<span class="green">thinks of you all the time</span>.
				<<elseif C.npc.Gwylan.dom gte 50>>
					<span class="green">thinks of you often</span>.
				<<else>>
					<span class="teal">thinks of you fondly</span>.
				<</if>>
			<<elseif $gwylanSeen?.includes("partners")>>
				<<if $gwylan?.wary gte 2 && ($brownFoxRevealed or $gwylanSeen?.includes("auriga_scar"))>>
					<<if $avery_fate is "ascended" and $auriga_scar gte 1>>
						feels <span class="red">betrayed</span>.
					<<else>>
						is <span class="red">disappointed in you</span>.
					<</if>>
				<<elseif _gwylanStatus.includes("wantsPregnancy")>>
					is <span class="pink">lost in you</span>.
				<<elseif C.npc.Gwylan.dom gte 140>>
					seems <span class="witchbloom">conflicted</span>.
				<<elseif _gwylanStatus.includes("heat")>>
					<<if _gwylanTF.known>>
						is <span class="pink">in <<if C.npc.Gwylan.gender is "m">>rut<<else>>heat<</if>></span>.
					<<else>>
						is <span class="pink">acting strange around you</span>.
					<</if>>
				<<elseif C.npc.Gwylan.dom gte 110>>
					<span class="green">can't stop thinking of you</span>.
				<<elseif C.npc.Gwylan.dom gte 80>>
					<span class="green">thinks of you all the time</span>.
				<<elseif C.npc.Gwylan.dom gte 50>>
					<span class="green">thinks of you often</span>.
				<<else>>
					<span class="teal">thinks of you fondly</span>.
				<</if>>
			<<elseif $gwylanSeen?.includes("yearning") and C.npc.Gwylan.dom gte 25>>
				<<if $gwylan?.wary gte 2 && ($brownFoxRevealed or $gwylanSeen?.includes("auriga_scar"))>>
					<<if $avery_fate is "ascended" and $auriga_scar gte 1>>
						feels <span class="red">betrayed</span>.
					<<else>>
						is <span class="red">wary of you</span>.
					<</if>>
				<<elseif C.npc.Gwylan.dom gte 75 and $dateCount?.GwylanSex gte 5>>
					is <span class="pink">giving in to your advances</span>.
				<<elseif _gwylanStatus.includes("lust")>>
					is <span class="pink">wavering</span>.
				<<elseif C.npc.Gwylan.dom gte 50>>
					<span class="teal">enjoys your companionship</span>.
				<<else>>
					wants things to go <span class="purple">back to the way they were</span>.
				<</if>>
			<<else>>
				<<if $gwylan?.wary gt 1 && ($brownFoxRevealed or $gwylanSeen?.includes("auriga_scar"))>>
					is <span class="red">wary of you</span>.
				<<elseif _gwylanStatus.includes("aroused")>>
					is <span class="pink">nervous about how close you are becoming</span>.
				<<elseif _gwylanLovePercent gte 80>>
					<span class="green">knows there's something special about you</span>.
				<<elseif _gwylanLovePercent lt 65 and $gwylanTalked?.length gte 6 and !$daily.gwylan.clothesTalk>>
					is <span class="blue">eager to hear more of your stories</span>.
				<<elseif _gwylanLovePercent gte 60>>
					<span class="teal">thinks there's something special about you</span>.
				<<elseif _gwylanLovePercent gte 40>>
					is <span class="lblue">fascinated by you</span>.
				<<elseif _gwylanLovePercent gte 20 or $avery_mansion>>
					is <span class="blue">curious about you</span>.
				<<else>>
					has no strong opinion of you.
				<</if>>
			<</if>>

		<!-- Persons of interest -->

		<<case Bailey>>
			Bailey
			<<if $renttime lte 0>>
				is <span class="red">ready to collect</span>.
			<<elseif $NPCName[_i].love gte 50>>
				thinks you <span class="blue">can handle yourself</span>.
			<<elseif $NPCName[_i].love gte 25>>
				thinks you're merchandise.
			<<else>>
				thinks you're bait.
			<</if>>
		<<case Briar>>
			Briar
			<<if $brothelshowdata?.missed>>
				is <span class="red">looking for you</span>.
			<<elseif $NPCName[_i].love gte 50>>
				<<if $NPCName[_i].dom gte 25>>
					thinks you're <span class="green"><<nnpc_his "Briar">> star</span>.
				<<else>>
					is <span class="teal">pleased with your success</span>.
				<</if>>
			<<elseif $NPCName[_i].love gte 25>>
				<<if $NPCName[_i].dom gte 25>>
					thinks you <span class="blue">can go the distance</span>.
				<<else>>
					thinks you <span class="blue">have what it takes</span>.
				<</if>>
			<<elseif $NPCName[_i].love lte $npclovelow>>
				<<if $NPCName[_i].dom gte $npcdomhigh>>
					thinks you're <span class="red">a common whore</span>.
				<<else>>
					thinks you're <span class="red">unprofessional</span>.
				<</if>>
			<<else>>
				<<if $NPCName[_i].dom gte 25>>
					wants you to <span class="purple">work harder</span>.
				<<else>>
					is <span class="pink">unimpressed with you</span>.
				<</if>>
			<</if>>
		<<case Charlie>>
			Charlie
			<<if $danceskill gte 800>>
				<<if $NPCName[_i].love gte 35>>
					thinks you're <span class="green"><<nnpc_his "Charlie">> star pupil</span>.
				<<else>>
					<span class="teal">recognises your talent</span>.
				<</if>>
			<<elseif $danceskill gte 400>>
				<<if $NPCName[_i].love gte 35>>
					<span class="teal">looks forward to seeing you in class</span>.
				<<else>>
					<span class="blue">sees your potential</span>.
				<</if>>
			<<elseif $danceskill gte 200>>
				<<if $NPCName[_i].love gte 35>>
					is happy to teach you.
				<<else>>
					wants to help you improve.
				<</if>>
			<<elseif $NPCName[_i].love lte $npclovelow>>
				thinks you're <span class="red">an arrogant pupil</span>.
			<<else>>
				is eager to show you the ropes.
			<</if>>
		<<case Darryl>>
			Darryl
			<<if $NPCName[_i].love gte 40>>
				<<if $NPCName[_i].dom gte 25>>
					wants to <span class="green">keep you safe</span>.
				<<else>>
					is <span class="teal">grateful you're in <<nnpc_his "Darryl">> life</span>.
				<</if>>
			<<elseif $NPCName[_i].love gte 20>>
				<<if $NPCName[_i].dom gte 25>>
					is <span class="blue">worried you're being exploited</span>.
				<<else>>
					finds you <span class="blue">comforting</span>.
				<</if>>
			<<elseif $NPCName[_i].love lte $npclovelow>>
				thinks you're <span class="red">a disappointment</span>.
			<<else>>
				<<if $NPCName[_i].dom gte 25>>
					hopes you're being careful.
				<<else>>
					thinks you've got room to grow.
				<</if>>
			<</if>>
		<<case Doren>>
			Doren
			<<if $dorenintro gte 1>>
				<<if $NPCName[_i].love gte 50>>
					<span class="green">watches out for you</span>.
				<<else>>
					is <span class="teal">willing to listen</span>.
				<</if>>
			<<elseif $NPCName[_i].love lte $npclovelow>>
				<span class="red">expects better of you</span>.
			<<else>>
				<<if $NPCName[_i].love gte 50>>
					<span class="green">wishes other students had your enthusiasm</span>.
				<<elseif $NPCName[_i].love gte 25>>
					thinks you're <span class="teal">a fine student</span>.
				<<else>>
					has no strong opinion of you.
				<</if>>
			<</if>>
		<<case Harper>>
			Harper
			<<if $awareness gte 400>>
				<<if $NPCName[_i].love gte 50>>
					is <span class="red">eager to treat you</span>.
				<<else>>
					wants to <span class="red">study you</span>.
				<</if>>
			<<elseif $awareness gte 200>>
				<<if $NPCName[_i].love gte 50>>
					is <span class="blue">keeping a careful eye on your progress</span>.
				<<else>>
					is <span class="blue">concerned for your well-being</span>.
				<</if>>
			<<elseif $NPCName[_i].love lte $npclovelow>>
				<<if $NPCName[_i].dom gte $npcdomhigh>>
					thinks you're <span class="red">pathetic</span>.
				<<elseif $NPCName[_i].dom lte $npcdomlow>>
					thinks you're <span class="red">irritating</span>.
				<<else>>
					thinks you're <span class="red">terrible</span>.
				<</if>>
			<<else>>
				<<if $NPCName[_i].love gte 50>>
					is <span class="green">glad that you are well</span>.
				<<else>>
					wants to <span class="green">check up on you</span>.
				<</if>>
			<</if>>
		<<case Jordan>>
			Jordan
			<<if $NPCName[_i].love gte 50>>
				considers you <span class="green">a valued member of the faith</span>.
			<<elseif $NPCName[_i].love gte 25>>
				is <span class="teal">impressed with your dedication</span>.
			<<else>>
				prays for you.
			<</if>>
		<<case Landry>>
			<<set $_mickey to $mickeyPub gte 2>>
			Landry<<if $_mickey>> and 'Mickey'<</if>>
			<<if $moneyStats?.pubStolenGoods?.earned gte 800000>>
				<<if $pub_task_stat gte 25>>
					<<if $_mickey>>are<<else>>is<</if>> <span class="green">glad you're on <<if $_mickey>>their<<else>><<nnpc_his "Landry">><</if>> side</span>.
				<<else>>
					<<if $_mickey>>are <span class="teal">impressed by your talents</span>.<<else>>is <span class="teal">impressed by your sticky fingers</span>.<</if>>
				<</if>>
			<<elseif $moneyStats?.pubStolenGoods?.earned gte 400000>>
				<<if $pub_task_stat gte 25>>
					think<<if !$_mickey>>s<</if>> you're <span class="teal">helpful</span>.
				<<else>>
					think<<if !$_mickey>>s<</if>> you're <span class="teal">profitable</span>.
				<</if>>
			<<elseif $moneyStats?.pubStolenGoods?.earned gte 100000>>
				<<if $pub_task_stat gte 25>>
					think<<if !$_mickey>>s<</if>> you're <span class="blue">useful</span>.
				<<else>>
					expect<<if !$_mickey>>s<</if>> good things from you.
				<</if>>
			<<else>>
				<<if $_mickey>>have<<else>>has<</if>> no strong opinion of you.
			<</if>>
		<<case Leighton>>
			Leighton
			<<if $NPCName[_i].love gte 50>>
				<<if $NPCName[_i].dom gte 20>>
					<<if $headdrive is 1>>
						has <span class="red">a folder devoted to you</span>.
					<<else>>
						shows <span class="lewd">special interest</span> in you.
					<</if>>
				<<else>>
					<<if $delinquency gte 400>>
						is aware of your reputation.
					<<else>>
						thinks you're <span class="lewd">a model student</span>.
					<</if>>
				<</if>>
			<<elseif $NPCName[_i].love gte 25>>
				<<if $NPCName[_i].dom gte 20>>
					sees you as <span class="lewd">an enthusiastic learner</span>.
				<<else>>
					<<if $delinquency gte 400>>
						is aware of your reputation.
					<<else>>
						recognises your studiousness.
					<</if>>
				<</if>>
			<<elseif $NPCName[_i].love lte $npclovelow>>
				thinks you <span class="red">need to be taught a lesson</span>.
			<<else>>
				<<if $NPCName[_i].dom gte 20>>
					thinks you <span class="lewd">need hands-on education</span>.
				<<else>>
					<<if $delinquency gte 400>>
						is aware of your reputation.
					<<else>>
						is watching you.
					<</if>>
				<</if>>
			<</if>>
		<<case Mason>>
			Mason
			<<if $NPCName[_i].love gte 35>>
				<<if $NPCName[_i].lust gte 40>>
					<span class="lewd">can't get you out of <<nnpc_his "Mason">> mind</span>.
				<<else>>
					is <span class="green">proud of how far you've come</span>.
				<</if>>
			<<elseif $NPCName[_i].love gte 15>>
				<<if $NPCName[_i].lust gte 30>>
					has <span class="lewd">an interest in you</span>.
				<<else>>
					wants the best for you.
				<</if>>
			<<elseif $NPCName[_i].love lte $npclovelow>>
				wants you to <span class="red">push yourself</span>.
			<<else>>
				<<if $NPCName[_i].lust gte 20>>
					thinks you're <span class="lewd">a pest</span>.
				<<else>>
					has no strong opinion of you.
				<</if>>
			<</if>>
		<<case Morgan>>
			Morgan
			<<if $NPCName[_i].love gte 50>>
				<span class="red">covets you</span>.
			<<elseif $NPCName[_i].love gte 25>>
				<span class="pink">wants you back</span>.
			<<else>>
				<span class="purple">wants you</span>.
			<</if>>
		<<case River>>
			River
			<<if $NPCName[_i].love gte 40>>
				thinks you <span class="green">will go far</span>.
			<<elseif $NPCName[_i].love gte 20>>
				<span class="teal">keeps an eye on you</span>.
			<<elseif $NPCName[_i].love lte $npclovelow>>
				<span class="red">expects better of you</span>.
			<<else>>
				<<if $soup_kitchen_known is 1>>
					is <span class="blue">unsure about you</span>.
				<<else>>
					has no strong opinion of you.
				<</if>>
			<</if>>
		<<case Sam>>
			Sam
			<<if $chef_state gte 1>>
				<<if $chef_state gte 9>>
					<span class="gold">couldn't be happier with you</span>.
				<<elseif $chef_sus gte 50>>
					<span class="pink">wonders about your process</span>.
				<<elseif $NPCName[_i].love gte 25>>
					thinks you're <span class="green">the employee of the month</span>.
				<<else>>
					is <span class="teal">hopeful you'll work out as chef</span>.
				<</if>>
			<<else>>
				<<if $NPCName[_i].love gte 10>>
					is <span class="teal">beginning to trust you</span>.
				<<else>>
					has no strong opinion of you.
				<</if>>
			<</if>>
		<<case Sirris>>
			Sirris
			<<if $adultshopunlocked>>
				<<if $NPCName[_i].love gte 50>>
					<<if $sydneyromance gte 1 and $sydneySeen?.includes("parent") and pregnancyCompatible("Sydney") and $rng gte 51>>
						<span class="green">wants grandkids</span>.
					<<else>>
						is <span class="teal">grateful for all that you've done</span>.
					<</if>>
				<<else>>
					thinks you're <span class="teal">considerate</span>.
				<</if>>
			<<elseif $NPCName[_i].love lte $npclovelow>>
				<span class="red">knows you can do better</span>.
			<<else>>
				<<if $NPCName[_i].love gte 50>>
					<span class="green">wishes other students had your enthusiasm</span>.
				<<elseif $NPCName[_i].love gte 25>>
					thinks you're <span class="teal">a fine student</span>.
				<<else>>
					<<if $adultshopintro>>
						<span class="blue">could use your help</span>.
					<<else>>
						has no strong opinion of you.
					<</if>>
				<</if>>
			<</if>>
		<<case Winter>>
			Winter
			<<if $NPCName[_i].love gte 75>>
				<<set $_antiquesFound to Object.values($museumAntiques.antiques).filter(status => status !== "notFound").length>>
				<<set $_paintingsFound to Object.values($museumAntiques.paintings).filter(status => status !== "notFound").length>>
				<<set $_totalFound to $_antiquesFound + $_paintingsFound>>
				<<if $_totalFound is $museumAntiques.maxCount + Object.values($museumAntiques.paintings).length>>
					views you as <span class="green">a fellow historian</span>.
				<<else>>
					considers you <span class="green"><<nnpc_his "Winter">> assistant</span>.
				<</if>>
			<<elseif $NPCName[_i].love gte 50>>
				is <span class="teal">impressed with your respect for history</span>.
			<<elseif $NPCName[_i].love gte 25>>
				<span class="teal">appreciates your help</span>.
			<<elseif $NPCName[_i].love lte $npclovelow>>
				thinks you're <span class="red">insolent</span>.
			<<else>>
				has no strong opinion of you.
			<</if>>
		<<case Niki>>
			Niki
			<<if $photo_known gte 2>>
				<<if $NPCName[_i].love gte 50>>
					<<if $fame.model gte 2000>>
						considers you <span class="green"><<nnpc_his "Niki">> muse</span>.
					<<else>>
						considers you <span class="green">a professional</span>.
					<</if>>
				<<elseif $NPCName[_i].love gte 25>>
					considers you <span class="teal">a colleague</span>.
				<<elseif $NPCName[_i].love lte $npclovelow>>
					thinks you're <span class="red">obnoxious</span>.
				<<else>>
					thinks you're <span class="blue">a novice</span>.
				<</if>>
			<<else>>
				has no strong opinion of you.
			<</if>>
		<<case Quinn>>
			Quinn
			<<if $NPCName[_i].love gte 50>>
				<<if $NPCName[_i].lust gte 40>>
					thinks you're <span class="red">wonderful</span>.
				<<else>>
					is <span class="pink">monitoring you</span>.
				<</if>>
			<<elseif $NPCName[_i].love gte 25>>
				<<if $NPCName[_i].lust gte 30>>
					has <span class="purple">taken an interest in you</span>.
				<<else>>
					has you <span class="blue">on <<nnpc_his "Quinn">> radar</span>.
				<</if>>
			<<elseif $NPCName[_i].love lte $npclovelow>>
				thinks you're <span class="red">terrible</span>.
			<<else>>
				<<if $NPCName[_i].lust gte 20>>
					keeps you <span class="blue">in the back of <<nnpc_his "Quinn">> mind</span>.
				<<else>>
					has no strong opinion of you.
				<</if>>
			<</if>>
		<<case Remy>>
			Remy
			<<if $livestock.intro isnot undefined>>
				<<if $NPCName[_i].love gte 50>>
					<<if $NPCName[_i].dom gte 25>>
						thinks you're <span class="red">the pride of the herd</span>.
					<<else>>
						wishes you weren't so defiant.
					<</if>>
				<<elseif $NPCName[_i].love gte 25>>
					<<if $NPCName[_i].dom gte 25>>
						is <span class="pink">pleased with your production</span>.
					<<else>>
						is <span class="purple">willing to show you your place</span>.
					<</if>>
				<<elseif $NPCName[_i].love lte $npclovelow>>
					<<if $NPCName[_i].dom gte $npcdomhigh>>
						will <span class="red">milk you for all you're worth</span>.
					<<elseif $NPCName[_i].dom lte $npcdomlow>>
						is <span class="red">determined to break you</span>.
					<<else>>
						thinks you're <span class="red">a stubborn <<pcow>></span>.
					<</if>>
				<<else>>
					<<if $NPCName[_i].dom gte 25>>
						is <span class="purple">committed to improving your yield</span>.
					<<else>>
						thinks you <span class="red">need to be broken</span>.
					<</if>>
				<</if>>
			<<else>>
				has no strong opinion of you.
			<</if>>
		<<case Wren>>
			Wren
			<<if $NPCName[_i].love gte 35>>
				<<if $NPCName[_i].dom gte 25>>
					finds you <span class="green">entertaining</span>.
				<<else>>
					is <span class="green">up for anything</span>.
				<</if>>
			<<elseif $NPCName[_i].love gte 15>>
				<<if $NPCName[_i].dom gte 25>>
					is <span class="teal">intrigued by you</span>.
				<<else>>
					thinks you're <span class="teal">fun</span>.
				<</if>>
			<<elseif $NPCName[_i].love lte $npclovelow>>
				<<if $NPCName[_i].dom gte $npcdomhigh>>
					thinks you <span class="red">can't be trusted</span>.
				<<elseif $NPCName[_i].dom lte $npcdomlow>>
					thinks you're <span class="red">a cheat</span>.
				<<else>>
					thinks you're <span class="red">a pain</span>.
				<</if>>
			<<else>>
				<<if $NPCName[_i].dom gte 25>>
					thinks you're <span class="pink">cute, but boring</span>.
				<<else>>
					is cautious around you.
				<</if>>
			<</if>>
		<<case Zephyr>>
			Zephyr
			<<if $NPCName[_i].love gte 75>>
				<<if $pirate_rank is 1>>
					wants you to <span class="green">see the world</span>.
				<<else>>
					will <span class="green">show you the world</span>.
				<</if>>
			<<elseif $NPCName[_i].love gte 50>>
				enjoys <span class="teal"><<nnpc_his "Zephyr">> adventures with you</span>.
			<<else>>
				thinks you're sheltered.
			<</if>>

		<!-- Default cases -->
		<<default>>
			_npc
			<<if $NPCName[_i].love gte $npclovehigh>>
				<<if $NPCName[_i].dom gte $npcdomhigh>>
					thinks you're <span class="green">adorable</span>.
				<<elseif $NPCName[_i].dom lte $npcdomlow>>
					thinks you're <span class="green">inspiring</span>.
				<<else>>
					thinks you're <span class="green">delightful</span>.
				<</if>>
			<<elseif $NPCName[_i].love lte $npclovelow>>
				<<if $NPCName[_i].dom gte $npcdomhigh>>
					thinks you're <span class="red">pathetic</span>.
				<<elseif $NPCName[_i].dom lte $npcdomlow>>
					thinks you're <span class="red">irritating</span>.
				<<else>>
					thinks you're <span class="red">terrible</span>.
				<</if>>
			<<else>>
				<<if $NPCName[_i].dom gte $npcdomhigh>>
					thinks you're <span class="pink">cute</span>.
				<<elseif $NPCName[_i].dom lte $npcdomlow>>
					<span class="teal">looks up to you</span>.
				<<else>>
					has no strong opinion of you.
				<</if>>
			<</if>>
	<</switch>>
<</widget>>

<<widget "push_nnpc_genderknown">>
	<!-- Can be used in any situation to let all active named NPCs known the player's gender -->
	<!-- Use _args[0] to ignore clothing -->
	<!-- Won't ignore the chastity belt's "hidden" property (for now) -->
	<<if _args[0] or $exposed gte 2>>
		<<if !playerChastity("hidden")>>
			<<run $npc.forEach(npc => $genderknown.pushUnique(npc))>>
		<</if>>
	<</if>>
<</widget>>

