<<widget "clothingicon">>
	<<if $options.images is 1>>
		<<set $_item to setup.clothes[_args[1]][clothesIndex(_args[1],_args[0])]>>
		<<set $_icon to $_item.iconFile ? normaliseFileName($_item.iconFile) : normaliseFileName($_item.name)>>
		<<if $_item.iconFile>>
			<<if typeof($_item.iconFile) === 'string'>>
				<<if $_item.iconFile is "pattern" and !["secondary", "tertiary"].includes($_item.pattern_layer)>>
					<<set $_patternName to $_item.outfitPrimary ? $_item.outfitPrimary[1] : $_item.name>>
					<<set $clothesiconFile = "img/misc/icon/clothes/" + $_patternName.replace(/ /g, '-') + "-" + (_args[0].pattern || $_item.pattern_options[0]).replace(/ /g, '-') + ".png" >>
				<<else>>
					<<set $clothesiconFile = "img/misc/icon/clothes/" + $_icon>>
				<</if>>
			<<else>>
				<<set $clothesiconFile = "img/misc/icon/clothes/" + $_icon + ".png">>
			<</if>>
			<<if _args[0].colour is 0 or $_item.colour_options.length lt 2>>
				<img class="icon" alt="" @src="$clothesiconFile">
			<<else>>
				<img alt="" @class="'icon-'+ _args[0].colour.replace(/ /g, '-') + ' icon'" @src="$clothesiconFile" @style="(_args[0].colour is 'custom'? _args[0].colourCustom : '')">
			<</if>>
		<</if>>
		<<if $_item.accIcon isnot 0 and ($_item.accessory isnot 0 || $_item.breast_acc_img)>>
			<<set $_accIcon to $_item.accIcon ? $_icon to normaliseFileName($_item.accIcon) : normaliseFileName($_item.name)>>
			<<if typeof($_item.accIcon) === 'string'>>
				<<if $_item.accIcon is "pattern" and ($_item.pattern_layer === "secondary" || $_item.pattern_layer === "tertiary")>>
					<<set $_patternAcc to $_item.outfitSecondary ? $_item.outfitSecondary[1] : $_item.name>>
					<<set $clothesiconFile = "img/misc/icon/clothes/" + $_patternAcc.replace(/ /g, '-') + "-" + (_args[0].pattern || $_item.pattern_options[0]).replace(/ /g, '-') + ".png" >>
				<<else>>
					<<set $clothesiconFile = "img/misc/icon/clothes/" + $_accIcon>>
				<</if>>
			<<else>>
				<<set $clothesiconFile = "img/misc/icon/clothes/" + $_accIcon + "-acc.png">>
			<</if>>
			<span class="spanIcon">
				<<if !_args[0].accessory_colour or $_item.accessory_colour_options.length lt 2 or ($_item.accIcon is "pattern" and $_item.pattern_layer === "tertiary")>>
					<img class="accIcon" alt="" @src="$clothesiconFile">
				<<else>>
					<img @class="'icon-'+ _args[0].accessory_colour.replace(/ /g, '-') + ' accIcon'" alt="" @src="$clothesiconFile" @style="(_args[0].accessory_colour is 'custom'? _args[0].accessory_colourCustom : '')">
				<</if>>
			</span>
		<</if>>
		<<if $_item.detailIcon>>
			<<set $_detailIcon to $_item.detailIcon ? $_icon to normaliseFileName($_item.detailIcon) : normaliseFileName($_item.name)>>
			<<if typeof($_item.detailIcon) === 'string'>>
				<<if $_item.detailIcon is "pattern" and $_item.pattern_layer === "tertiary">>
					<<set $clothesiconFile = "img/misc/icon/clothes/" + $_item.name.replace(/ /g, '-') + "-" + (_args[0].pattern || $_item.pattern_options[0]).replace(/ /g, '-') + ".png" >>
				<<else>>
					<<set $clothesiconFile = "img/misc/icon/clothes/" + $_detailIcon>>
				<</if>>
			<<else>>
				<<set $clothesiconFile = "img/misc/icon/clothes/" + $_detailIcon + "-detail.png">>
			<</if>>
			<span class="spanIcon">
				<img class="accIcon" alt="" @src="$clothesiconFile">
			</span>
		<</if>>
	<</if>>
<</widget>>

<<widget "skyscrapericon">>
	<<switch _args[0]>>
		<<case "bloodmoon">>
			<<icon "skyscraper-blood-moon.gif">>
		<<case "fire">>
			<<icon "skyscraper-fire.gif">>
		<<case "ruined">>
			<<icon "skyscraper-ruins.gif">>
		<<case "construction">>
			<<icon "skyscraper-construction.gif">>
		<<default>>
			<<if $avery_tower?.progress is 100>>
				<<switch Weather.dayState>>
					<<case "night">><<icon "skyscraper-night.gif">>
					<<default>><<icon "skyscraper-day.gif">>
				<</switch>>
			<<else>>
				<<icon "skyscraper-construction.gif">>
			<</if>>
	<</switch>>
<</widget>>

<<widget "steedicon">>
	<<set _icons to {
		"appaloosa": { class: "clothes-off-white", spots: "clothes-black" },
		"bay": { class: "icon-bronze" },
		"black": { class: "clothes-blue-steel" },
		"brown": { class: "clothes-brown" },
		"buckskin": { class: "clothes-pale-yellow" },
		"chestnut": { class: "clothes-tangerine" },
		"cremello": { class: "clothes-off-white" },
		"dun": { class: "clothes-sand" },
		"grey": { class: "clothes-grey" },
		"overo": { class: "clothes-sand",spots: "icon-bronze" },
		"palomino": { class: "clothes-pale-yellow" },
		"piebald": { class: "clothes-blue-steel", spots: "clothes-off-white" },
		"roan": { class: "clothes-tan" },
		"skewbald": { class: "icon-bronze", spots: "clothes-off-white" },
		"spotted": { class: "clothes-sand", spots: "clothes-tan" },
		"tobiano": { class: "clothes-off-white", spots: "clothes-wine" },
	}>>
	<<set _direction to $location is "town" ? "flip" : "">>
	<<if _icons.hasOwnProperty($farm?.steed) || _icons.hasOwnProperty($NPCList[0].hair)>>
		<<set _horse to $NPCList[0].hair || $farm.steed>>
		<<if _icons[_horse].spots>>
			<span @class="'icon-container icon infront'">
				<span @class="_icons[_horse].spots">
					<<icon "horse-spots.png" _direction>>
				</span>
			</span>
		<</if>>
		<span @class="_icons[_horse].class">
			<<icon "horse-body.png" _direction>>
		</span>
	<<else>>
		<span class="icon-bronze">
			<<icon "horse-body.png" _direction>>
		</span>
	<</if>>
<</widget>>

<<widget "techicon">>
	<<switch _args[0]>>
		<<case "lightbulb">><<icon "lightbulb.gif">>
		<<default>><<icon `_args[0] + ".png"`>>
	<</switch>>
<</widget>>

<<widget "watericon">>
	<<set _daytime to Weather.bloodMoon ? "-bloodmoon" :
	Time.dayState is "dawn" or Time.dayState is "dusk" ? "-dawn" :
	Time.dayState is "day" ? "-day" : "-night">>

	<<set _water to {
	"waterfall": { decoclass: "", decotype: "waterfall-rock-green.png", waterclass: "water-outdoor", watertype: "waterfall-base.gif" },
	"stream": { decoclass: "", decotype: "stream-grass.png", waterclass: "water-outdoor", watertype: "stream-base.gif" },
	"pond": { decoclass: "", decotype: "pond-grass.png", waterclass: "water-outdoor", watertype: "pond-base.gif" },
	"pond_frozen": { decoclass: "", decotype: "pond-grass.png", waterclass: "water-outdoor", watertype: "pond-frozen.png" },
	"waterfall_wolfcave": { decoclass: "static-rock", decotype: "waterfall-rock.png", waterclass: "water-wolfcave", watertype: "waterfall-base.gif" },
	"stream_wolfcave": { decoclass: "static-rock", decotype: "stream-rock.png", waterclass: "water-wolfcave", watertype: "stream-base.gif" },
	"waterside_wolfcave": { decoclass: "", decotype: "waterside-soil.png", waterclass: "water-wolfcave", watertype: "waterside-base.gif" },
	"waterfall_sewer": { decoclass: "", decotype: "waterfall-sewer.png", waterclass: "static-sewer", watertype: "waterfall-base.gif" },
	}>>

	<<set _key to _args[0]>>
	<<set _decoclass to _water[_key].decoclass.includes("static") ? _water[_key].decoclass.replace("static-", "water-") : (_water[_key].decoclass ? _water[_key].decoclass + _daytime : "")>>
	<<set _waterclass to _water[_key].waterclass.includes("static") ? _water[_key].waterclass.replace("static-", "water-") : (_water[_key].waterclass ? _water[_key].waterclass + _daytime : "")>>

	<span @class="'icon-container icon infront'"><span @class=_decoclass><<icon _water[_key].decotype>></span></span>
	<span @class=_waterclass><<icon _water[_key].watertype>></span>
<</widget>>

<<widget "distracticon">>
	<<switch _args[0]>>
		<<case "green">><<set _iconFilter to "filter: hue-rotate(85deg) saturate(294%) brightness(180%) contrast(120%)">>
		<<case "blue">><<set _iconFilter to "filter: hue-rotate(206deg) saturate(229%) brightness(178%) contrast(113%)">>
		<<default>><<set _iconFilter to _args[0] || "red">>
	<</switch>>
	<span class="icon-container">
		<span @style="_iconFilter">
			<<icon "distract-base.png">>
		</span>
		<<icon "distract-front.png">>
	</span>
<</widget>>

<<widget "heatericon">>
	<<icon "heater.png">>
<</widget>>

<<widget "troughicon">>
	<<icon "trough-water.png">>
<</widget>>

<<widget "baywindowicon">>
	<<if $loft_gh is 3>>
		<<icon "bay-window-update.png">>
	<<else>>
		<<icon "bay-window.png">>
	<</if>>
<</widget>>
