<<widget "templeicon">>
	<<switch _args[0]>>
		<<case "altar">><<icon "altar.gif">>
		<<case "baton">><<icon "baton.png">>
		<<case "cloister">><<icon "cloister.png">>
		<<case "confession">><<icon "confessional.png">>
		<<case "garden">><<switch Weather.dayState>><<case "night">><<icon "temple-garden-night.png">><<default>><<icon "temple-garden.png">><</switch>>
		<<case "pew">><<icon "pew.png">>
		<<case "pray">><<skinicon "pray">>
		<<case "prayer room">><<icon "prayer-room.png">>
		<<case "quarters">><<icon "quarters.png">>
		<<case "statue">>
			<<if $hc>>
				<<icon "statue-child.png">>
			<<elseif $world_corruption_soft lte 25>>
				<<icon "statue-low.png">>
			<<elseif $world_corruption_soft lte 99>>
				<<icon "statue-mid.png">>
			<<else>>
				<<icon "statue-high.png">>
			<</if>>
		<<case "trial">><<icon "trial-of-purity.gif">>
		<<case "trialcontinue">><<icon "trial-continue.gif">>
		<<case "trialbail">><<icon "trial-jump.gif">>
		<<case "whip">><<icon "whip.png">>
		<<case "virginity">><<icon "virginity-test.png">>
		<<default>><<wolficon>>
	<</switch>>
<</widget>>

