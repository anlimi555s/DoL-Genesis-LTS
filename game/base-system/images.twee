:: Widgets Icon Img [widget]

<<widget "barbicon">>
	<<icon "barb.png">>
<</widget>>

<<widget "wolfcaveicon">>
	<<switch _args[0]>>
		<<case "pup">><<icon "wolf-pup.png">>
		<<case "sleep">><<icon "wolf-sleep.png">>
		<<case "stream">><<icon "stream.png">>
		<<case "black dog">><<icon "black-dog.png">>
		<<case "bw">><<icon "black-wolf.png">>
		<<case "ferocity">><span class="icon-container"><img class="icon" src="img/ui/sym-ferocity.png"></span>
		<<case "harmony">><span class="icon-container"><img class="icon" src="img/ui/sym-harmony.png"></span>
		<<case "inside">><<icon "wolf-cave-inside.png">>
		<<case "outside">><<icon "wolf-cave-outside.png">>
		<<case "entrance">><<icon "wolf-cave-entrance.png">>
		<<case "hole">><<icon "wolf-cave-hole.png">>
		<<case "pupsden">><<icon "wolf-pup-den.png">>
		<<case "wolf">>
			<<set _wolfcolor to ["brown", "caramel", "gray", "white"].random()>>
			<<set _wolf to "wolf-" + _wolfcolor + ".png">>
			<<icon _wolf>>
		<<case "wolf play">>
			<<set _wolfcolor = ["brown", "caramel", "gray", "white"].random()>>
			<<set _wolfplay = "wolf-" + _wolfcolor + "-play" + ".png">>
			<<icon _wolfplay>>
		<<case "children">>
			<<run Object.values($children).forEach(child => {
				if (child.type is "wolf" and child.location is "wolf_cave") {
					if (!T.childrenIconSelect) T.childrenIconSelect = [];
					T.childrenIconSelect.push(child.childId);
				}
			})>>
			<<if _childrenIconSelect and _childrenIconSelect.length gte 2>>
				<<set $_child1 to _childrenIconSelect.pluck()>>
				<<set $_child2 to _childrenIconSelect.pluck()>>
				<<if $children[$_child1].features.monster isnot $children[$_child2].features.monster>>
					<<set _wolfkid to ($children[$_child1].features.monster is "monster") ? $_child1 : $_child2>>
					<<set _wolfpup to (_wolfkid is $_child1 ? $_child2 : $_child1)>>
					<<set $_baseIcon to "children/pups/duo-features.png">>
					<<set $_wolfkidHair to "children/pups/duo-monster-hair.png">>
					<<set $_wolfkidSkin to "children/pups/duo-monster-skin.png">>
					<<set $_wolfkidEyes to "children/pups/duo-monster-eyes.png">>
					<<set $_wolfpupHair to "children/pups/duo-beast-hair.png">>
					<<set $_wolfpupEyes to "children/pups/duo-beast-eyes.png">>
					<<set _wolfkidSkinFilter = "filter: " + setup.colours.getSkinCSSFilter($children[_wolfkid].features.skinColour)>>
					<<set _wolfPupEyeClass = $children[_wolfpup].features.eyeColour?.replace("pc",V.eyeselect)?.replace(/ /g, '-')>>
					<<set _wolfKidEyeClass = $children[_wolfkid].features.eyeColour?.replace("pc",V.eyeselect)?.replace(/ /g, '-')>>

					<span class="icon-container">
						<<icon $_baseIcon>>
						<span @style="_wolfkidSkinFilter">
							<<icon $_wolfkidSkin>>
						</span>
						<span @class="'hair-'+$children[_wolfkid].features.hairColour">
							<span class="colour-hair"><<icon $_wolfkidHair>></span>
						</span>
						<span @class="'hair-'+$children[_wolfpup].features.hairColour">
							<span class="colour-hair"><<icon $_wolfpupHair>></span>
						</span>
						<span @class="'eye-'+_wolfPupEyeClass">
							<<icon $_wolfpupEyes>>
						</span>
						<span @class="'eye-'+_wolfKidEyeClass">
							<<icon $_wolfkidEyes>>
						</span>
						<<set $_baseIcon to "children/pups/duo-features.png">>
					</span>
				<<else>>
					<<set _monster to $children[$_child1].features.monster is "monster">>
					<<set $_wolfHair to _monster ? "children/pups/monster-fur.png" : "children/pups/beast-fur.png">>
					<<set $_wolfSkin to _monster ? "children/pups/monster-body.png" : null>>
					<<set $_wolfEyes to _monster ? "children/pups/monster-eyes.png" : "children/pups/beast-eyes.png">>
					<<set _wolfEyeClass = $children[$_child1].features.eyeColour?.replace("pc",V.eyeselect)?.replace(/ /g, '-')>>

					<span class="icon-container">
						<<if $_wolfSkin>>
							<<set _wolfkidSkinFilter = "filter: " + setup.colours.getSkinCSSFilter($children[$_child1].features.skinColour)>>
							<span @style="_wolfkidSkinFilter">
								<<icon $_wolfSkin>>
							</span>
						<</if>>
						<span @class="'hair-'+$children[$_child1].features.hairColour">
							<span class="colour-hair"><<icon $_wolfHair>></span>
						</span>
						<span @class="'eye-'+_wolfEyeClass">
							<<icon $_wolfEyes>>
						</span>
						<<if $_wolfSkin>>
							<<icon "children/pups/monster-paws.png">>
						<</if>>
					</span>
				<</if>>
			<</if>>
		<<default>><<icon "wolf-gray.png">>
	<</switch>>
<</widget>>

