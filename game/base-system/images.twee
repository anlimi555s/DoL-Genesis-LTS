		<<case "back">><<icon "actions/swim.png" "flip">>
		<<case "break">><<icon "actions/break-ice.png">>
		<<case "dive">><<icon "actions/dive.png">>
		<<case "down">><<icon "actions/swim-down.png">>
		<<case "leave">><<icon "actions/leave-water.png">>
		<<case "up">><<icon "actions/swim-up.png">>
		<<default>><<icon "actions/swim.png">>
	<</switch>>
<</widget>>

<<widget "sneakicon">>
