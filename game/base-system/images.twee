<</widget>>

<<widget "childrenicon">>
	<<set $_child to $children[_args[0]]>>
	<<set _monster to $_child.features.monster is "monster">>

	<<switch $_child.type>>
		<<case "hawk">>
			<<if _monster>>
				<<set _childIconFilter = "filter: " + setup.colours.getSkinCSSFilter($_child.features.skinColour)>>
				<<set $_baseIcon to "bird-tower/child-harpy.png">>
				<<set $_skinIcon to "bird-tower/child-harpy-skin.png">>
				<span class="icon-container">
					<<icon $_baseIcon>>
					<span @style="_childIconFilter">
						<<icon $_skinIcon>>
					</span>
				</span>
			<<else>>
				<<icon "bird-tower/child-hawk.png">>
			<</if>>
		<<case "wolf">>
			<<set $_wolfHair to _monster ? "children/pups/monster-fur.png" : "children/pups/beast-fur.png">>
			<<set $_wolfSkin to _monster ? "children/pups/monster-body.png" : null>>
			<<set $_wolfEyes to _monster ? "children/pups/monster-eyes.png" : "children/pups/beast-eyes.png">>
			<<set _wolfEyeClass = $_child.features.eyeColour?.replace("pc",V.eyeselect)?.replace(/ /g, '-')>>

			<span class="icon-container">
				<<if $_wolfSkin>>
					<<set _wolfkidSkinFilter = "filter: " + setup.colours.getSkinCSSFilter($_child.features.skinColour)>>
					<span @style="_wolfkidSkinFilter">
						<<icon $_wolfSkin>>
					</span>
				<</if>>
				<span @class="'hair-'+$_child.features.hairColour">
					<span class="colour-hair"><<icon $_wolfHair>></span>
				</span>
				<span @class="'eye-'+_wolfEyeClass">
					<<icon $_wolfEyes>>
				</span>
				<<if $_wolfSkin>>
					<<icon "children/pups/monster-paws.png">>
				<</if>>
				<<if $_child.localVariables.activity is "crying" and _monster>>
					<<icon "children/pups/monster-tears.png">>
				<</if>>
			</span>
		<<default>>
			<<set $_hair to "children/humans/hair.png">>
			<<set $_skin to "children/humans/body.png">>
			<<set $_eyes to "children/humans/eyes.png">>
			<<if $_child.features.eyeColour>>
				<<set _eyeClass = $_child.features.eyeColour?.replace("pc",V.eyeselect)?.replace(/ /g, '-')>>
			<<else>>
				<<set _eyeClass = "hazel">>
			<</if>>
			<<set _skinFilter = "filter: " + setup.colours.getSkinCSSFilter($_child.features.skinColour)>>

			<span class="icon-container">
				<span @style="_skinFilter">
					<<icon $_skin>>
				</span>
				<<if $_child.features.divineTransform>>
					<<set $_divine to `children/humans/tf-${$_child.features?.divineTransform}.png`>>
					<<icon $_divine>>
				<</if>>
				<<if $_child.features.beastTransform>>
					<<set $_beast to `children/humans/tf-${$_child.features?.beastTransform}.png`>>
					<span @class="'hair-'+$_child.features.hairColour">
						<span class="colour-hair"><<icon $_beast>></span>
					</span>
				<</if>>
				<<icon "children/humans/diaper.png">>
				<span @class="'hair-'+$_child.features.hairColour">
					<span class="colour-hair"><<icon $_hair>></span>
				</span>
				<span @class="'eye-'+_eyeClass">
					<<icon $_eyes>>
				</span>
			</span>
	<</switch>>
<</widget>>

