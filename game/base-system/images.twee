<<widget "antiqueicon">>
	<<set $_icon to normaliseFileName(_args[0])>>
	<<icon `"antiques/antique-" + $_icon + ".png"`>>
<</widget>>

<<widget "symbol">>
	<<switch _args[0]>>
		<<case "purity">><<tficon "angel">><<exit>>
		<<case "corruption">><<tficon "demon">><<exit>>
		<<case "promiscuity" "lust">><<set _symbol to "sym-lust.png">>
		<<case "trauma" "willpower" "fear">><<set _symbol to "sym-trauma.png">>
		<<default>><<set _symbol to `sym-${_args[0]}.png`>>
	<</switch>>
	<<iconUi _symbol>>
<</widget>>

