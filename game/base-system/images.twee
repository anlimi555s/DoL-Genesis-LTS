		<<case "right">><<icon "actions/cave-right.png">>
		<<case "north">><<icon "actions/cave-north.png">>
		<<case "south">><<icon "actions/cave-south.png">>
		<<case "west">><<icon "actions/cave-deeper.png">>
		<<case "east">><<icon "actions/cave-deeper.png" "flip">>
		<<case "sea">><<icon "actions/cave-sea.png">>
		<<case "torch">><<icon "torch.gif">>
		<<case "treasure">><<icon "treasure-chest.png">>
		<<default>><<icon "actions/cave-deeper.png">>
	<</switch>>
<</widget>>

<<widget "tentacleicon">>
	<<switch _args[0]>>
		<<case "north">><<icon "actions/tenta-north.png">>
		<<case "south">><<icon "actions/tenta-south.png">>
		<<case "west">><<icon "actions/tenta-deeper.png">>
		<<case "east">><<icon "actions/tenta-deeper.png" "flip">>
		<<default>><<icon "actions/tenta-deeper.png">>
	<</switch>>
<</widget>>

<<widget "entranceicon">>
	<<icon "actions/entrance.png">>
<</widget>>

<<widget "exiticon">>
	<<icon "actions/exit.png">>
<</widget>>

<<widget "lakeicon">>
	<<switch _args[0]>>
		<<case "campfire">><<icon "bird-tower/firepit-robust-3.gif">>
		<<case "dock">><<icon "lake-dock.png">>
		<<case "field office">><<icon "field-office.png">>
		<<case "firepit">>
			<<set $_firePitImg to "bird-tower/firepit-bonfire-">>
			<<set _edenHeaterBurnTime to Cooker.getBurnTime($edenHeater)>>
			<<set _burnTimeRatio to _edenHeaterBurnTime / $edenHeater.maxBurnTime>>
			<<set _startingBurnTimeRatio = Math.max(($edenHeaterStartingLastsUntil ?? $edenHeater.lastsUntil) -
				$timeStamp, 0) / $edenHeater.maxBurnTime>>

			<<if _edenHeaterBurnTime is 0>>
				<<set $_firePitImg += "0.gif">>
			<<elseif _burnTimeRatio lte 0.05 or _startingBurnTimeRatio gte 0.95>>
				<<set $_firePitImg += "1.gif">>
			<<elseif _burnTimeRatio lte 0.1 or _startingBurnTimeRatio gte 0.9>>
				<<set $_firePitImg += "2.gif">>
			<<elseif _burnTimeRatio lte 0.2 or _startingBurnTimeRatio gte 0.8>>
				<<set $_firePitImg += "3.gif">>
			<<else>>
				<<set $_firePitImg += "4.gif">>
			<</if>>
			<<icon $_firePitImg>>
		<<case "fishing">><<icon "fishing.png">>
		<<case "key">><<icon "bronze-key.png">>
		<<case "meditate">><<icon "actions/meditate.png">>
		<<case "plinth">><<icon "plinth.png">>
		<<case "pond">>
			<<if Weather.waterTemperature gte 36>>
				<<icon "pond-steam.gif">>
			<<else>>
				<<icon "pond.png">>
			<</if>>
		<<case "pond twigs">>
			<span class="icon-container">
				<<icon "pond.png">>
				<<icon "pond-twig.png">>
			</span>
		<<case "pots">><<icon "pots.png">>
		<<case "skate">><span class="clothes-tan"><<icon "clothes/ice-skates.png">></span>
		<<case "waterfall">><<icon "waterfall-lake.png">>
		<<default>><<icon "lake.png">>
	<</switch>>
<</widget>>

<<widget "bedicon">>
	<<switch _args[0]>>
