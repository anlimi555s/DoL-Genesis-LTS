:: Widgets Time Date [widget]
<<widget "sidebarBadEndTimeLabel">>
	<<set _currentBadEnd to $badEndStats.last()>>
	<<if Time.date.hasLostTrackOfTime(_currentBadEnd)>>
		<<if _args[0] is "mobile">>
			<mouse class="tooltip-centertop"><span class="red">?</span><span class="red">You've lost track of the time</span></mouse>
		<<else>>
			<<sidebarDayStateTime>>
		<</if>>
	<<elseif Time.date.hasLostTrackOfMinutes(_currentBadEnd)>>
		<<sidebarHourUnknownMinutes _args[0]>>
	<<else>>
		<<sidebarDefaultTime _args[0]>>
	<</if>>
<</widget>>

<<widget "sidebarDefaultTime">>
	<<switch _args[0]>>
		<<case "desktop">>
			<<ampm>>
		<<case "stats">>
			<<clock>>
			<<ampm>>
		<<case "mobile">>
			<<set _hour to $options.timestyle === "ampm" ? ((Time.hour + 11) % 12) + 1 : Time.hour>>
			<<print _hour.toString().padStart(2, "0")>>
			<br>
			<span class="vertical">:</span>
			<br>
			<<print Time.minute.toString().padStart(2, "0")>>
			<<if $options.timestyle === "ampm">>
				<br>
				<<print Time.hour >= 12 ? "pm" : "am">>
			<</if>>
		<<default>>
			<<ampm>>
	<</switch>>
<</widget>>

<<widget "sidebarHourUnknownMinutes">>
	<<switch _args[0]>>
		<<case "mobile">>
			<<set _hour to $options.timestyle === "ampm" ? ((Time.hour + 11) % 12) + 1 : Time.hour>>
			<mouse class="tooltip-centertop">
				<span class="red">
					<<print _hour.toString().padStart(2, "0")>>
					<br>
					<span class="vertical">:</span>
					<br>
					??
				</span>
				<span class="red">You've lost track of the time</span>
			</mouse>
		<<case "stats">>
			<span class="obfuscatedTimeClock"><<clock>></span>
			<<set _hour to $options.timestyle === "ampm" ? ((Time.hour + 11) % 12) + 1 : Time.hour>>
			<mouse class="tooltip-centertop"><span class="red"><<print _hour.toString()>>?</span><span class="red">You've lost track of the time</span></mouse>
		<<default>>
			<<set _hour to $options.timestyle === "ampm" ? ((Time.hour + 11) % 12) + 1 : Time.hour>>
			<mouse class="tooltip-centertop"><span class="red"><<print _hour.toString()>>?</span><span class="red">You've lost track of the time</span></mouse>
	<</switch>>
<</widget>>

<<widget "sidebarDayStateTime">>
	<mouse class="tooltip-centertop"><span class="red"><<print Time.dayState.toUpperFirst()>>?</span><span class="red">You've lost track of the time</span></mouse>
<</widget>>

<<widget "sidebarTime">>
	<<set _currentBadEnd to $badEndStats.last()>>
	<<if _currentBadEnd?.trackedStart and _currentBadEnd.trackedEnd is undefined>>
		<<sidebarBadEndTimeLabel _args[0]>>
	<<else>>
		<<sidebarDefaultTime _args[0]>>
	<</if>>
<</widget>>

<<widget "ampm_text">><<silently>>
	<<if Time.hour is 0>>
		<<if Time.minute lte 7>>
			<<set _text_output to "midnight">>
		<<elseif Time.minute lte 22>>
			<<set _text_output to "quarter past twelve in the morning">>
		<<elseif Time.minute lte 37>>
			<<set _text_output to "half past twelve in the morning">>
		<<elseif Time.minute lte 52>>
			<<set _text_output to "quarter to one in the morning">>
		<<else>>
			<<set _text_output to "one in the morning">>
		<</if>>
	<<elseif Time.hour is 1>>
		<<if Time.minute lte 7>>
			<<set _text_output to "one in the morning">>
		<<elseif Time.minute lte 22>>
			<<set _text_output to "quarter past one in the morning">>
		<<elseif Time.minute lte 37>>
			<<set _text_output to "half past one in the morning">>
		<<elseif Time.minute lte 52>>
			<<set _text_output to "quarter to two in the morning">>
		<<else>>
			<<set _text_output to "two in the morning">>
		<</if>>
	<<elseif Time.hour is 2>>
		<<if Time.minute lte 7>>
			<<set _text_output to "two in the morning">>
		<<elseif Time.minute lte 22>>
			<<set _text_output to "quarter past two in the morning">>
		<<elseif Time.minute lte 37>>
			<<set _text_output to "half past two in the morning">>
		<<elseif Time.minute lte 52>>
