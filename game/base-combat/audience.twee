<<widget "ahe">><<silently>>
	<<if ["man", "boy"].includes($audiencecamera)>>
		<<set _text_output to "he">>
	<<elseif ["woman", "girl"].includes($audiencecamera)>>
		<<set _text_output to "she">>
	<<elseif $audiencecamera>>
		<<set _text_output to `<span class="red">[ERROR: unrecognised audiencecamera value $audiencecamera in "ahe"]</span>`>>
	<<else>>
		<<set _text_output to `<span class="red">[ERROR: undefined audiencecamera in "ahe"]</span>`>>
	<</if>>
<</silently>>_text_output<</widget>>

