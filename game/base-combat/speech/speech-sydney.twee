					<<He>> speaks. "I... you can be a little rough, if you want..."
			<</switch>>
		<<elseif $rng gte 76>>
			<<switch _sydneyStatus>>
				<<case "pure" "pureLust">>
					<<He>> takes a deep breath. "I... I can do this."
				<<case "corrupt" "corruptLust">>
					<<He>> speaks. "Think you can keep up?"
				<<default>>
					<<He>> speaks. "I think I can keep pace with you, now."
			<</switch>>
		<<elseif $rng gte 71>>
			<<switch _sydneyStatus>>
				<<case "pure" "pureLust">>
					<<He>> takes a deep breath. "We... need to stay quiet..."
				<<case "corrupt" "corruptLust">>
					<<He>> giggles. "Shh!"
				<<default>>
					<<He>> speaks. "Let's try not to get caught..."
			<</switch>>
		<<elseif $rng gte 66>>
			<<switch _sydneyStatus>>
				<<case "pure" "pureLust">>
					<<He>> looks upwards. "Forgive me..."
				<<case "corrupt" "corruptLust">>
					<<He>> giggles. "Looks like I'm due for some discipline. Maybe you can punish me?"
				<<default>>
					<<He>> giggles. "I've sinned... is this my punishment?"
			<</switch>>
		<<elseif $rng gte 61>>
			<<if $location is "temple">>
				<<switch _sydneyStatus>>
					<<case "pure" "pureLust">>
						<<He>> looks upwards. "S...such a sin, doing this on such holy ground..."
					<<case "corrupt" "corruptLust">>
						<<He>> giggles. "Let's defile this place."
					<<default>>
						<<He>> giggles. "W...we're doing this in the temple, and nothing is stopping us..."
				<</switch>>
			<<elseif $location is "school">>
				<<switch _sydneyStatus>>
					<<case "pure" "pureLust">>
						<<He>> looks around nervously. "If... if someone caught us..."
					<<case "corrupt" "corruptLust">>
						<<He>> giggles. "I sure hope one of the other students hear us."
					<<default>>
						<<He>> looks around. "I hope there's no one waiting in line..."
				<</switch>>
			<<else>>
				<<switch _sydneyStatus>>
					<<case "pure" "pureLust">>
						<<He>> looks around nervously. "Here, of all places..."
					<<case "corrupt" "corruptLust">>
						<<He>> giggles. "Think anyone will find us?"
					<<default>>
						<<He>> looks around. "I think we're safe."
				<</switch>>
			<</if>>
		<<else>>
			<<set _noNameComment to true>>
		<</if>>
	<</if>>
	<<if $sydneyComments>>
		<<set _keys to Object.keys($sydneyComments)>>
		<<for $_i to 0; $_i lt _keys.length; $_i++>>
			<<if $sydneyComments[_keys[$_i]] gt 0>>
				<<set $sydneyComments[_keys[$_i]]-->>
			<</if>>
		<</for>>
	<</if>>
<</widget>>
