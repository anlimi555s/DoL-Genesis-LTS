:: Widgets Market [widget]
<<widget "stall_actions">>
	<<outfitChecks>>
	<<if $stress gte $stressmax>>
		<<passoutstreet>>
	<<elseif _shirtless and $player.gender_appearance is "f">>
		You can't do this with your <<breasts>> on display. <<if $player.sex is "m">>Not while looking like a girl.<</if>> You duck and run.
		<br><br>

		<<link [[Next|Connudatus Street]]>><<endevent>><<endstall>><<clotheson>><<set $eventskip to 1>><</link>>
		<br>
	<<else>>
		<<silently>><<stall_inventory>><</silently>>
		<<stall_chance>>
		<br><br>
		<<if random(1, 10000) is 10000>>
			<<stallicon "open">><<link [[Capitalism ho! (0:20)|Stall]]>><<endevent>><<endstall>><<pass 20>><</link>>
			<br>
		<<else>>
			<<stallicon "open">><<link [[Continue (0:20)|Stall]]>><<endevent>><<endstall>><<pass 20>><</link>>
			<br>
		<</if>>
		<<icon "project-maths.png">><<link [[Manage your stall|Stall Manage]]>><</link>>
		<br>
		/* Stall Manage used instead
		<<ind>><<link [[Change displayed produce|Stall Rent Return]]>><</link>>
		<br> */
		<<if $worn.lower.name isnot "naked">>
			<<if $worn.under_lower.name isnot "naked">>
				<<if $worn.upper.set isnot $worn.lower.set>>
					<<if hasSexStat("exhibitionism", 2)>>
						<<skinicon "strip">> <<link [[Remove your bottoms|Stall Bottoms Strip]]>><<endevent>><<endstall>><</link>><<if $daily.ex.stall isnot 1>><<exhibitionist2>><</if>>
						<br>
					<</if>>
				<</if>>
			<<else>>
				<<if $worn.upper.set isnot $worn.lower.set>>
					<<if hasSexStat("exhibitionism", 4)>>
						<<skinicon "strip">><<link [[Remove your bottoms|Stall Bottoms Strip]]>><<endevent>><<endstall>><</link>><<if $daily.ex.stall isnot 1>><<exhibitionist4>><</if>>
						<br>
					<</if>>
				<</if>>
			<</if>>
		<<elseif $worn.under_lower.name isnot "naked">>
			<<if $worn.under_lower.set isnot $worn.under_upper.set>>
				<<if hasSexStat("exhibitionism", 4)>>
					<<skinicon "strip">><<link [[Remove your undies|Stall Undies Strip]]>><<endevent>><<endstall>><</link>><<if $daily.ex.stall isnot 1>><<exhibitionist4>><</if>>
					<br>
				<</if>>
			<</if>>
		<</if>>
		<<if hasSexStat("exhibitionism", 3)>>
			<<skinicon "masturbate">><<link [[Masturbate|Stall Masturbation]]>><<endevent>><<endstall>><<set $phase to 0>><<set $masturbationstart to 1>><</link>><<if $daily.ex.stall isnot 1>><<exhibitionist3>><</if>><<if $daily.stall_lewdity is 0>><<glewdity>><</if>>
			<br>
		<</if>>
		<<connudatusicon>><<link [[Leave|Connudatus Street]]>><<endevent>><<endstall>><<clotheson>><<set $eventskip to 1>><</link>>
		<br>
	<</if>>
<</widget>>

<<widget "stall_setup">>
		<<set $foodstuff_stall to []>>
		<<set _foodstuffKeys to Object.keys($foodstuff)>>
		<<stall_setup_interior>>
<</widget>>

<<widget "stall_setup_interior">>
	<span id="stall_setup">
	Your produce:
	<<for _t to 0; _t lt _foodstuffKeys.length; _t++>>
		<<set _foodstuffKey to _foodstuffKeys[_t]>>
		<<set _foodstuffNameText to setup.foodstuff[_foodstuffKey].name.replace(/_/g," ")>>

		<<if $foodstuff[_foodstuffKey].amount and !$foodstuff_stall.includes(_foodstuffKey)>>
			<<foodstufficon _foodstuffKey>>
			<<capture _foodstuffKey>>
				<<link "_foodstuffNameText">><<set $foodstuff_stall.push(_foodstuffKey)>><<replace #stall_setup>><<stall_setup_interior>><</replace>><</link>> |
			<</capture>>
		<</if>>
	<</for>>
	<br>
	<<link "Add all">>
		<<for _t to 0; _t lt _foodstuffKeys.length; _t++>>
			<<set _foodstuffKey to _foodstuffKeys[_t]>>
			<<if $foodstuff[_foodstuffKey].amount and !$foodstuff_stall.includes(_foodstuffKey)>>
				<<set $foodstuff_stall.push(_foodstuffKey)>>
			<</if>>
		<</for>>
		<<replace #stall_setup>><<stall_setup_interior>><</replace>>
	<</link>>
	<br><br>
	On your stall:
	<<for _t to 0; _t lt _foodstuffKeys.length; _t++>>
		<<set _foodstuffKey to _foodstuffKeys[_t]>>
		<<set _foodstuffNameText to setup.foodstuff[_foodstuffKey].name.replace(/_/g," ")>>
		<<if $foodstuff[_foodstuffKey].amount and $foodstuff_stall.includes(_foodstuffKey)>>
			<<foodstufficon _foodstuffKey>>
			<<capture _foodstuffKey>>
				<<link "_foodstuffNameText">><<set $foodstuff_stall.delete(_foodstuffKey)>><<replace #stall_setup>><<stall_setup_interior>><</replace>><</link>> |
			<</capture>>
		<</if>>
	<</for>>
	<br>
	<<link "Remove all">>
		<<for _t to 0; _t lt _foodstuffKeys.length; _t++>>
			<<set _foodstuffKey to _foodstuffKeys[_t]>>
			<<if $foodstuff[_foodstuffKey].amount and $foodstuff_stall.includes(_foodstuffKey)>>
				<<set $foodstuff_stall.delete(_foodstuffKey)>>
			<</if>>
		<</for>>
		<<replace #stall_setup>><<stall_setup_interior>><</replace>>
	<</link>>
	<br><br>
	<<if $foodstuff_stall.length gte 1>>
		<<link [[Open|Stall Rent 2]]>><</link>>
		<br>
	<<else>>
		<<link [[Leave it for now|Connudatus Street]]>><</link>>
		<br>
	<</if>>
	<br>
	</span>
<</widget>>

<<widget "stall_inventory">>
	<<silently>>
		<<set $foodstuff_inventory to []>>
		<<set _foodstuffKeys to Object.keys($foodstuff)>>
		<<set _total_worth to 0>>
		<<set _total_amount to 0>>
		<<set _total_sold_amount to 0>>
		<<for _t to 0; _t lt _foodstuffKeys.length; _t++>>
			<<if ndef $stall_stats[_foodstuffKeys[_t]]>>
				<<set $stall_stats[_foodstuffKeys[_t]] to { inventory:{amount:0, price:0, total:0}, sold:{amount:0, total:0, amountHistory: 0, totalHistory: 0} }>>
			<</if>>
			<<if $foodstuff[_foodstuffKeys[_t]].amount gte 1>>
				<<set _inventory_found to 1>>
				<<if $foodstuff[_foodstuffKeys[_t]].marketStall is false>>
					<<continue>>
				<</if>>
				<<set _foodstuffValue to Math.round(setup.foodstuff[_foodstuffKeys[_t]].shop.sell_price)>>
				<<set _total_worth += $foodstuff[_foodstuffKeys[_t]].amount * _foodstuffValue>>
				<<set _total_amount += $foodstuff[_foodstuffKeys[_t]].amount>>
				<<set _inventory_in_stall to 1>>
				<<run $foodstuff_inventory.push(_foodstuffKeys[_t])>>
				<<if ($stall_expensive is undefined) or ($foodstuff[$stall_expensive].amount lte 0) or (setup.foodstuff[_foodstuffKeys[_t]].shop.sell_price gte setup.foodstuff[$stall_expensive].shop.sell_price)>>
					<<set $stall_expensive to clone(_foodstuffKeys[_t])>>
				<</if>>
				<<set $stall_stats[_foodstuffKeys[_t]].inventory to {amount:$foodstuff[_foodstuffKeys[_t]].amount, price:_foodstuffValue, total:($foodstuff[_foodstuffKeys[_t]].amount * _foodstuffValue)}>>
			<<else>>
				<<set $stall_stats[_foodstuffKeys[_t]].inventory to {amount:0, price:Math.round(setup.foodstuff[_foodstuffKeys[_t]].shop.sell_price), total:0}>>
			<</if>>
			<<set _total_sold_amount += $stall_stats[_foodstuffKeys[_t]].sold.amount>>
		<</for>>
	<</silently>>

	<<if _inventory_found isnot 1>>
		You're out of stock!<br>
	<<elseif _inventory_in_stall isnot 1>>
		You're out of items you displayed!<br>
	<</if>>
	<<if $stall_money is 0>>
		<<if _inventory_found is 1>>
			Your displayed inventory is worth <<printmoney _total_worth>>.
		<</if>>
		You haven't sold anything yet.
	<<else>>
		<<if _inventory_found is 1>>
			Your remaining displayed inventory is worth <<printmoney _total_worth>>.
		<</if>>
		You earned <<printmoney $stall_money>> from sales today.
	<</if>>
<</widget>>

<<widget "endstall">>
	<<unset $foodstuff_inventory>>
	<<unset $stall_amount>>
	<<unset $stall_foodstuff>>
	<<unset $stall_cost>>
	<<unset $stall_expensive>>
<</widget>>

<<widget "stall_sell">>
	<<if ndef $stall_stats[$stall_foodstuff]>>
		<<set $stall_stats[$stall_foodstuff] to { inventory:{amount:0, price:0, total:0}, sold:{amount:0, total:0} }>>
	<</if>>
	<<set $stall_stats[$stall_foodstuff].sold.amount += $stall_amount>>
	<<set $stall_stats[$stall_foodstuff].sold.total += Math.round($stall_cost * $stall_amount)>>
	<<set $stall_stats[$stall_foodstuff].sold.amountHistory = ($stall_stats[$stall_foodstuff].sold.amountHistory or 0) + $stall_amount>>
	<<set $stall_stats[$stall_foodstuff].sold.totalHistory = ($stall_stats[$stall_foodstuff].sold.totalHistory or 0) + Math.round($stall_cost * $stall_amount)>>

	<<set $foodstuff[$stall_foodstuff].amount -= $stall_amount>>
	<<money `Math.round($stall_cost * $stall_amount)` "marketStall">>
	<<set $stall_money += Math.round($stall_cost * $stall_amount)>>
	<<set $produce_sold += $stall_amount>>
	You sell
	<<if $stall_amount gte 2>>
		$stall_amount <<print setup.foodstuff[$stall_foodstuff].plural>>
	<<else>>
		one <<print setup.foodstuff[$stall_foodstuff].name.replace(/_/g," ")>>
	<</if>>
	for <<printmoney `$stall_cost * $stall_amount`>>.
	<<if $stall_cost * $stall_amount / 100 gte 10000>>
		It feels good to make so much money at once.
		<<ltrauma>><<lstress>>
	<</if>>
	<<famebusiness 1>>
<</widget>>

<<widget "eventsstall">>
	/* $stall_rejected is now a dead variable, but kept in case it is reintroduced later. */
	<<rng 10>>
	<<if $daily.stall_lewdity gt 0 and $daily.stall_lewdity+2 gte random(1, 18)>>
		/* Bad events happen between 1/6 and 1/3 of the cases */
		<<if $rng is 1>>
			<<generate1>><<person1>>
			You hear movement behind you.
			<<if $worn.lower.type.includes("naked")>>
				<<if $worn.under_lower.type.includes("naked")>>
					Before you can turn, a pair of hands wrap around your waist and grope your <<genitals>>.
					<<gtrauma>><<gstress>><<trauma 6>><<stress 6>>
					<br><br>

					"I heard the owner of this stall was a slut," says a <<personssimple>> voice. "But I didn't expect <<phim>> to have nothing on down here." <<He>> continues to fondle you.
					<br><br>

				<<else>>
					Before you can turn, a pair of hands wrap around your waist and grope your <<genitals>> through your $worn.under_lower.name.
					<<gtrauma>><<gstress>><<trauma 6>><<stress 6>>
					<br><br>

					"I heard the owner of this stall was a slut," says a <<personssimple>> voice. "But I didn't expect <<phim>> to be secretly wearing just underwear down here." <<He>> continues to fondle you.
					<br><br>
				<</if>>
			<<else>>
				<<if $player.gender_appearance is "f">>
					Before you can turn, a pair of hands appear beneath your shoulders and grasp your <<breasts>>.
					<<gtrauma>><<gstress>><<trauma 6>><<stress 6>>
					<br><br>

					"Don't lie to me," says a <<personssimple>> voice. <<His>> hands wander down to your <<genitals>>. "You set this place up to draw attention to yourself. You want this." <<He>> continues to fondle you.
					<br><br>
				<<else>>
					Before you can turn, a pair of hands appear beneath your shoulders and grasp your <<genitals>>.
					<<gtrauma>><<gstress>><<trauma 6>><<stress 6>>
					<br><br>

					"Don't lie to me," says a <<personssimple>> voice. "You set this place up to draw attention to yourself. You want this." <<He>> continues to fondle you.
					<br><br>
				<</if>>
			<</if>>
			<<link [[Endure (0:05)|Stall Endure]]>><<pass 5>><<trauma 6>><<stress 6>><<arousal 300 "genitals">><<arousal 300 "breasts">><<lewdity 1>><</link>><<glewdity>><<gtrauma>><<gstress>><<garousal>>
			<br>
			<<link [[Shove|Stall Shove]]>><<trauma -6>><</link>><<ltrauma>>
			<br>
		<<elseif $rng is 2>>
			<<generate1>><<person1>>
			You hear movement behind you. Before you can turn, a hand clasps around your mouth. "I've heard about you," the <<personsimple>> whispers. "Slut." <<He>> kicks your legs out from under you, forcing you to the ground.
			<br><br>

			<<link [[Next|Stall Rape]]>><<set $molestationstart to 1>><</link>>
			<br>
		<<elseif $rng is 3>>
			<<generate1>><<person1>>
			<<outfitChecks>>
			<<if _shirtless and $worn.under_upper.type.includes("naked")>>
				A <<person>> walks up to your stall, looking at your display. Without warning, <<he>> reaches across the table and gropes your <<breasts>> before running away.
				<<gtrauma>><<gstress>><<garousal>><<trauma 6>><<stress 6>><<arousal 600 "breasts">>
				<br><br>
			<<else>>
				<<set _top.integrity -= 20>>
				A <<person>> walks up to your stall, looking at your display. Without warning, <<he>> reaches across the table and grasps your _top.name.
				<<gtrauma>><<gstress>><<trauma 6>><<stress 6>>
				<br>
				<<if _top.integrity lte 0>>
					<<He>> runs away, clutching the fabric in <<his>> hand. <<covered>>
					<br><br>
				<<else>>
					<<He>> tugs <<it _top.slot>> down, exposing your <<= _topLower || '<<breasts>>'>> before you're able to break <<his>> grip. <<He>> turns and runs.
					<br><br>
				<</if>>
				<<integritycheck>><<exposure>>
			<</if>>
			<<stall_actions>>
		<<elseif $rng is 4>>
			<<generate1>><<person1>>
			You spot a <<person>> across the street holding a camera to <<his>> face. It looks like it's pointing at you. You feel uncomfortable.
			<<gstress>><<stress 6>>
			<br><br>

			<<stall_actions>>
		<<elseif $rng is 5>>
			<<generate1>><<person1>>
			<<stall_init>><<stallCustomerArousal>><<set $enemytrust -= 20>>
			A <<person>> walks up to your display. <<He>> <<stall_check_text>>. "How much for <span class="green"><<stall_amount>></span> of these?" <<he>> asks. <<He>> leers at you openly.
			<br><br>

			<<stall_trust>>
			<br><br>

			<<stall_sell_actions>>
		<<elseif $rng is 6>>
			<<generate1>><<person1>>
			<<stall_init>><<stallCustomerArousal>><<set $enemytrust -= 20>>
			A <<person>> walks up to your display. <<He>> <<stall_check_text>>. "How much for <span class="green"><<stall_amount>></span> of these?" <<he>> asks. "And don't try to sweet talk me. I've heard about you."
			<br><br>

			<<stall_trust>>
			<br><br>

			<<stall_sell_actions>>
		<<elseif $rng is 7>>
			<<generate1>><<person1>>
			<<stall_init>><<stallCustomerArousal>><<set $enemytrust -= 20>>
			You see a <<person>> watching you from afar. <<He>> walks over when your eyes meet. <<He>> <<stall_check_text>>. "How much for <span class="green"><<stall_amount>></span> of these?" <<he>> asks.
			<br><br>

			<<stall_trust>>
			<br><br>

			<<stall_sell_actions>>
		<<elseif $rng is 8>>
			<<generate1>><<person1>>
			<<stall_init>><<stallCustomerArousal>><<set $enemytrust -= 20>>
			A <<person>> walks by, and stops in front of your stall. <<His>> eyes flicker over your face and chest as <<he>> <<stall_check_text>>. "How much for <span class="green"><<stall_amount>></span> of these?" <<he>> asks.
			<br><br>

			<<stall_trust>>
			<br><br>

			<<stall_sell_actions>>
		<<elseif $rng is 9>>
			<<generate1>><<person1>>
			<<stall_init>><<stallCustomerArousal>><<stallCustomerArousal>><<set $stall_seduced to 1>><<set $enemytrust -= 20>>
			A <<person>> swaggers up to your display. Without warning, <<he>> reaches forward and grasps your arm. <<He>> tugs you forward, until you're leaning over the table, then <<he>> leans in and licks your cheek.
			<<gtrauma>><<gstress>><<trauma 6>><<stress 6>>
