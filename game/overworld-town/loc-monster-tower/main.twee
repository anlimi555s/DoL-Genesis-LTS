	<<controlloss>>
	<<violence 1>>
	<<neutral 1>>
	<<molested>>
	<<beastCombatInit>>
	<<set $enemyhealthmax to 600>><<set $enemyhealth to 600>><<set $enemyarousalmax to 1000>>
	<<set $position to "missionary">><<set $position to "doggy">>
	<<set $NPCList[0].stance to "top">>
	<<set $enemytrust -= 40>>
	<<if $phase is 1>>
		<<set $enemyanger += 120>>
		<<set $enemytrust -= 80>>
	<</if>>
<</if>>

